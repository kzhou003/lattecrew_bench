{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01G68R6fdrtj695LQYgnfXgu","type":"tool_result","content":"diff --git a/ledgerkit/durations.py b/ledgerkit/durations.py\nnew file mode 100644\nindex 0000000..6d2afff\n--- /dev/null\n+++ b/ledgerkit/durations.py\n@@ -0,0 +1,65 @@\n+\"\"\"Parse and format human-readable durations like '1h30m'.\"\"\"\n+\n+import re\n+from decimal import Decimal\n+\n+_UNITS = {'d': 86400, 'h': 3600, 'm': 60, 's': 1}\n+_ORDER = {'d': 0, 'h': 1, 'm': 2, 's': 3}\n+_PART = re.compile(r'(\\d+(?:\\.\\d+)?)([dhms])')\n+_WHOLE = re.compile(r'\\d+(?:\\.\\d+)?[dhms](?:\\s*\\d+(?:\\.\\d+)?[dhms])*')\n+\n+\n+def parse(text):\n+    \"\"\"Parse a duration like '1h30m' into seconds.\n+\n+    Units d, h, m, s may appear largest to smallest, each at most once,\n+    with optional spaces between parts. A leading '-' negates the value.\n+    Returns an int when the total is whole, otherwise a float.\n+    \"\"\"\n+    if not isinstance(text, str):\n+        raise TypeError('duration must be a string')\n+    text = text.strip()\n+    if not text:\n+        raise ValueError('empty duration')\n+    negative = text.startswith('-')\n+    if negative:\n+        text = text[1:]\n+        if not text:\n+            raise ValueError('empty duration')\n+    if not _WHOLE.fullmatch(text):\n+        raise ValueError(f'invalid duration: {text!r}')\n+    parts = _PART.findall(text)\n+    units = [unit for _, unit in parts]\n+    if len(set(units)) != len(units):\n+        raise ValueError(f'repeated unit in: {text!r}')\n+    if any(_ORDER[a] > _ORDER[b] for a, b in zip(units, units[1:])):\n+        raise ValueError(f'units out of order in: {text!r}')\n+    total = Decimal(0)\n+    for number, unit in parts:\n+        total += Decimal(number) * _UNITS[unit]\n+    if negative:\n+        total = -total\n+    whole = total.to_integral_value()\n+    if total == whole:\n+        return int(whole)\n+    return float(total)\n+\n+\n+def format(seconds):\n+    \"\"\"Format a whole number of seconds as '1h30m', '0s', '-1d', etc.\"\"\"\n+    if isinstance(seconds, bool) or not isinstance(seconds, (int, float)):\n+        raise TypeError('seconds must be a number')\n+    if isinstance(seconds, float):\n+        if not seconds.is_integer():\n+            raise ValueError('seconds must be a whole number')\n+        seconds = int(seconds)\n+    sign = '-' if seconds < 0 else ''\n+    seconds = abs(seconds)\n+    parts = []\n+    for unit, size in (('d', 86400), ('h', 3600), ('m', 60), ('s', 1)):\n+        count, seconds = divmod(seconds, size)\n+        if count:\n+            parts.append(f'{count}{unit}')\n+    if not parts:\n+        return '0s'\n+    return sign + ''.join(parts)\ndiff --git a/tests/test_durations.py b/tests/test_durations.py\nnew file mode 100644\nindex 0000000..a6b9059\n--- /dev/null\n+++ b/tests/test_durations.py\n@@ -0,0 +1,114 @@\n+import pytest\n+\n+from ledgerkit.durations import format, parse\n+\n+\n+def test_parse_whole_seconds():\n+    assert parse('90s') == 90\n+    assert parse('45m') == 2700\n+    assert parse('1h') == 3600\n+    assert parse('1d') == 86400\n+    assert parse('0s') == 0\n+\n+\n+def test_parse_combined():\n+    assert parse('1h30m') == 5400\n+    assert parse('2d 3h') == 183600\n+    assert parse('1d2h3m4s') == 93784\n+    assert parse('1h 30m 10s') == 5410\n+\n+\n+def test_parse_decimals():\n+    assert parse('1.5h') == 5400\n+    assert parse('1.25m') == 75\n+    assert parse('0.5s') == 0.5\n+    assert parse('0.1h') == 360\n+    assert parse('2.5d') == 216000\n+\n+\n+def test_parse_negative():\n+    assert parse('-90s') == -90\n+    assert parse('-1h30m') == -5400\n+    assert parse('-1.5h') == -5400\n+    assert parse('-0s') == 0\n+\n+\n+def test_parse_return_types():\n+    assert isinstance(parse('90s'), int)\n+    assert isinstance(parse('0s'), int)\n+    assert isinstance(parse('1.5s'), float)\n+    assert isinstance(parse('-1.5s'), float)\n+\n+\n+@pytest.mark.parametrize('text', [\n+    '',\n+    '   ',\n+    '5',\n+    '1.5',\n+    '-5',\n+    '-',\n+    'h',\n+    '1h2h',\n+    '1d1d',\n+    '30m1h',\n+    '2h 1d',\n+    '1h 2',\n+    '1h30',\n+    '1h-30m',\n+    '--1h',\n+    '1.2.3h',\n+    '1x',\n+    'x1s',\n+    '1 h',\n+    '1.5.5s',\n+])\n+def test_parse_rejects_invalid(text):\n+    with pytest.raises(ValueError):\n+        parse(text)\n+\n+\n+def test_parse_rejects_non_string():\n+    with pytest.raises(TypeError):\n+        parse(5)\n+\n+\n+def test_format():\n+    assert format(0) == '0s'\n+    assert format(1) == '1s'\n+    assert format(59) == '59s'\n+    assert format(90) == '1m30s'\n+    assert format(3599) == '59m59s'\n+    assert format(5400) == '1h30m'\n+    assert format(3661) == '1h1m1s'\n+    assert format(86400) == '1d'\n+    assert format(86401) == '1d1s'\n+    assert format(183600) == '2d3h'\n+    assert format(90060) == '1d1h1m'\n+\n+\n+def test_format_negative():\n+    assert format(-1) == '-1s'\n+    assert format(-5400) == '-1h30m'\n+    assert format(-86400) == '-1d'\n+\n+\n+def test_format_whole_float():\n+    assert format(5400.0) == '1h30m'\n+\n+\n+def test_format_rejects_fractional():\n+    with pytest.raises(ValueError):\n+        format(1.5)\n+\n+\n+def test_format_rejects_non_number():\n+    with pytest.raises(TypeError):\n+        format('90s')\n+\n+\n+@pytest.mark.parametrize('seconds', [\n+    0, 1, 59, 60, 61, 3599, 3600, 5400, 90000, 86399, 86400, 86401,\n+    183600, 259200, -1, -90, -5400, -86400, -90000,\n+])\n+def test_round_trip(seconds):\n+    assert parse(format(seconds)) == seconds\n...................................................                      [100%]\n51 passed in 0.03s","is_error":false}]},"parent_tool_use_id":null,"session_id":"40d35be2-5ab3-4d4d-8870-d72ba69707ca","uuid":"cc7633fb-7c1a-44f9-84ee-16ec62db3599","timestamp":"2026-11-07T10:06:07.755Z","tool_use_result":{"stdout":"diff --git a/ledgerkit/durations.py b/ledgerkit/durations.py\nnew file mode 100644\nindex 0