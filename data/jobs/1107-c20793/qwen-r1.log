{"type":"tool_use","timestamp":1794045945826,"sessionID":"ses_e4a8955f2ffeiz0JI16iXeUGIG","part":{"type":"tool","tool":"write","callID":"chatcmpl-tool-9fba4e55dec49550","state":{"status":"completed","input":{"content":"import pytest\n\nfrom ledgerkit.durations import format, parse\n\n\ndef test_parse_whole_seconds():\n    assert parse('90s') == 90\n    assert parse('45m') == 2700\n    assert parse('1h') == 3600\n    assert parse('1d') == 86400\n    assert parse('0s') == 0\n\n\ndef test_parse_combined():\n    assert parse('1h30m') == 5400\n    assert parse('2d 3h') == 183600\n    assert parse('1d2h3m4s') == 93784\n    assert parse('1h 30m 10s') == 5410\n\n\ndef test_parse_decimals():\n    assert parse('1.5h') == 5400\n    assert parse('1.25m') == 75\n    assert parse('0.5s') == 0.5\n    assert parse('0.1h') == 360\n    assert parse('2.5d') == 216000\n\n\ndef test_parse_negative():\n    assert parse('-90s') == -90\n    assert parse('-1h30m') == -5400\n    assert parse('-1.5h') == -5400\n    assert parse('-0s') == 0\n\n\ndef test_parse_return_types():\n    assert isinstance(parse('90s'), int)\n    assert isinstance(parse('0s'), int)\n    assert isinstance(parse('1.5s'), float)\n    assert isinstance(parse('-1.5s'), float)\n\n\n@pytest.mark.parametrize('text', [\n    '',\n    '   ',\n    '5',\n    '1.5',\n    '-5',\n    '-',\n    'h',\n    '1h2h',\n    '1d1d',\n    '30m1h',\n    '2h 1d',\n    '1h 2',\n    '1h30',\n    '1h-30m',\n    '--1h',\n    '1.2.3h',\n    '1x',\n    'x1s',\n    '1 h',\n    '1.5.5s',\n])\ndef test_parse_rejects_invalid(text):\n    with pytest.raises(ValueError):\n        parse(text)\n\n\ndef test_parse_rejects_non_string():\n    with pytest.raises(TypeError):\n        parse(5)\n\n\ndef test_format():\n    assert format(0) == '0s'\n    assert format(1) == '1s'\n    assert format(59) == '59s'\n    assert format(90) == '1m30s'\n    assert format(3599) == '59m59s'\n    assert format(5400) == '1h30m'\n    assert format(3661) == '1h1m1s'\n    assert format(86400) == '1d'\n    assert format(86401) == '1d1s'\n    assert format(183600) == '2d3h'\n    assert format(90000) == '1d1h1m'\n\n\ndef test_format_negative():\n    assert format(-1) == '-1s'\n    assert format(-5400) == '-1h30m'\n    assert format(-86400) == '-1d'\n\n\ndef test_format_whole_float():\n    assert format(5400.0) == '1h30m'\n\n\ndef test_format_rejects_fractional():\n    with pytest.raises(ValueError):\n        format(1.5)\n\n\ndef test_format_rejects_non_number():\n    with pytest.raises(TypeError):\n        format('90s')\n\n\n@pytest.mark.parametrize('seconds', [\n    0, 1, 59, 60, 61, 3599, 3600, 5400, 90000, 86399, 86400, 86401,\n    183600, 259200, -1, -90, -5400, -86400, -90000,\n])\ndef test_round_trip(seconds):\n    assert parse(format(seconds)) == seconds\n","filePath":"/home/user/latte-crew/var/worktrees/1107-c20793/tests/test_durations.py"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/home/user/latte-crew/var/worktrees/1107-c20793/tests/test_durations.py","exists":false,"truncated":false},"title":"tests/test_durations.py","time":{"start":1794045945819,"end":1794045945824}},"id":"prt_1b5786d96001OekgtEXVLHsH7L","sessionID":"ses_e4a8955f2ffeiz0JI16iXeUGIG","messageID":"msg_1b57860850019HsB608hhBd0yb"}}
