{"type":"tool_use","timestamp":1794045927454,"sessionID":"ses_e4a8955f2ffeiz0JI16iXeUGIG","part":{"type":"tool","tool":"write","callID":"chatcmpl-tool-ac02b1acafa31236","state":{"status":"completed","input":{"filePath":"/home/user/latte-crew/var/worktrees/1107-c20793/ledgerkit/durations.py","content":"\"\"\"Parse and format human-readable durations like '1h30m'.\"\"\"\n\nimport re\nfrom decimal import Decimal\n\n_UNITS = {'d': 86400, 'h': 3600, 'm': 60, 's': 1}\n_ORDER = {'d': 0, 'h': 1, 'm': 2, 's': 3}\n_PART = re.compile(r'(\\d+(?:\\.\\d+)?)([dhms])')\n_WHOLE = re.compile(r'\\d+(?:\\.\\d+)?[dhms](?:\\s*\\d+(?:\\.\\d+)?[dhms])*')\n\n\ndef parse(text):\n    \"\"\"Parse a duration like '1h30m' into seconds.\n\n    Units d, h, m, s may appear largest to smallest, each at most once,\n    with optional spaces between parts. A leading '-' negates the value.\n    Returns an int when the total is whole, otherwise a float.\n    \"\"\"\n    if not isinstance(text, str):\n        raise TypeError('duration must be a string')\n    text = text.strip()\n    if not text:\n        raise ValueError('empty duration')\n    negative = text.startswith('-')\n    if negative:\n        text = text[1:]\n        if not text:\n            raise ValueError('empty duration')\n    if not _WHOLE.fullmatch(text):\n        raise ValueError(f'invalid duration: {text!r}')\n    parts = _PART.findall(text)\n    units = [unit for _, unit in parts]\n    if len(set(units)) != len(units):\n        raise ValueError(f'repeated unit in: {text!r}')\n    if any(_ORDER[a] > _ORDER[b] for a, b in zip(units, units[1:])):\n        raise ValueError(f'units out of order in: {text!r}')\n    total = Decimal(0)\n    for number, unit in parts:\n        total += Decimal(number) * _UNITS[unit]\n    if negative:\n        total = -total\n    whole = total.to_integral_value()\n    if total == whole:\n        return int(whole)\n    return float(total)\n\n\ndef format(seconds):\n    \"\"\"Format a whole number of seconds as '1h30m', '0s', '-1d', etc.\"\"\"\n    if isinstance(seconds, bool) or not isinstance(seconds, (int, float)):\n        raise TypeError('seconds must be a number')\n    if isinstance(seconds, float):\n        if not seconds.is_integer():\n            raise ValueError('seconds must be a whole number')\n        seconds = int(seconds)\n    sign = '-' if seconds < 0 else ''\n    seconds = abs(seconds)\n    parts = []\n    for unit, size in (('d', 86400), ('h', 3600), ('m', 60), ('s', 1)):\n        count, seconds = divmod(seconds, size)\n        if count:\n            parts.append(f'{count}{unit}')\n    if not parts:\n        return '0s'\n    return sign + ''.join(parts)\n"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/home/user/latte-crew/var/worktrees/1107-c20793/ledgerkit/durations.py","exists":false,"truncated":false},"title":"ledgerkit/durations.py","time":{"start":1794045927442,"end":1794045927452}},"id":"prt_1b57837ba001s4Wjzme4bvkPvp","sessionID":"ses_e4a8955f2ffeiz0JI16iXeUGIG","messageID":"msg_1b576c49c001Yg3lI4qxcWMqVU"}}
