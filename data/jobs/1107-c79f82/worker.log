test.raises(ValueError):\n        parse(None)\n\n\n@pytest.mark.parametrize(\"seconds,expected\", [\n    (0, \"0s\"), (5400, \"1h30m\"), (90, \"1m30s\"), (86400, \"1d\"),\n    (3600, \"1h\"), (183845, \"2d3h4m5s\"), (-5400, \"-1h30m\"), (-1, \"-1s\"),\n    (5400.0, \"1h30m\"),\n])\ndef test_format(seconds, expected):\n    assert format(seconds) == expected\n\n\n@pytest.mark.parametrize(\"bad\", [1.5, \"90\", None])\ndef test_format_invalid(bad):\n    with pytest.raises(ValueError):\n        format(bad)\n\n\n@pytest.mark.parametrize(\"x\", [0, 1, 59, 60, 61, 3599, 3600, 86399, 86400,\n                               90061, 10**9, -1, -60, -90061, -10**9])\ndef test_round_trip(x):\n    assert parse(format(x)) == x\nEOF\npython3 -m pytest -q 2>&1 | tail -15"}}}
