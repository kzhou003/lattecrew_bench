{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01WhziZzCuqBJJNFoFmpmCUW","type":"tool_result","content":" ledgerkit/csvstream.py  | 123 ++++++++++++++++++++++++++++++++\n tests/test_csvstream.py | 184 ++++++++++++++++++++++++++++++++++++++++++++++++\n 2 files changed, 307 insertions(+)\n\"\"\"Streaming RFC 4180 CSV parser.\n\nRecords end with LF, CRLF or a lone CR; a CRLF is a single record end even\nwhen the two characters arrive in separate chunks. Fields may be quoted with\ndouble quotes: a doubled quote inside a quoted field is one quote, and a\nquoted field may contain delimiters and newlines.\n\"\"\"\n\n\nclass CsvStream:\n    \"\"\"Parses CSV incrementally from string chunks of any length.\n\n    ``feed`` returns the list of records completed by the chunk, each record\n    a list of strings. ``finish`` returns the record left in progress (or\n    ``None``) and resets the parser so it can be reused.\n    \"\"\"\n\n    _START = 0  # at a field start: record start or just after a delimiter\n    _FIELD = 1  # inside an unquoted field\n    _QUOTED = 2  # inside a quoted field\n    _AFTER = 3  # just after a closing quote\n\n    def __init__(self, delimiter=','):\n        self._delimiter = delimiter\n        self._reset()\n\n    def _reset(self):\n        self._state = self._START\n        self._field = []\n        self._row = []\n        self._field_started = False\n        self._pending_cr = False\n\n    def feed(self, chunk):\n        rows = []\n        for ch in chunk:\n            self._advance(ch, rows)\n        return rows\n\n    def finish(self):\n        if self._state == self._QUOTED:\n            raise ValueError('quoted field is not terminated')\n        if self._pending_cr:\n            # a CR at the end of the input is a lone record end\n            self._pending_cr = False\n        row = self._take_record()\n        self._reset()\n        return row\n\n    def _advance(self, ch, rows):\n        if self._pending_cr:\n            self._pending_cr = False\n            if ch == '\\n':\n                # CRLF: one record end\n                self._end_record(rows)\n                return\n            # lone CR: the record ended, then process ch as a fresh char\n            self._end_record(rows)\n            return self._advance(ch, rows)\n        if ch == '\\r' and self._state != self._QUOTED:\n            # wait to see whether an LF follows (CRLF) or not (lone CR)\n            self._pending_cr = True\n            return\n\n        state = self._state\n        if state == self._QUOTED:\n            if ch == '\"':\n                self._state = self._AFTER\n            else:\n                self._field.append(ch)\n        elif state == self._AFTER:\n            if ch == '\"':\n                # doubled quote inside the quoted field\n                self._field.append('\"')\n                self._state = self._QUOTED\n            elif ch == self._delimiter:\n                self._commit_field()\n            elif ch == '\\n':\n                self._end_record(rows)\n            else:\n                raise ValueError(\n                    'unexpected character %r after closing quote' % ch\n                )\n        elif state == self._START:\n            if ch == '\"':\n                self._field_started = True\n                self._state = self._QUOTED\n            elif ch == self._delimiter:\n                self._commit_field()\n            elif ch == '\\n':\n                self._end_record(rows)\n            else:\n                self._field.append(ch)\n                self._field_started = True\n                self._state = self._FIELD\n        else:  # _FIELD: a quote here is an ordinary character\n            if ch == self._delimiter:\n                self._commit_field()\n            elif ch == '\\n':\n                self._end_record(rows)\n            else:\n                self._field.append(ch)\n\n    def _commit_field(self):\n        self._row.append(''.join(self._field))\