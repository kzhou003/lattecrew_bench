{"type":"tool_use","timestamp":1794049660248,"sessionID":"ses_e4a523d64ffeZWJGrl6IZk2wti","part":{"type":"tool","tool":"write","callID":"chatcmpl-tool-83535f06223ad6a3","state":{"status":"completed","input":{"filePath":"/home/user/latte-crew/var/worktrees/1107-f186a4/tests/test_csvstream.py","content":"import random\n\nimport pytest\n\nfrom ledgerkit.csvstream import CsvStream\n\n\ndef parse(*chunks, delimiter=','):\n    s = CsvStream(delimiter=delimiter)\n    rows = []\n    for chunk in chunks:\n        rows.extend(s.feed(chunk))\n    rows.append(s.finish())\n    return [row for row in rows if row is not None]\n\n\ndef test_simple_rows():\n    s = CsvStream()\n    assert s.feed('a,b\\nc,d\\n') == [['a', 'b'], ['c', 'd']]\n    assert s.finish() is None\n\n\ndef test_line_ending_variants():\n    assert parse('a,b\\n') == [['a', 'b']]\n    assert parse('a,b\\r\\n') == [['a', 'b']]\n    assert parse('a,b\\rc,d') == [['a', 'b'], ['c', 'd']]\n    assert parse('a,b\\r\\nc,d\\r\\ne,f\\r') == [['a', 'b'], ['c', 'd'], ['e', 'f']]\n\n\ndef test_crlf_split_across_chunks_is_one_record_end():\n    s = CsvStream()\n    assert s.feed('a,b\\r') == []\n    assert s.feed('\\n') == [['a', 'b']]\n    assert s.finish() is None\n\n\ndef test_trailing_cr_is_a_record_end():\n    s = CsvStream()\n    assert s.feed('a,b\\r') == []\n    assert s.finish() == ['a', 'b']\n\n\ndef test_blank_line_produces_no_row():\n    assert parse('a\\n\\nb\\n') == [['a'], ['b']]\n    assert parse('\\n\\n') == []\n    assert parse('a\\n\\n') == [['a']]\n\n\ndef test_quoted_field_with_delimiter_and_newlines():\n    assert parse('\"a,b\",c\\n') == [['a,b', 'c']]\n    assert parse('\"a\\nb\",c\\n') == [['a\\nb', 'c']]\n    assert parse('\"a\\r\\nb\",c\\n') == [['a\\r\\nb', 'c']]\n    assert parse('\"a\\rb\",c\\n') == [['a\\rb', 'c']]\n\n\ndef test_doubled_quote_inside_quoted_field():\n    assert parse('\"a\"\"b\",c\\n') == [['a\"b', 'c']]\n    assert parse('\"\"\"\"\\n') == [['\"']]\n    assert parse('a,\"x\"\"\",\\n') == [['a', 'x\"', '']]\n\n\ndef test_quoted_empty_field_on_its_own_line():\n    assert parse('\"\"\\n') == [['']]\n    s = CsvStream()\n    assert s.feed('\"\"') == []\n    assert s.finish() == ['']\n\n\ndef test_quote_in_unquoted_field_is_ordinary():\n    assert parse('a\"b,c\\n') == [['a\"b', 'c']]\n    assert parse('a\"\"\\n') == [['a\"\"']]\n    assert parse('a\"b\"c\\n') == [['a\"b\"c']]\n\n\ndef test_trailing_record_without_final_newline():\n    s = CsvStream()\n    assert s.feed('a,b') == []\n    assert s.finish() == ['a', 'b']\n\n\ndef test_trailing_delimiter_gives_empty_field():\n    s = CsvStream()\n    assert s.feed('a,') == []\n    assert s.finish() == ['a', '']\n    assert parse('a,\\n') == [['a', '']]\n    assert parse(',\\n') == [['', '']]\n    assert parse(',,\\n') == [['', '', '']]\n\n\ndef test_garbage_after_closing_quote_raises():\n    with pytest.raises(ValueError):\n        parse('\"a\"b\\n')\n    s = CsvStream()\n    s.feed('\"a\"')\n    with pytest.raises(ValueError):\n        s.feed('b\\n')\n    s = CsvStream()\n    s.feed('\"a\" ')\n    with pytest.raises(ValueError):\n        s.finish()\n\n\ndef test_unterminated_quote_at_finish_raises():\n    s = CsvStream()\n    assert s.feed('\"a') == []\n    with pytest.raises(ValueError):\n        s.finish()\n\n\ndef test_reuse_after_finish():\n    s = CsvStream()\n    assert s.feed('a,b') == []\n    assert s.finish() == ['a', 'b']\n    assert s.feed('c,d\\ne,f') == [['c', 'd']]\n    assert s.finish() == ['e', 'f']\n\n\ndef test_custom_delimiter():\n    assert parse('a;b\\nc;d', delimiter=';') == [['a', 'b'], ['c', 'd']]\n\n\ndef test_whitespace_is_preserved():\n    assert parse(' a , b \\n') == [[' a ', ' b ']]\n    assert parse('  \\n') == [['  ']]\n\n\ndef test_feed_returns_only_completed_rows():\n    s = CsvStream()\n    assert s.feed('a') == []\n    assert s.feed(',b') == []\n    assert s.feed('\\n') == [['a', 'b']]\n    assert s.feed('\"x,y\"') == []\n    assert s.feed('\\n') == [['x,y']]\n\n\ndef test_one_char_at_a_time():\n    data = 'a,b\\n\"x\"\"y\",\"m\\nn\"\\r\\n\\np,q'\n    expected = parse(data)\n    assert expected == [['a', 'b'], ['x\"y', 'm\\nn'], ['p', 'q']]\n    s = CsvStream()\n    rows = []\n    for ch in data:\n        rows.extend(s.feed(ch))\n    rows.append(s.finish())\n    assert [row for row in rows if row is not None] == expected\n\n\ndef test_quote_pair_split_across_chunks():\n    assert parse('a,\"', '\"b\"\\n') == [['a', '\"b\"']]\n    assert parse('a,\"x\"\"', '\"y\"\\n') == [['a', 'x\"y']]\n    assert parse('a,\"x\"\"', 'b\"\\n') == [['a', 'x\"b']]\n\n\ndef test_split_invariance_every_single_split():\n    data = (\n        'a,b\\n'\n        '\"q\",\"c\"\"d\"\\r\\n'\n        'x,\\r\\n'\n        '\"multi\\nline,with delim\",e\\r\\n'\n        '\\n'\n        'f,g'\n    )\n    expected = parse(data)\n    for i in range(len(data) + 1):\n        assert parse(data[:i], data[i:]) == expected, i\n\n\ndef test_split_invariance_random_splits():\n    rng = random.Random(42)\n    data = 'a,\"b,c\",d\\n\"x\"\"y\",\\r\\n\"q\\r\\nr\",s\\n\"t\"\"\\n\\nt,u'\n    expected = parse(data)\n    for _ in range(200):\n        pieces = []\n        i = 0\n        while i < len(data):\n            j = rng.randint(i + 1, len(data))\n            pieces.append(data[i:j])\n            i = j\n        assert parse(*pieces) == expected\n\n\ndef test_empty_input():\n    s = CsvStream()\n    assert s.feed('') == []\n    assert s.finish() is None\n"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/home/user/latte-crew/var/worktrees/1107-f186a4/tests/test_csvstream.py","exists":false,"truncated":false},"title":"tests/test_csvstream.py","time":{"start":1794049660242,"end":1794049660247}},"id":"prt_1b5b0fa480019gKt6gxFF03Xz2","sessionID":"ses_e4a523d64ffeZWJGrl6IZk2wti","messageID":"msg_1b5b0f6bc001fboRlZaWJ9rV6i"}}
