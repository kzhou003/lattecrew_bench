{"type":"assistant","message":{"model":"claude-sonnet-5-5","id":"msg_011CgoF5vipAZCcyfP9wytSC","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01JbVoShvdScfXzYQWvPgjft","name":"Write","input":{"file_path":"/home/user/latte-crew/var/worktrees/1107-10d03b/tests/test_slots.py","content":"from datetime import datetime, timedelta, timezone\n\nimport pytest\n\nfrom ledgerkit.slots import free_slots\n\nUTC = timezone.utc\nP2 = timezone(timedelta(hours=2))\n\n\ndef d(h, m=0, tz=UTC):\n    return datetime(2026, 1, 1, h, m, tzinfo=tz)\n\n\nDS, DE = d(9), d(17)\n\n\ndef test_no_busy():\n    assert free_slots([], DS, DE) == [(DS, DE)]\n\n\ndef test_unsorted_overlapping_merge():\n    busy = [(d(12), d(13)), (d(10), d(11)), (d(10, 30), d(12))]\n    assert free_slots(busy, DS, DE) == [(d(9), d(10)), (d(13), d(17))]\n\n\ndef test_touching_no_zero_gap():\n    busy = [(d(10), d(11)), (d(11), d(12))]\n    assert free_slots(busy, DS, DE) == [(d(9), d(10)), (d(12), d(17))]\n\n\ndef test_clipping_and_outside():\n    busy = [(d(7), d(10)), (d(16), d(20)), (d(1), d(2)), (d(18), d(19))]\n    assert free_slots(busy, DS, DE) == [(d(10), d(16))]\n\n\ndef test_busy_covers_all():\n    assert free_slots([(d(8), d(18))], DS, DE) == []\n\n\ndef test_min_minutes():\n    busy = [(d(9, 30), d(10)), (d(10, 20), d(16))]\n    assert free_slots(busy, DS, DE, min_minutes=30) == [(d(9), d(9, 30)), (d(16), d(17))]\n    assert free_slots(busy, DS, DE, min_minutes=31) == [(d(16), d(17))]\n\n\ndef test_zero_length_busy_ignored():\n    assert free_slots([(d(12), d(12))], DS, DE) == [(DS, DE)]\n\n\ndef test_mixed_offsets_and_output_tz():\n    ds, de = d(9, tz=P2), d(17, tz=P2)  # 07:00-15:00 UTC\n    busy = [(d(9), d(10))]  # 09:00-10:00 UTC == 11:00-12:00 +02\n    res = free_slots(busy, ds, de)\n    assert res == [(d(9, tz=P2), d(11, tz=P2)), (d(12, tz=P2), d(17, tz=P2))]\n    assert all(x.utcoffset() == timedelta(hours=2) for g in res for x in g)\n\n\ndef test_naive_raises():\n    naive = datetime(2026, 1, 1, 10)\n    with pytest.raises(ValueError):\n        free_slots([(naive, d(11))], DS, DE)\n    with pytest.raises(ValueError):\n        free_slots([], naive, DE)\n    with pytest.raises(ValueError):\n        free_slots([], DS, naive)\n\n\ndef test_end_before_start_raises():\n    with pytest.raises(ValueError):\n        free_slots([(d(11), d(10))], DS, DE)\n    # validated even when outside the window\n    with pytest.raises(ValueError):\n        free_slots([(d(20), d(19))], DS, DE)\n\n\ndef test_bad_window_raises():\n    with pytest.raises(ValueError):\n        free_slots([], DE, DS)\n    with pytest.raises(ValueError):\n        free_slots([], DS, DS)\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1738,"cache_read_input_tokens":30719,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1738},"output_tokens":16,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"2f43ceb1-fcc1-40b4-9122-7e288507cb29","uuid":"d6549946-a9b0-47df-8f0e-24a7a7a8fea0","timestamp":"2026-11-07T08:22:05.401Z","request_id":"req_011CgoF5vZPSrGwksLYKDUCB","wire_tool_inputs":{"toolu_01JbVoShvdScfXzYQWvPgjft":{"file_path":"/home/user/latte-crew/var/worktrees/1107-10d03b/tests/test_slots.py","content":"from datetime import datetime, timedelta, timezone\n\nimport pytest\n\nfrom ledgerkit.slots import free_slots\n\nUTC = timezone.utc\nP2 = timezone(timedelta(hours=2))\n\n\ndef d(h, m=0, tz=UTC):\n    return datetime(2026, 1, 1, h, m, tzinfo=tz)\n\n\nDS, DE = d(9), d(17)\n\n\ndef test_no_busy():\n    assert free_slots([], DS, DE) == [(DS, DE)]\n\n\ndef test_unsorted_overlapping_merge():\n    busy = [(d(12), d(13)), (d(10), d(11)), (d(10, 30), d(12))]\n    assert free_slots(busy, DS, DE) == [(d(9), d(10)), (d(13), d(17))]\n\n\ndef test_touching_no_zero_gap():\n    busy = [(d(10), d(11)), (d(11), d(12))]\n    assert free_slots(busy, DS, DE) == [(d(9), d(10)), (d(12), d(17))]\n\n\ndef test_clipping_and_outside():\n    busy = [(d(7), d(10)), (d(16), d(20)), (d(1), d(2)), (d(18), d(19))]\n    assert free_slots(busy, DS, DE) == [(d(10), d(16))]\n\n\ndef test_busy_covers_all():\n    assert free_slots([(d(8), d(18))], DS, DE) == []\n\n\ndef test_min_minutes():\n    busy = [(d(9, 30), d(10)), (d(10, 20), d(16))]\n    assert free_slots(busy, DS, DE, min_minutes=30) == [(d(9), d(9, 30)), (d(16), d(17))]\n    assert free_slots(busy, DS, DE, min_minutes=31) == [(d(16), d(17))]\n\n\ndef test_zero_length_busy_ignored():\n    assert free_slots([(d(12), d(12))], DS, DE) == [(DS, DE)]\n\n\ndef test_mixed_offsets_and_output_tz():\n    ds, de = d(9, tz=P2), d(17, tz=P2)  # 07:00-15:00 UTC\n    busy = [(d(9), d(10))]  # 09:00-10:00 UTC == 11:00-12:00 +02\n    res = free_slots(busy, ds, de)\n    assert res == [(d(9, tz=P2), d(11, tz=P2)), (d(12, tz=P2), d(17, tz=P2))]\n    assert all(x.utcoffset() == timedelta(hours=2) for g in res for x in g)\n\n\ndef test_naive_raises():\n    naive = datetime(2026, 1, 1, 10)\n    with pytest.raises(ValueError):\n        free_slots([(naive, d(11))], DS, DE)\n    with pytest.raises(ValueError):\n        free_slots([], naive, DE)\n    with pytest.raises(ValueError):\n        free_slots([], DS, naive)\n\n\ndef test_end_before_start_raises():\n    with pytest.raises(ValueError):\n        free_slots([(d(11), d(10))], DS, DE)\n    # validated even when outside the window\n    with pytest.raises(ValueError):\n        free_slots([(d(20), d(19))], DS, DE)\n\n\ndef test_bad_window_raises():\n    with pytest.raises(ValueError):\n        free_slots([], DE, DS)\n    with pytest.raises(ValueError):\n        free_slots([], DS, DS)\n"}}}
