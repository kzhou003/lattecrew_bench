{"type":"tool_use","timestamp":1794048556173,"sessionID":"ses_e4a6faf75ffeWknnGBCeXJ18Fc","part":{"type":"tool","tool":"write","callID":"chatcmpl-tool-b5f415dc4dc81f9c","state":{"status":"completed","input":{"filePath":"/home/user/latte-crew/var/worktrees/1107-41e94c/ledgerkit/limiter.py","content":"\"\"\"Thread-safe token bucket rate limiter.\"\"\"\n\nimport threading\nimport time\n\n_EPS = 1e-6\n\n\nclass TokenBucket:\n    def __init__(self, rate, capacity, clock=time.monotonic):\n        rate = float(rate)\n        capacity = float(capacity)\n        if not rate > 0:\n            raise ValueError(\"rate must be positive\")\n        if not capacity > 0:\n            raise ValueError(\"capacity must be positive\")\n\n        self._rate = rate\n        self._capacity = capacity\n        self._clock = clock\n        self._tokens = capacity\n        self._time = clock()\n        self._tolerance = _EPS * capacity\n        self._lock = threading.Lock()\n\n    def _refill(self, now):\n        if now < self._time:\n            self._time = now\n            return\n        self._tokens = min(\n            self._capacity,\n            self._tokens + (now - self._time) * self._rate,\n        )\n        self._time = now\n\n    def _validate_request(self, n):\n        n = float(n)\n        if not n > 0:\n            raise ValueError(\"n must be positive\")\n        if n > self._capacity:\n            raise ValueError(\"n cannot exceed capacity\")\n        return n\n\n    def try_acquire(self, n=1):\n        n = self._validate_request(n)\n        with self._lock:\n            self._refill(self._clock())\n            if self._tokens + self._tolerance >= n:\n                self._tokens = max(0.0, self._tokens - n)\n                return True\n            return False\n\n    def wait_time(self, n=1):\n        n = self._validate_request(n)\n        with self._lock:\n            self._refill(self._clock())\n            if self._tokens + self._tolerance >= n:\n                return 0.0\n            return (n - self._tokens) / self._rate\n"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/home/user/latte-crew/var/worktrees/1107-41e94c/ledgerkit/limiter.py","exists":false,"truncated":false},"title":"ledgerkit/limiter.py","time":{"start":1794048556165,"end":1794048556171}},"id":"prt_1b5a06135001Sr4ZpKDT4XQnEq","sessionID":"ses_e4a6faf75ffeWknnGBCeXJ18Fc","messageID":"msg_1b5a05149001IYFW0whfHTvYfB"}}
{"type":"tool_use","timestamp":1794048573577,"sessionID":"ses_e4a6faf75ffeWknnGBCeXJ18Fc","part":{"type":"tool","tool":"write","callID":"chatcmpl-tool-896cf1161d073abe","state":{"status":"completed","input":{"filePath":"/home/user/latte-crew/var/worktrees/1107-41e94c/tests/test_limiter.py","content":"import threading\n\nimport pytest\n\nfrom ledgerkit.limiter import TokenBucket\n\n\nclass FakeClock:\n    def __init__(self, start=0.0):\n        self.now = float(start)\n\n    def __call__(self):\n        return self.now\n\n    def advance(self, seconds):\n        self.now += float(seconds)\n\n    def set(self, seconds):\n        self.now = float(seconds)\n\n\ndef test_constructor_rejects_non_positive_rate_or_capacity():\n    clock = FakeClock()\n    with pytest.raises(ValueError):\n        TokenBucket(rate=0, capacity=10, clock=clock)\n    with pytest.raises(ValueError):\n        TokenBucket(rate=-1, capacity=10, clock=clock)\n    with pytest.raises(ValueError):\n        TokenBucket(rate=1, capacity=0, clock=clock)\n    with pytest.raises(ValueError):\n        TokenBucket(rate=1, capacity=-10, clock=clock)\n\n\ndef test_methods_reject_invalid_n():\n    bucket = TokenBucket(rate=1, capacity=10, clock=FakeClock())\n    for n in (0, -1, 11):\n        with pytest.raises(ValueError):\n            bucket.try_acquire(n)\n        with pytest.raises(ValueError):\n            bucket.wait_time(n)\n\n\ndef test_starts_full():\n    bucket = TokenBucket(rate=1, capacity=5, clock=FakeClock())\n    assert bucket.try_acquire(5)\n    assert not bucket.try_acquire(1)\n    assert bucket.wait_time(1) == 1.0\n\n\ndef test_default_n_is_one():\n    bucket = TokenBucket(rate=1, capacity=1, clock=FakeClock())\n    assert bucket.wait_time() == 0.0\n    assert bucket.try_acquire()\n    assert bucket.wait_time() == 1.0\n    assert not bucket.try_acquire()\n\n\ndef test_basic_acquire_and_wait_time():\n    clock = FakeClock()\n    bucket = TokenBucket(rate=1, capacity=5, clock=clock)\n    assert bucket.try_acquire(2)\n    assert bucket.wait_time(2) == 2.0\n    assert not bucket.try_acquire(4)\n    assert bucket.try_acquire(3)\n    assert not bucket.try_acquire(1)\n\n\ndef test_wait_time_does_not_consume():\n    bucket = TokenBucket(rate=2, capacity=10, clock=FakeClock())\n    assert bucket.try_acquire(8)\n    assert bucket.wait_time(4) == 2.0\n    assert bucket.wait_time(4) == 2.0\n    assert bucket.try_acquire(2)\n    assert not bucket.try_acquire(2)\n\n\ndef test_failed_try_acquire_does_not_consume():\n    bucket = TokenBucket(rate=1, capacity=5, clock=FakeClock())\n    assert bucket.try_acquire(3)\n    assert not bucket.try_acquire(3)\n    assert bucket.wait_time(3) == 3.0\n    assert not bucket.try_acquire(1)\n    assert bucket.wait_time(1) == 1.0\n\n\ndef test_refill_is_capped():\n    clock = FakeClock()\n    bucket = TokenBucket(rate=10, capacity=5, clock=clock)\n    clock.advance(100)\n    assert bucket.wait_time(5) == 0.0\n    assert bucket.try_acquire(5)\n    assert not bucket.try_acquire(1)\n\n\ndef test_backward_clock_does_not_refill():\n    clock = FakeClock(100.0)\n    bucket = TokenBucket(rate=10, capacity=10, clock=clock)\n    assert bucket.try_acquire(5)\n    clock.set(50.0)\n    assert bucket.wait_time(5) == 0.0\n    clock.advance(1.0)\n    assert bucket.try_acquire(6)\n    assert not bucket.try_acquire(1)\n\n\n@pytest.mark.parametrize(\"rate\", [0.1, 3.0, 7.0])\n@pytest.mark.parametrize(\"capacity\", [1, 5, 100, 1000])\ndef test_exact_affordability_after_wait_time(rate, capacity):\n    clock = FakeClock()\n    bucket = TokenBucket(rate=rate, capacity=capacity, clock=clock)\n    n_values = {1, capacity}\n    if capacity >= 4:\n        n_values.add(capacity // 2)\n\n    for n in sorted(n_values):\n        for _ in range(10_000):\n            wait = bucket.wait_time(n)\n            assert wait >= 0.0\n            clock.advance(wait)\n            assert bucket.try_acquire(n)\n\n\ndef test_thread_safety_no_over_acquisition():\n    clock = FakeClock()\n    bucket = TokenBucket(rate=1000, capacity=100, clock=clock)\n    results = []\n    results_lock = threading.Lock()\n\n    def worker():\n        acquired = 0\n        for _ in range(1000):\n            if bucket.try_acquire(1):\n                acquired += 1\n        with results_lock:\n            results.append(acquired)\n\n    threads = [threading.Thread(target=worker) for _ in range(10)]\n    for thread in threads:\n        thread.start()\n    for thread in threads:\n        thread.join()\n\n    assert sum(results) == 100\n"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/home/user/latte-crew/var/worktrees/1107-41e94c/tests/test_limiter.py","exists":false,"truncated":false},"title":"tests/test_limiter.py","time":{"start":1794048573572,"end":1794048573576}},"id":"prt_1b5a07d1d001Zu6S5qw2jlkwna","sessionID":"ses_e4a6faf75ffeWknnGBCeXJ18Fc","messageID":"msg_1b5a05149001IYFW0whfHTvYfB"}}
