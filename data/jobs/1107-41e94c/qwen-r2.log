{"type":"tool_use","timestamp":1794049314497,"sessionID":"ses_e4a6faf75ffeWknnGBCeXJ18Fc","part":{"type":"tool","tool":"edit","callID":"chatcmpl-tool-9a51c2e7bad4b5be","state":{"status":"completed","input":{"filePath":"/home/user/latte-crew/var/worktrees/1107-41e94c/tests/test_limiter.py","oldString":"def test_thread_safety_no_over_acquisition():\n    clock = FakeClock()\n    bucket = TokenBucket(rate=1000, capacity=100, clock=clock)\n    results = []\n    results_lock = threading.Lock()\n\n    def worker():\n        acquired = 0\n        for _ in range(1000):\n            if bucket.try_acquire(1):\n                acquired += 1\n        with results_lock:\n            results.append(acquired)\n\n    threads = [threading.Thread(target=worker) for _ in range(10)]\n    for thread in threads:\n        thread.start()\n    for thread in threads:\n        thread.join()\n\n    assert sum(results) == 100","newString":"def test_thread_safety_no_over_acquisition():\n    clock = FakeClock()\n    bucket = TokenBucket(rate=1000, capacity=100, clock=clock)\n    results = []\n    results_lock = threading.Lock()\n\n    def worker():\n        acquired = 0\n        for _ in range(1000):\n            if bucket.try_acquire(1):\n                acquired += 1\n        with results_lock:\n            results.append(acquired)\n\n    threads = [threading.Thread(target=worker) for _ in range(10)]\n    for thread in threads:\n        thread.start()\n    for thread in threads:\n        thread.join()\n\n    assert sum(results) == 100\n\n\n@pytest.mark.parametrize(\"capacity\", [10**6, 10**7])\ndef test_large_capacity_no_over_acquisition_after_drain(capacity):\n    # Regression: a capacity-scaled tolerance let the bucket grant tokens\n    # that did not exist for large capacities.\n    bucket = TokenBucket(rate=1, capacity=capacity, clock=FakeClock())\n    assert bucket.try_acquire(capacity)\n    assert not bucket.try_acquire(1)\n    assert bucket.wait_time(1) == pytest.approx(1.0)\n\n\n@pytest.mark.parametrize(\"rate\", [0.1, 3.0, 7.0])\n@pytest.mark.parametrize(\"capacity\", [1, 5, 100, 1000])\ndef test_large_cycle_wait_time_is_affordable(rate, capacity):\n    # The wait_time reported after a partial drain must be enough to make the\n    # requested number of tokens available when the clock advances by it.\n    clock = FakeClock()\n    bucket = TokenBucket(rate=rate, capacity=capacity, clock=clock)\n    for n in (1, capacity):\n        bucket.try_acquire(n)\n        for _ in range(5_000):\n            wait = bucket.wait_time(n)\n            assert wait >= 0.0\n            clock.advance(wait)\n            assert bucket.try_acquire(n)\n\n\ndef test_large_capacity_concurrency_no_over_acquisition():\n    clock = FakeClock()\n    bucket = TokenBucket(rate=1000, capacity=10**6, clock=clock)\n    results = []\n    results_lock = threading.Lock()\n\n    def worker():\n        acquired = 0\n        for _ in range(10**5):\n            if bucket.try_acquire(1):\n                acquired += 1\n        with results_lock:\n            results.append(acquired)\n\n    threads = [threading.Thread(target=worker) for _ in range(10)]\n    for thread in threads:\n        thread.start()\n    for thread in threads:\n        thread.join()\n\n    # Clock is frozen so no refill happens; exactly capacity tokens may be\n    # granted. Any over-acquisition would push the total above capacity.\n    assert sum(results) == 10**6"},"output":"Edit applied successfully.","metadata":{"diagnostics":{},"diff":"Index: /home/user/latte-crew/var/worktrees/1107-41e94c/tests/test_limiter.py\n===================================================================\n--- /home/user/latte-crew/var/worktrees/1107-41e94c/tests/test_limiter.py\n+++ /home/user/latte-crew/var/worktrees/1107-41e94c/tests/test_limiter.py\n@@ -141,4 +141,55 @@\n     for thread in threads:\n         thread.join()\n \n     assert sum(results) == 100\n+\n+\n+@pytest.mark.parametrize(\"capacity\", [10**6, 10**7])\n+def test_large_capacity_no_over_acquisition_after_drain(capacity):\n+    # Regression: a capacity-scaled tolerance let the bucket grant tokens\n+    # that did not exist for large capacities.\n+    bucket = TokenBucket(rate=1, capacity=capacity, clock=FakeClock())\n+    assert bucket.try_acquire(capacity)\n+    assert not bucket.try_acquire(1)\n+    assert bucket.wait_time(1) == pytest.approx(1.0)\n+\n+\n+@pytest.mark.parametrize(\"rate\", [0.1, 3.0, 7.0])\n+@pytest.mark.parametrize(\"capacity\", [1, 5, 100, 1000])\n+def test_large_cycle_wait_time_is_affordable(rate, capacity):\n+    # The wait_time reported after a partial drain must be enough to make the\n+    # requested number of tokens available when the clock advances by it.\n+    clock = FakeClock()\n+    bucket = TokenBucket(rate=rate, capacity=capacity, clock=clock)\n+    for n in (1, capacity):\n+        bucket.try_acquire(n)\n+        for _ in range(5_000):\n+            wait = bucket.wait_time(n)\n+            assert wait >= 0.0\n+            clock.advance(wait)\n+            assert bucket.try_acquire(n)\n+\n+\n+def test_large_capacity_concurrency_no_over_acquisition():\n+    clock = FakeClock()\n+    bucket = TokenBucket(rate=1000, capacity=10**6, clock=clock)\n+    results = []\n+    results_lock = threading.Lock()\n+\n+    def worker():\n+        acquired = 0\n+        for _ in range(10**5):\n+            if bucket.try_acquire(1):\n+                acquired += 1\n+        with results_lock:\n+            results.append(acquired)\n+\n+    threads = [threading.Thread(target=worker) for _ in range(10)]\n+    for thread in threads:\n+        thread.start()\n+    for thread in threads:\n+        thread.join()\n+\n+    # Clock is frozen so no refill happens; exactly capacity tokens may be\n+    # granted. Any over-acquisition would push the total above capacity.\n+    assert sum(results) == 10**6\n","filediff":{"file":"/home/user/latte-crew/var/worktrees/1107-41e94c/tests/test_limiter.py","patch":"Index: /home/user/latte-crew/var/worktrees/1107-41e94c/tests/test_limiter.py\n===================================================================\n--- /home/user/latte-crew/var/worktrees/1107-41e94c/tests/test_limiter.py\n+++ /home/user/latte-crew/var/worktrees/1107-41e94c/tests/test_limiter.py\n@@ -141,4 +141,55 @@\n     for thread in threads:\n         thread.join()\n \n     assert sum(results) == 100\n+\n+\n+@pytest.mark.parametrize(\"capacity\", [10**6, 10**7])\n+def test_large_capacity_no_over_acquisition_after_drain(capacity):\n+    # Regression: a capacity-scaled tolerance let the bucket grant tokens\n+    # that did not exist for large capacities.\n+    bucket = TokenBucket(rate=1, capacity=capacity, clock=FakeClock())\n+    assert bucket.try_acquire(capacity)\n+    assert not bucket.try_acquire(1)\n+    assert bucket.wait_time(1) == pytest.approx(1.0)\n+\n+\n+@pytest.mark.parametrize(\"rate\", [0.1, 3.0, 7.0])\n+@pytest.mark.parametrize(\"capacity\", [1, 5, 100, 1000])\n+def test_large_cycle_wait_time_is_affordable(rate, capacity):\n+    # The wait_time reported after a partial drain must be enough to make the\n+    # requested number of tokens available when the clock advances by it.\n+    clock = FakeClock()\n+    bucket = TokenBucket(rate=rate, capacity=capacity, clock=clock)\n+    for n in (1, capacity):\n+        bucket.try_acquire(n)\n+        for _ in range(5_000):\n+            wait = bucket.wait_time(n)\n+            assert wait >= 0.0\n+            clock.advance(wait)\n+            assert bucket.try_acquire(n)\n+\n+\n+def test_large_capacity_concurrency_no_over_acquisition():\n+    clock = FakeClock()\n+    bucket = TokenBucket(rate=1000, capacity=10**6, clock=clock)\n+    results = []\n+    results_lock = threading.Lock()\n+\n+    def worker():\n+        acquired = 0\n+        for _ in range(10**5):\n+            if bucket.try_acquire(1):\n+                acquired += 1\n+        with results_lock:\n+            results.append(acquired)\n+\n+    threads = [threading.Thread(target=worker) for _ in range(10)]\n+    for thread in threads:\n+        thread.start()\n+    for thread in threads:\n+        thread.join()\n+\n+    # Clock is frozen so no refill happens; exactly capacity tokens may be\n+    # granted. Any over-acquisition would push the total above capacity.\n+    assert sum(results) == 10**6\n","additions":51,"deletions":0},"truncated":false},"title":"tests/test_limiter.py","time":{"start":1794049314488,"end":1794049314495}},"id":"prt_1b5abdedf001JYBcgoSTygq1uI","sessionID":"ses_e4a6faf75ffeWknnGBCeXJ18Fc","messageID":"msg_1b5ab66d30015TsaFwe4q20JPc"}}
