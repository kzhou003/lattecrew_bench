{"type":"tool_use","timestamp":1794049219573,"sessionID":"ses_e4a6faf75ffeWknnGBCeXJ18Fc","part":{"type":"tool","tool":"read","callID":"chatcmpl-tool-aca0db8bb556587e","state":{"status":"completed","input":{"filePath":"/home/user/latte-crew/var/worktrees/1107-41e94c/ledgerkit/limiter.py"},"output":"<path>/home/user/latte-crew/var/worktrees/1107-41e94c/ledgerkit/limiter.py</path>\n<type>file</type>\n<content>\n1: \"\"\"Thread-safe token bucket rate limiter.\"\"\"\n2: \n3: import math\n4: import threading\n5: import time\n6: from fractions import Fraction\n7: \n8: \n9: class TokenBucket:\n10:     def __init__(self, rate, capacity, clock=time.monotonic):\n11:         rate = float(rate)\n12:         capacity = float(capacity)\n13:         if not math.isfinite(rate) or not rate > 0:\n14:             raise ValueError(\"rate must be positive\")\n15:         if not math.isfinite(capacity) or not capacity > 0:\n16:             raise ValueError(\"capacity must be positive\")\n17: \n18:         self._rate = Fraction(rate)\n19:         self._capacity = Fraction(capacity)\n20:         self._clock = clock\n21:         self._tokens = self._capacity\n22:         now = float(clock())\n23:         if not math.isfinite(now):\n24:             raise ValueError(\"clock must return a finite number\")\n25:         self._time = Fraction(now)\n26:         self._time_value = now\n27:         self._lock = threading.Lock()\n28: \n29:     def _refill(self, now_value):\n30:         now_value = float(now_value)\n31:         if not math.isfinite(now_value):\n32:             raise ValueError(\"clock must return a finite number\")\n33:         now = Fraction(now_value)\n34:         if now < self._time:\n35:             self._time = now\n36:             self._time_value = now_value\n37:             return\n38:         if now > self._time:\n39:             self._tokens = min(\n40:                 self._capacity,\n41:                 self._tokens + (now - self._time) * self._rate,\n42:             )\n43:             self._time = now\n44:             self._time_value = now_value\n45: \n46:     def _validate_request(self, n):\n47:         n = float(n)\n48:         if not math.isfinite(n) or not n > 0:\n49:             raise ValueError(\"n must be positive\")\n50:         n = Fraction(n)\n51:         if n > self._capacity:\n52:             raise ValueError(\"n cannot exceed capacity\")\n53:         return n\n54: \n55:     def try_acquire(self, n=1):\n56:         n = self._validate_request(n)\n57:         with self._lock:\n58:             self._refill(self._clock())\n59:             if self._tokens >= n:\n60:                 self._tokens -= n\n61:                 return True\n62:             return False\n63: \n64:     def wait_time(self, n=1):\n65:         n = self._validate_request(n)\n66:         with self._lock:\n67:             self._refill(self._clock())\n68:             if self._tokens >= n:\n69:                 return 0.0\n70: \n71:             required = self._time + (n - self._tokens) / self._rate\n72:             try:\n73:                 delay = float(required - self._time)\n74:             except OverflowError:\n75:                 return math.inf\n76:             if not math.isfinite(delay):\n77:                 return math.inf\n78: \n79:             target = self._time_value + delay\n80:             if not math.isfinite(target):\n81:                 return math.inf\n82:             if target <= self._time_value:\n83:                 target = math.nextafter(self._time_value, math.inf)\n84:                 if not math.isfinite(target):\n85:                     return math.inf\n86: \n87:             for _ in range(128):\n88:                 if target <= self._time_value:\n89:                     target = math.nextafter(self._time_value, math.inf)\n90:                     if not math.isfinite(target):\n91:                         return math.inf\n92:                 elif Fraction(target) >= required:\n93:                     delay = target - self._time_value\n94:                     if delay <= 0.0:\n95:                         next_time = math.nextafter(self._time_value, math.inf)\n96:                         if not math.isfinite(next_time):\n97:                             return math.inf\n98:                         delay = next_time - self._time_value\n99: \n100:                     for _ in range(128):\n101:                         if delay <= 0.0:\n102:                             landed = math.nextafter(self._time_value, math.inf)\n103:                         else:\n104:                             landed = self._time_value + delay\n105:                         if landed <= self._time_value:\n106:                             landed = math.nextafter(self._time_value, math.inf)\n107:                         if not math.isfinite(landed):\n108:                             return math.inf\n109:                         if Fraction(landed) >= required:\n110:                             return delay\n111:                         delay = math.nextafter(delay, math.inf)\n112:                     return delay\n113:                 else:\n114:                     target = math.nextafter(target, math.inf)\n115:                     if not math.isfinite(target):\n116:                         return math.inf\n117: \n118:             return delay\n\n(End of file - total 118 lines)\n</content>","metadata":{"preview":"\"\"\"Thread-safe token bucket rate limiter.\"\"\"\n\nimport math\nimport threading\nimport time\nfrom fractions import Fraction\n\n\nclass TokenBucket:\n    def __init__(self, rate, capacity, clock=time.monotonic):\n        rate = float(rate)\n        capacity = float(capacity)\n        if not math.isfinite(rate) or not rate > 0:\n            raise ValueError(\"rate must be positive\")\n        if not math.isfinite(capacity) or not capacity > 0:\n            raise ValueError(\"capacity must be positive\")\n\n        self._rate = Fraction(rate)\n        self._capacity = Fraction(capacity)\n        self._clock = clock","truncated":false,"loaded":[],"display":{"type":"file","path":"/home/user/latte-crew/var/worktrees/1107-41e94c/ledgerkit/limiter.py","text":"\"\"\"Thread-safe token bucket rate limiter.\"\"\"\n\nimport math\nimport threading\nimport time\nfrom fractions import Fraction\n\n\nclass TokenBucket:\n    def __init__(self, rate, capacity, clock=time.monotonic):\n        rate = float(rate)\n        capacity = float(capacity)\n        if not math.isfinite(rate) or not rate > 0:\n            raise ValueError(\"rate must be positive\")\n        if not math.isfinite(capacity) or not capacity > 0:\n            raise ValueError(\"capacity must be positive\")\n\n        self._rate = Fraction(rate)\n        self._capacity = Fraction(capacity)\n        self._clock = clock\n        self._tokens = self._capacity\n        now = float(clock())\n        if not math.isfinite(now):\n            raise ValueError(\"clock must return a finite number\")\n        self._time = Fraction(now)\n        self._time_value = now\n        self._lock = threading.Lock()\n\n    def _refill(self, now_value):\n        now_value = float(now_value)\n        if not math.isfinite(now_value):\n            raise ValueError(\"clock must return a finite number\")\n        now = Fraction(now_value)\n        if now < self._time:\n            self._time = now\n            self._time_value = now_value\n            return\n        if now > self._time:\n            self._tokens = min(\n                self._capacity,\n                self._tokens + (now - self._time) * self._rate,\n            )\n            self._time = now\n            self._time_value = now_value\n\n    def _validate_request(self, n):\n        n = float(n)\n        if not math.isfinite(n) or not n > 0:\n            raise ValueError(\"n must be positive\")\n        n = Fraction(n)\n        if n > self._capacity:\n            raise ValueError(\"n cannot exceed capacity\")\n        return n\n\n    def try_acquire(self, n=1):\n        n = self._validate_request(n)\n        with self._lock:\n            self._refill(self._clock())\n            if self._tokens >= n:\n                self._tokens -= n\n                return True\n            return False\n\n    def wait_time(self, n=1):\n        n = self._validate_request(n)\n        with self._lock:\n            self._refill(self._clock())\n            if self._tokens >= n:\n                return 0.0\n\n            required = self._time + (n - self._tokens) / self._rate\n            try:\n                delay = float(required - self._time)\n            except OverflowError:\n                return math.inf\n            if not math.isfinite(delay):\n                return math.inf\n\n            target = self._time_value + delay\n            if not math.isfinite(target):\n                return math.inf\n            if target <= self._time_value:\n                target = math.nextafter(self._time_value, math.inf)\n                if not math.isfinite(target):\n                    return math.inf\n\n            for _ in range(128):\n                if target <= self._time_value:\n                    target = math.nextafter(self._time_value, math.inf)\n                    if not math.isfinite(target):\n                        return math.inf\n                elif Fraction(target) >= required:\n                    delay = target - self._time_value\n                    if delay <= 0.0:\n                        next_time = math.nextafter(self._time_value, math.inf)\n                        if not math.isfinite(next_time):\n                            return math.inf\n                        delay = next_time - self._time_value\n\n                    for _ in range(128):\n                        if delay <= 0.0:\n                            landed = math.nextafter(self._time_value, math.inf)\n                        else:\n                            landed = self._time_value + delay\n                        if landed <= self._time_value:\n                            landed = math.nextafter(self._time_value, math.inf)\n                        if not math.isfinite(landed):\n                            return math.inf\n                        if Fraction(landed) >= required:\n                            return delay\n                        delay = math.nextafter(delay, math.inf)\n                    return delay\n                else:\n                    target = math.nextafter(target, math.inf)\n                    if not math.isfinite(target):\n                        return math.inf\n\n            return delay","lineStart":1,"lineEnd":118,"totalLines":118,"truncated":false}},"title":"ledgerkit/limiter.py","time":{"start":1794049219561,"end":1794049219571}},"id":"prt_1b5aa997400186B06Aqs1K0I6R","sessionID":"ses_e4a6faf75ffeWknnGBCeXJ18Fc","messageID":"msg_1b5aa88e60013YJLZ8H7VPsV2B"}}
{"type":"tool_use","timestamp":1794049220309,"sessionID":"ses_e4a6faf75ffeWknnGBCeXJ18Fc","part":{"type":"tool","tool":"read","callID":"chatcmpl-tool-92bee0a0cb61d1d3","state":{"status":"completed","input":{"filePath":"/home/user/latte-crew/var/worktrees/1107-41e94c/tests/test_limiter.py"},"output":"<path>/home/user/latte-crew/var/worktrees/1107-41e94c/tests/test_limiter.py</path>\n<type>file</type>\n<content>\n1: import threading\n2: \n3: import pytest\n4: \n5: from ledgerkit.limiter import TokenBucket\n6: \n7: \n8: class FakeClock:\n9:     def __init__(self, start=0.0):\n10:         self.now = float(start)\n11: \n12:     def __call__(self):\n13:         return self.now\n14: \n15:     def advance(self, seconds):\n16:         self.now += float(seconds)\n17: \n18:     def set(self, seconds):\n19:         self.now = float(seconds)\n20: \n21: \n22: def test_constructor_rejects_non_positive_rate_or_capacity():\n23:     clock = FakeClock()\n24:     with pytest.raises(ValueError):\n25:         TokenBucket(rate=0, capacity=10, clock=clock)\n26:     with pytest.raises(ValueError):\n27:         TokenBucket(rate=-1, capacity=10, clock=clock)\n28:     with pytest.raises(ValueError):\n29:         TokenBucket(rate=1, capacity=0, clock=clock)\n30:     with pytest.raises(ValueError):\n31:         TokenBucket(rate=1, capacity=-10, clock=clock)\n32: \n33: \n34: def test_methods_reject_invalid_n():\n35:     bucket = TokenBucket(rate=1, capacity=10, clock=FakeClock())\n36:     for n in (0, -1, 11):\n37:         with pytest.raises(ValueError):\n38:             bucket.try_acquire(n)\n39:         with pytest.raises(ValueError):\n40:             bucket.wait_time(n)\n41: \n42: \n43: def test_starts_full():\n44:     bucket = TokenBucket(rate=1, capacity=5, clock=FakeClock())\n45:     assert bucket.try_acquire(5)\n46:     assert not bucket.try_acquire(1)\n47:     assert bucket.wait_time(1) == 1.0\n48: \n49: \n50: def test_default_n_is_one():\n51:     bucket = TokenBucket(rate=1, capacity=1, clock=FakeClock())\n52:     assert bucket.wait_time() == 0.0\n53:     assert bucket.try_acquire()\n54:     assert bucket.wait_time() == 1.0\n55:     assert not bucket.try_acquire()\n56: \n57: \n58: def test_basic_acquire_and_wait_time():\n59:     clock = FakeClock()\n60:     bucket = TokenBucket(rate=1, capacity=5, clock=clock)\n61:     assert bucket.try_acquire(3)\n62:     assert bucket.wait_time(3) == 1.0\n63:     clock.advance(1.0)\n64:     assert bucket.try_acquire(3)\n65:     assert not bucket.try_acquire(1)\n66: \n67: \n68: def test_wait_time_does_not_consume():\n69:     bucket = TokenBucket(rate=2, capacity=10, clock=FakeClock())\n70:     assert bucket.try_acquire(8)\n71:     assert bucket.wait_time(4) == 1.0\n72:     assert bucket.wait_time(4) == 1.0\n73:     assert bucket.try_acquire(2)\n74:     assert not bucket.try_acquire(2)\n75: \n76: \n77: def test_failed_try_acquire_does_not_consume():\n78:     bucket = TokenBucket(rate=1, capacity=5, clock=FakeClock())\n79:     assert bucket.try_acquire(3)\n80:     assert not bucket.try_acquire(3)\n81:     assert bucket.wait_time(3) == 1.0\n82:     assert bucket.try_acquire(2)\n83:     assert not bucket.try_acquire(1)\n84: \n85: \n86: def test_refill_is_capped():\n87:     clock = FakeClock()\n88:     bucket = TokenBucket(rate=10, capacity=5, clock=clock)\n89:     clock.advance(100)\n90:     assert bucket.wait_time(5) == 0.0\n91:     assert bucket.try_acquire(5)\n92:     assert not bucket.try_acquire(1)\n93: \n94: \n95: def test_backward_clock_does_not_refill():\n96:     clock = FakeClock(100.0)\n97:     bucket = TokenBucket(rate=1, capacity=10, clock=clock)\n98:     assert bucket.try_acquire(5)\n99:     clock.set(50.0)\n100:     assert bucket.wait_time(6) == 1.0\n101:     clock.advance(2.0)\n102:     assert bucket.wait_time(7) == 0.0\n103:     assert bucket.try_acquire(7)\n104:     assert not bucket.try_acquire(1)\n105: \n106: \n107: @pytest.mark.parametrize(\"rate\", [0.1, 3.0, 7.0])\n108: @pytest.mark.parametrize(\"capacity\", [1, 5, 100, 1000])\n109: def test_exact_affordability_after_wait_time(rate, capacity):\n110:     clock = FakeClock()\n111:     bucket = TokenBucket(rate=rate, capacity=capacity, clock=clock)\n112:     n_values = {1, capacity}\n113:     if capacity >= 4:\n114:         n_values.add(capacity // 2)\n115: \n116:     for n in sorted(n_values):\n117:         for _ in range(10_000):\n118:             wait = bucket.wait_time(n)\n119:             assert wait >= 0.0\n120:             clock.advance(wait)\n121:             assert bucket.try_acquire(n)\n122: \n123: \n124: def test_thread_safety_no_over_acquisition():\n125:     clock = FakeClock()\n126:     bucket = TokenBucket(rate=1000, capacity=100, clock=clock)\n127:     results = []\n128:     results_lock = threading.Lock()\n129: \n130:     def worker():\n131:         acquired = 0\n132:         for _ in range(1000):\n133:             if bucket.try_acquire(1):\n134:                 acquired += 1\n135:         with results_lock:\n136:             results.append(acquired)\n137: \n138:     threads = [threading.Thread(target=worker) for _ in range(10)]\n139:     for thread in threads:\n140:         thread.start()\n141:     for thread in threads:\n142:         thread.join()\n143: \n144:     assert sum(results) == 100\n\n(End of file - total 144 lines)\n</content>","metadata":{"preview":"import threading\n\nimport pytest\n\nfrom ledgerkit.limiter import TokenBucket\n\n\nclass FakeClock:\n    def __init__(self, start=0.0):\n        self.now = float(start)\n\n    def __call__(self):\n        return self.now\n\n    def advance(self, seconds):\n        self.now += float(seconds)\n\n    def set(self, seconds):\n        self.now = float(seconds)\n","truncated":false,"loaded":[],"display":{"type":"file","path":"/home/user/latte-crew/var/worktrees/1107-41e94c/tests/test_limiter.py","text":"import threading\n\nimport pytest\n\nfrom ledgerkit.limiter import TokenBucket\n\n\nclass FakeClock:\n    def __init__(self, start=0.0):\n        self.now = float(start)\n\n    def __call__(self):\n        return self.now\n\n    def advance(self, seconds):\n        self.now += float(seconds)\n\n    def set(self, seconds):\n        self.now = float(seconds)\n\n\ndef test_constructor_rejects_non_positive_rate_or_capacity():\n    clock = FakeClock()\n    with pytest.raises(ValueError):\n        TokenBucket(rate=0, capacity=10, clock=clock)\n    with pytest.raises(ValueError):\n        TokenBucket(rate=-1, capacity=10, clock=clock)\n    with pytest.raises(ValueError):\n        TokenBucket(rate=1, capacity=0, clock=clock)\n    with pytest.raises(ValueError):\n        TokenBucket(rate=1, capacity=-10, clock=clock)\n\n\ndef test_methods_reject_invalid_n():\n    bucket = TokenBucket(rate=1, capacity=10, clock=FakeClock())\n    for n in (0, -1, 11):\n        with pytest.raises(ValueError):\n            bucket.try_acquire(n)\n        with pytest.raises(ValueError):\n            bucket.wait_time(n)\n\n\ndef test_starts_full():\n    bucket = TokenBucket(rate=1, capacity=5, clock=FakeClock())\n    assert bucket.try_acquire(5)\n    assert not bucket.try_acquire(1)\n    assert bucket.wait_time(1) == 1.0\n\n\ndef test_default_n_is_one():\n    bucket = TokenBucket(rate=1, capacity=1, clock=FakeClock())\n    assert bucket.wait_time() == 0.0\n    assert bucket.try_acquire()\n    assert bucket.wait_time() == 1.0\n    assert not bucket.try_acquire()\n\n\ndef test_basic_acquire_and_wait_time():\n    clock = FakeClock()\n    bucket = TokenBucket(rate=1, capacity=5, clock=clock)\n    assert bucket.try_acquire(3)\n    assert bucket.wait_time(3) == 1.0\n    clock.advance(1.0)\n    assert bucket.try_acquire(3)\n    assert not bucket.try_acquire(1)\n\n\ndef test_wait_time_does_not_consume():\n    bucket = TokenBucket(rate=2, capacity=10, clock=FakeClock())\n    assert bucket.try_acquire(8)\n    assert bucket.wait_time(4) == 1.0\n    assert bucket.wait_time(4) == 1.0\n    assert bucket.try_acquire(2)\n    assert not bucket.try_acquire(2)\n\n\ndef test_failed_try_acquire_does_not_consume():\n    bucket = TokenBucket(rate=1, capacity=5, clock=FakeClock())\n    assert bucket.try_acquire(3)\n    assert not bucket.try_acquire(3)\n    assert bucket.wait_time(3) == 1.0\n    assert bucket.try_acquire(2)\n    assert not bucket.try_acquire(1)\n\n\ndef test_refill_is_capped():\n    clock = FakeClock()\n    bucket = TokenBucket(rate=10, capacity=5, clock=clock)\n    clock.advance(100)\n    assert bucket.wait_time(5) == 0.0\n    assert bucket.try_acquire(5)\n    assert not bucket.try_acquire(1)\n\n\ndef test_backward_clock_does_not_refill():\n    clock = FakeClock(100.0)\n    bucket = TokenBucket(rate=1, capacity=10, clock=clock)\n    assert bucket.try_acquire(5)\n    clock.set(50.0)\n    assert bucket.wait_time(6) == 1.0\n    clock.advance(2.0)\n    assert bucket.wait_time(7) == 0.0\n    assert bucket.try_acquire(7)\n    assert not bucket.try_acquire(1)\n\n\n@pytest.mark.parametrize(\"rate\", [0.1, 3.0, 7.0])\n@pytest.mark.parametrize(\"capacity\", [1, 5, 100, 1000])\ndef test_exact_affordability_after_wait_time(rate, capacity):\n    clock = FakeClock()\n    bucket = TokenBucket(rate=rate, capacity=capacity, clock=clock)\n    n_values = {1, capacity}\n    if capacity >= 4:\n        n_values.add(capacity // 2)\n\n    for n in sorted(n_values):\n        for _ in range(10_000):\n            wait = bucket.wait_time(n)\n            assert wait >= 0.0\n            clock.advance(wait)\n            assert bucket.try_acquire(n)\n\n\ndef test_thread_safety_no_over_acquisition():\n    clock = FakeClock()\n    bucket = TokenBucket(rate=1000, capacity=100, clock=clock)\n    results = []\n    results_lock = threading.Lock()\n\n    def worker():\n        acquired = 0\n        for _ in range(1000):\n            if bucket.try_acquire(1):\n                acquired += 1\n        with results_lock:\n            results.append(acquired)\n\n    threads = [threading.Thread(target=worker) for _ in range(10)]\n    for thread in threads:\n        thread.start()\n    for thread in threads:\n        thread.join()\n\n    assert sum(results) == 100","lineStart":1,"lineEnd":144,"totalLines":144,"truncated":false}},"title":"tests/test_limiter.py","time":{"start":1794049220298,"end":1794049220307}},"id":"prt_1b5aa9c6f001NlpHFSzAFi38nS","sessionID":"ses_e4a6faf75ffeWknnGBCeXJ18Fc","messageID":"msg_1b5aa88e60013YJLZ8H7VPsV2B"}}
