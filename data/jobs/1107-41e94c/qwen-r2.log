      self.now = float(start)\n\n    def __call__(self):\n        return self.now\n\n    def advance(self, seconds):\n        self.now += float(seconds)\n\n    def set(self, seconds):\n        self.now = float(seconds)\n\n\ndef test_constructor_rejects_non_positive_rate_or_capacity():\n    clock = FakeClock()\n    with pytest.raises(ValueError):\n        TokenBucket(rate=0, capacity=10, clock=clock)\n    with pytest.raises(ValueError):\n        TokenBucket(rate=-1, capacity=10, clock=clock)\n    with pytest.raises(ValueError):\n        TokenBucket(rate=1, capacity=0, clock=clock)\n    with pytest.raises(ValueError):\n        TokenBucket(rate=1, capacity=-10, clock=clock)\n\n\ndef test_methods_reject_invalid_n():\n    bucket = TokenBucket(rate=1, capacity=10, clock=FakeClock())\n    for n in (0, -1, 11):\n        with pytest.raises(ValueError):\n            bucket.try_acquire(n)\n        with pytest.raises(ValueError):\n            bucket.wait_time(n)\n\n\ndef test_starts_full():\n    bucket = TokenBucket(rate=1, capacity=5, clock=FakeClock())\n    assert bucket.try_acquire(5)\n    assert not bucket.try_acquire(1)\n    assert bucket.wait_time(1) == 1.0\n\n\ndef test_default_n_is_one():\n    bucket = TokenBucket(rate=1, capacity=1, clock=FakeClock())\n    assert bucket.wait_time() == 0.0\n    assert bucket.try_acquire()\n    assert bucket.wait_time() == 1.0\n    assert not bucket.try_acquire()\n\n\ndef test_basic_acquire_and_wait_time():\n    clock = FakeClock()\n    bucket = TokenBucket(rate=1, capacity=5, clock=clock)\n    assert bucket.try_acquire(3)\n    assert bucket.wait_time(3) == 1.0\n    clock.advance(1.0)\n    assert bucket.try_acquire(3)\n    assert not bucket.try_acquire(1)\n\n\ndef test_wait_time_does_not_consume():\n    bucket = TokenBucket(rate=2, capacity=10, clock=FakeClock())\n    assert bucket.try_acquire(8)\n    assert bucket.wait_time(4) == 1.0\n    assert bucket.wait_time(4) == 1.0\n    assert bucket.try_acquire(2)\n    assert not bucket.try_acquire(2)\n\n\ndef test_failed_try_acquire_does_not_consume():\n    bucket = TokenBucket(rate=1, capacity=5, clock=FakeClock())\n    assert bucket.try_acquire(3)\n    assert not bucket.try_acquire(3)\n    assert bucket.wait_time(3) == 1.0\n    assert bucket.try_acquire(2)\n    assert not bucket.try_acquire(1)\n\n\ndef test_refill_is_capped():\n    clock = FakeClock()\n    bucket = TokenBucket(rate=10, capacity=5, clock=clock)\n    clock.advance(100)\n    assert bucket.wait_time(5) == 0.0\n    assert bucket.try_acquire(5)\n    assert not bucket.try_acquire(1)\n\n\ndef test_backward_clock_does_not_refill():\n    clock = FakeClock(100.0)\n    bucket = TokenBucket(rate=1, capacity=10, clock=clock)\n    assert bucket.try_acquire(5)\n    clock.set(50.0)\n    assert bucket.wait_time(6) == 1.0\n    clock.advance(2.0)\n    assert bucket.wait_time(7) == 0.0\n    assert bucket.try_acquire(7)\n    assert not bucket.try_acquire(1)\n\n\n@pytest.mark.parametrize(\"rate\", [0.1, 3.0, 7.0])\n@pytest.mark.parametrize(\"capacity\", [1, 5, 100, 1000])\ndef test_exact_affordability_after_wait_time(rate, capacity):\n    clock = FakeClock()\n    bucket = TokenBucket(rate=rate, capacity=capacity, clock=clock)\n    n_values = {1, capacity}\n    if capacity >= 4:\n        n_values.add(capacity // 2)\n\n    for n in sorted(n_values):\n        for _ in range(10_000):\n            wait = bucket.wait_time(n)\n            assert wait >= 0.0\n            clock.advance(wait)\n            assert bucket.try_acquire(n)\n\n\ndef test_thread_safety_no_over_acquisition():\n    clock = FakeClock()\n    bucket = TokenBucket(rate=1000, capacity=100, clock=clock)\n    results = []\n    results_lock = threading.Lock()\n\n    def worker():\n        acquired = 0\n        for _ in range(1000):\n            if bucket.try_acquire(1):\n                acquired += 1\n        with results_lock:\n            results.append(acquired)\n\n    threads = [threading.Thread(target=worker) for _ in range(10)]\n    for thread in threads:\n        thread.start()\n    for thread in threads:\n        thread.join()\n\n    assert sum(results) == 100","lineStart":1,"lineEnd":144,"totalLines":144,"truncated":false}},"title":"tests/test_limiter.py","time":{"start":1794049006169,"end":1794049006179}},"id":"prt_1b5a757ef001MQYdAyNoo6jNwU","sessionID":"ses_e4a6faf75ffeWknnGBCeXJ18Fc","messageID":"msg_1b5a745380014m5wON6IlioFGW"}}
