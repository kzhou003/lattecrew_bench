me) * self._rate,\n        )\n        self._time = now\n\n    def _validate_request(self, n):\n        n = float(n)\n        if not n > 0:\n            raise ValueError(\"n must be positive\")\n        if n > self._capacity:\n            raise ValueError(\"n cannot exceed capacity\")\n        return n\n\n    def try_acquire(self, n=1):\n        n = self._validate_request(n)\n        with self._lock:\n            self._refill(self._clock())\n            if self._tokens + self._tolerance >= n:\n                self._tokens = max(0.0, self._tokens - n)\n                return True\n            return False\n\n    def wait_time(self, n=1):\n        n = self._validate_request(n)\n        with self._lock:\n            self._refill(self._clock())\n            if self._tokens + self._tolerance >= n:\n                return 0.0\n            return (n - self._tokens) / self._rate","lineStart":1,"lineEnd":59,"totalLines":59,"truncated":false}},"title":"ledgerkit/limiter.py","time":{"start":1794049005416,"end":1794049005431}},"id":"prt_1b5a754e4001Q5KZrdllVbjbGs","sessionID":"ses_e4a6faf75ffeWknnGBCeXJ18Fc","messageID":"msg_1b5a745380014m5wON6IlioFGW"}}
