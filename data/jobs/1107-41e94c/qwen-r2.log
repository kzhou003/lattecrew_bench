{"type":"tool_use","timestamp":1794049182164,"sessionID":"ses_e4a6faf75ffeWknnGBCeXJ18Fc","part":{"type":"tool","tool":"write","callID":"chatcmpl-tool-8e20336bcadb8fca","state":{"status":"completed","input":{"filePath":"/home/user/latte-crew/var/worktrees/1107-41e94c/ledgerkit/limiter.py","content":"\"\"\"Thread-safe token bucket rate limiter.\"\"\"\n\nimport math\nimport threading\nimport time\nfrom fractions import Fraction\n\n\nclass TokenBucket:\n    def __init__(self, rate, capacity, clock=time.monotonic):\n        rate = float(rate)\n        capacity = float(capacity)\n        if not math.isfinite(rate) or not rate > 0:\n            raise ValueError(\"rate must be positive\")\n        if not math.isfinite(capacity) or not capacity > 0:\n            raise ValueError(\"capacity must be positive\")\n\n        self._rate = Fraction(rate)\n        self._capacity = Fraction(capacity)\n        self._clock = clock\n        self._tokens = self._capacity\n        now = float(clock())\n        if not math.isfinite(now):\n            raise ValueError(\"clock must return a finite number\")\n        self._time = Fraction(now)\n        self._time_value = now\n        self._lock = threading.Lock()\n\n    def _refill(self, now_value):\n        now_value = float(now_value)\n        if not math.isfinite(now_value):\n            raise ValueError(\"clock must return a finite number\")\n        now = Fraction(now_value)\n        if now < self._time:\n            self._time = now\n            self._time_value = now_value\n            return\n        if now > self._time:\n            self._tokens = min(\n                self._capacity,\n                self._tokens + (now - self._time) * self._rate,\n            )\n            self._time = now\n            self._time_value = now_value\n\n    def _validate_request(self, n):\n        n = float(n)\n        if not math.isfinite(n) or not n > 0:\n            raise ValueError(\"n must be positive\")\n        n = Fraction(n)\n        if n > self._capacity:\n            raise ValueError(\"n cannot exceed capacity\")\n        return n\n\n    def try_acquire(self, n=1):\n        n = self._validate_request(n)\n        with self._lock:\n            self._refill(self._clock())\n            if self._tokens >= n:\n                self._tokens -= n\n                return True\n            return False\n\n    def wait_time(self, n=1):\n        n = self._validate_request(n)\n        with self._lock:\n            self._refill(self._clock())\n            if self._tokens >= n:\n                return 0.0\n\n            required = self._time + (n - self._tokens) / self._rate\n            try:\n                delay = float(required - self._time)\n            except OverflowError:\n                return math.inf\n            if not math.isfinite(delay):\n                return math.inf\n\n            target = self._time_value + delay\n            if not math.isfinite(target):\n                return math.inf\n            if target <= self._time_value:\n                target = math.nextafter(self._time_value, math.inf)\n                if not math.isfinite(target):\n                    return math.inf\n\n            for _ in range(128):\n                if target <= self._time_value:\n                    target = math.nextafter(self._time_value, math.inf)\n                    if not math.isfinite(target):\n                        return math.inf\n                elif Fraction(target) >= required:\n                    delay = target - self._time_value\n                    if delay <= 0.0:\n                        next_time = math.nextafter(self._time_value, math.inf)\n                        if not math.isfinite(next_time):\n                            return math.inf\n                        delay = next_time - self._time_value\n\n                    for _ in range(128):\n                        if delay <= 0.0:\n                            landed = math.nextafter(self._time_value, math.inf)\n                        else:\n                            landed = self._time_value + delay\n                        if landed <= self._time_value:\n                            landed = math.nextafter(self._time_value, math.inf)\n                        if not math.isfinite(landed):\n                            return math.inf\n                        if Fraction(landed) >= required:\n                            return delay\n                        delay = math.nextafter(delay, math.inf)\n                    return delay\n                else:\n                    target = math.nextafter(target, math.inf)\n                    if not math.isfinite(target):\n                        return math.inf\n\n            return delay\n"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/home/user/latte-crew/var/worktrees/1107-41e94c/ledgerkit/limiter.py","exists":true,"truncated":false},"title":"ledgerkit/limiter.py","time":{"start":1794049182152,"end":1794049182162}},"id":"prt_1b5a9d20a0015GCxRzsgQR4ulK","sessionID":"ses_e4a6faf75ffeWknnGBCeXJ18Fc","messageID":"msg_1b5a75e9a0015B3bx4nz94R5zW"}}
