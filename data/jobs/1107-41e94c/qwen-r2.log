{"type":"tool_use","timestamp":1794048843249,"sessionID":"ses_e4a6faf75ffeWknnGBCeXJ18Fc","part":{"type":"tool","tool":"bash","callID":"chatcmpl-tool-9b32dc5b3473e548","state":{"status":"completed","input":{"command":"python3 - <<'EOF'\nimport math, threading, time\nfrom fractions import Fraction\n\nclass TokenBucket:\n    def __init__(self, rate, capacity, clock=time.monotonic):\n        rate = float(rate)\n        capacity = float(capacity)\n        if not (math.isfinite(rate) and rate > 0):\n            raise ValueError(\"rate must be positive\")\n        if not (math.isfinite(capacity) and capacity > 0):\n            raise ValueError(\"capacity must be positive\")\n        self._rate = Fraction(rate)\n        self._capacity = Fraction(capacity)\n        self._clock = clock\n        self._tokens = capacity\n        now = clock()\n        self._time = Fraction(now)\n        self._time_value = now\n        self._lock = threading.Lock()\n\n    def _validate_request(self, n):\n        try:\n            n_float = float(n)\n        except (TypeError, ValueError, OverflowError) as exc:\n            raise ValueError(\"n must be positive\") from exc\n        if not (math.isfinite(n_float) and n_float > 0):\n            raise ValueError(\"n must be positive\")\n        if n_float > float(self._capacity):\n            raise ValueError(\"n cannot exceed capacity\")\n        return Fraction(n_float)\n\n    def _refill(self, now):\n        now_frac = Fraction(now)\n        if now_frac < self._time:\n            self._time = now_frac\n            self._time_value = now\n        elif now_frac > self._time:\n            self._tokens = min(\n                self._capacity,\n                self._tokens + (now_frac - self._time) * self._rate,\n            )\n            self._time = now_frac\n            self._time_value = now\n\n    def try_acquire(self, n=1):\n        n = self._validate_request(n)\n        with self._lock:\n            self._refill(self._clock())\n            if self._tokens >= n:\n                self._tokens -= n\n                return True\n            return False\n\n    def wait_time(self, n=1):\n        n = self._validate_request(n)\n        with self._lock:\n            self._refill(self._clock())\n            if self._tokens >= n:\n                return 0.0\n            delta = (n - self._tokens) / self._rate\n            w = float(delta)\n            if w <= 0.0:\n                w = math.nextafter(0.0, math.inf)\n            for _ in range(64):\n                candidate = self._time_value + w\n                if candidate <= self._time_value:\n                    candidate = math.nextafter(self._time_value, math.inf)\n                    w = candidate - self._time_value\n                    continue\n                if self._tokens + (Fraction(candidate) - self._time) * self._rate >= n:\n                    return w\n                w = math.nextafter(w, math.inf)\n            return w\n\nclass FakeClock:\n    def __init__(self, start=0.0): self.now=float(start)\n    def __call__(self): return self.now\n    def advance(self, s): self.now += float(s)\n    def set(self, s): self.now=float(s)\n\n# large capacity bug\nc=FakeClock(); b=TokenBucket(1, 10**6, c)\nprint(b.try_acquire(10**6), b.try_acquire(1), b.try_acquire(1), b.wait_time(1))\nc=FakeClock(); b=TokenBucket(1, 10**7, c)\nb.try_acquire(10**7)\nprint(sum(b.try_acquire(1) for _ in range(100)), b.wait_time(1))\n\n# cycle\nfor rate in [0.1,3.0,7.0]:\n  for cap in [1,5,100,1000]:\n    c=FakeClock(); b=TokenBucket(rate, cap, c)\n    n_values={1, cap}\n    if cap>=4: n_values.add(cap//2)\n    t0=time.perf_counter()\n    for n in sorted(n_values):\n      for _ in range(10000):\n        w=b.wait_time(n)\n        assert w>=0\n        c.advance(w)\n        assert b.try_acquire(n), (rate,cap,n)\n    print('cycle', rate, cap, time.perf_counter()-t0)\n\n# thread large\nc=FakeClock(); b=TokenBucket(1000, 1000000, c)\nres=[]; lock=threading.Lock()\ndef worker():\n  a=0\n  for _ in range(1000):\n    if b.try_acquire(1): a+=1\n  with lock: res.append(a)\nthreads=[threading.Thread(target=worker) for _ in range(10)]\nfor t in threads: t.start()\nfor t in threads: t.join()\nprint('thread total', sum(res))\nEOF","workdir":"/home/user/latte-crew/var/worktrees/1107-41e94c","timeout":120000},"output":"True False False 1.0\n0 1.0\ncycle 0.1 1 0.17322816100204363\ncycle 0.1 5 0.4275523539981805\ncycle 0.1 100 0.42990316898794845\ncycle 0.1 1000 0.4274891170207411\nTraceback (most recent call last):\n  File \"<stdin>\", line 100, in <module>\nAssertionError: (3.0, 1, 1)\n","metadata":{"output":"True False False 1.0\n0 1.0\ncycle 0.1 1 0.17322816100204363\ncycle 0.1 5 0.4275523539981805\ncycle 0.1 100 0.42990316898794845\ncycle 0.1 1000 0.4274891170207411\nTraceback (most recent call last):\n  File \"<stdin>\", line 100, in <module>\nAssertionError: (3.0, 1, 1)\n","exit":1,"truncated":false},"title":"python3 - <<'EOF'\nimport math, threading, time\nfrom fractions import Fraction\n\nclass TokenBucket:\n    def __init__(self, rate, capacity, clock=time.monotonic):\n        rate = float(rate)\n        capacity = float(capacity)\n        if not (math.isfinite(rate) and rate > 0):\n            raise ValueError(\"rate must be positive\")\n        if not (math.isfinite(capacity) and capacity > 0):\n            raise ValueError(\"capacity must be positive\")\n        self._rate = Fraction(rate)\n        self._capacity = Fraction(capacity)\n        self._clock = clock\n        self._tokens = capacity\n        now = clock()\n        self._time = Fraction(now)\n        self._time_value = now\n        self._lock = threading.Lock()\n\n    def _validate_request(self, n):\n        try:\n            n_float = float(n)\n        except (TypeError, ValueError, OverflowError) as exc:\n            raise ValueError(\"n must be positive\") from exc\n        if not (math.isfinite(n_float) and n_float > 0):\n            raise ValueError(\"n must be positive\")\n        if n_float > float(self._capacity):\n            raise ValueError(\"n cannot exceed capacity\")\n        return Fraction(n_float)\n\n    def _refill(self, now):\n        now_frac = Fraction(now)\n        if now_frac < self._time:\n            self._time = now_frac\n            self._time_value = now\n        elif now_frac > self._time:\n            self._tokens = min(\n                self._capacity,\n                self._tokens + (now_frac - self._time) * self._rate,\n            )\n            self._time = now_frac\n            self._time_value = now\n\n    def try_acquire(self, n=1):\n        n = self._validate_request(n)\n        with self._lock:\n            self._refill(self._clock())\n            if self._tokens >= n:\n                self._tokens -= n\n                return True\n            return False\n\n    def wait_time(self, n=1):\n        n = self._validate_request(n)\n        with self._lock:\n            self._refill(self._clock())\n            if self._tokens >= n:\n                return 0.0\n            delta = (n - self._tokens) / self._rate\n            w = float(delta)\n            if w <= 0.0:\n                w = math.nextafter(0.0, math.inf)\n            for _ in range(64):\n                candidate = self._time_value + w\n                if candidate <= self._time_value:\n                    candidate = math.nextafter(self._time_value, math.inf)\n                    w = candidate - self._time_value\n                    continue\n                if self._tokens + (Fraction(candidate) - self._time) * self._rate >= n:\n                    return w\n                w = math.nextafter(w, math.inf)\n            return w\n\nclass FakeClock:\n    def __init__(self, start=0.0): self.now=float(start)\n    def __call__(self): return self.now\n    def advance(self, s): self.now += float(s)\n    def set(self, s): self.now=float(s)\n\n# large capacity bug\nc=FakeClock(); b=TokenBucket(1, 10**6, c)\nprint(b.try_acquire(10**6), b.try_acquire(1), b.try_acquire(1), b.wait_time(1))\nc=FakeClock(); b=TokenBucket(1, 10**7, c)\nb.try_acquire(10**7)\nprint(sum(b.try_acquire(1) for _ in range(100)), b.wait_time(1))\n\n# cycle\nfor rate in [0.1,3.0,7.0]:\n  for cap in [1,5,100,1000]:\n    c=FakeClock(); b=TokenBucket(rate, cap, c)\n    n_values={1, cap}\n    if cap>=4: n_values.add(cap//2)\n    t0=time.perf_counter()\n    for n in sorted(n_values):\n      for _ in range(10000):\n        w=b.wait_time(n)\n        assert w>=0\n        c.advance(w)\n        assert b.try_acquire(n), (rate,cap,n)\n    print('cycle', rate, cap, time.perf_counter()-t0)\n\n# thread large\nc=FakeClock(); b=TokenBucket(1000, 1000000, c)\nres=[]; lock=threading.Lock()\ndef worker():\n  a=0\n  for _ in range(1000):\n    if b.try_acquire(1): a+=1\n  with lock: res.append(a)\nthreads=[threading.Thread(target=worker) for _ in range(10)]\nfor t in threads: t.start()\nfor t in threads: t.join()\nprint('thread total', sum(res))\nEOF","time":{"start":1794048841567,"end":1794048843245}},"id":"prt_1b5a495440016WclHezr6ZU6Pz","sessionID":"ses_e4a6faf75ffeWknnGBCeXJ18Fc","messageID":"msg_1b5a2ac2e001Y1hXYjxV5GKHgw"}}
