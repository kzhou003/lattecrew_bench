{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01NNNhkDRLCvEwuAo4TLqgHW","type":"tool_result","content":" ledgerkit/limiter.py  |  59 +++++++++++++++++++++\n tests/test_limiter.py | 144 ++++++++++++++++++++++++++++++++++++++++++++++++++\n 2 files changed, 203 insertions(+)\n\"\"\"Thread-safe token bucket rate limiter.\"\"\"\n\nimport threading\nimport time\n\n_EPS = 1e-6\n\n\nclass TokenBucket:\n    def __init__(self, rate, capacity, clock=time.monotonic):\n        rate = float(rate)\n        capacity = float(capacity)\n        if not rate > 0:\n            raise ValueError(\"rate must be positive\")\n        if not capacity > 0:\n            raise ValueError(\"capacity must be positive\")\n\n        self._rate = rate\n        self._capacity = capacity\n        self._clock = clock\n        self._tokens = capacity\n        self._time = clock()\n        self._tolerance = _EPS * capacity\n        self._lock = threading.Lock()\n\n    def _refill(self, now):\n        if now < self._time:\n            self._time = now\n            return\n        self._tokens = min(\n            self._capacity,\n            self._tokens + (now - self._time) * self._rate,\n        )\n        self._time = now\n\n    def _validate_request(self, n):\n        n = float(n)\n        if not n > 0:\n            raise ValueError(\"n must be positive\")\n        if n > self._capacity:\n            raise ValueError(\"n cannot exceed capacity\")\n        return n\n\n    def try_acquire(self, n=1):\n        n = self._validate_request(n)\n        with self._lock:\n            self._refill(self._clock())\n            if self._tokens + self._tolerance >= n:\n                self._tokens = max(0.0, self._tokens - n)\n                return True\n            return False\n\n    def wait_time(self, n=1):\n        n = self._validate_request(n)\n        with self._lock:\n            self._refill(self._clock())\n            if self._tokens + self._tolerance >= n:\n                retur