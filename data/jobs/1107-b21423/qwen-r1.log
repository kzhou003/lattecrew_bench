{"type":"tool_use","timestamp":1794040701835,"sessionID":"ses_e4ad92dc5ffe76UDhNmswPDcSE","part":{"type":"tool","tool":"write","callID":"chatcmpl-tool-b5369fc4be6bcfed","state":{"status":"completed","input":{"filePath":"/home/user/latte-crew/var/worktrees/1107-b21423/tests/test_money.py","content":"import random\n\nimport pytest\n\nfrom ledgerkit.money import split\n\n\ndef test_even_split():\n    assert split(100, [1, 1]) == [50, 50]\n\n\ndef test_three_way_split_largest_remainder():\n    # 100/3 = 33.33...: floors are [33, 33, 33], all remainders tie at 1/3,\n    # so the lowest index gets the extra cent.\n    assert split(100, [1, 1, 1]) == [34, 33, 33]\n\n\ndef test_proportional_split():\n    # Exact shares: 16.667, 33.333, 50.\n    assert split(100, [1, 2, 3]) == [17, 33, 50]\n\n\ndef test_largest_remainder_wins_over_lower_index():\n    # Exact shares of 10 with weights [1, 2]: 3.333 and 6.667.\n    # Floors [3, 6], remainders 1/3 and 2/3 -> index 1 gets the leftover.\n    assert split(10, [1, 2]) == [3, 7]\n\n\ndef test_tie_broken_by_lower_index():\n    # Exact shares of 20 with weights [1, 2]: 6.667 and 13.333.\n    # Floors [6, 13], remainders 2/3 and 1/3 -> index 0 gets the leftover.\n    assert split(20, [1, 2]) == [7, 13]\n\n\ndef test_zero_total():\n    assert split(0, [1, 2, 3]) == [0, 0, 0]\n\n\ndef test_single_party():\n    assert split(500, [7]) == [500]\n\n\ndef test_negative_total_splits_absolute_value_negated():\n    assert split(-100, [1, 1, 1]) == [-34, -33, -33]\n    assert split(-10, [1, 2]) == [-3, -7]\n\n\ndef test_uneven_weights_exhaustive_sum():\n    result = split(1000, [1, 1, 2, 3, 5])\n    assert sum(result) == 1000\n\n\ndef test_exact_integers_no_float_error():\n    # Large values that a float-based approach would round incorrectly.\n    total = 10**18 + 1\n    weights = [3, 3, 1]\n    result = split(total, weights)\n    assert all(isinstance(x, int) for x in result)\n    assert sum(result) == total\n\n\ndef test_property_sums_exactly():\n    rng = random.Random(42)\n    for _ in range(200):\n        total = rng.randint(-10_000, 10_000)\n        n = rng.randint(1, 8)\n        weights = [rng.randint(0, 50) for _ in range(n)]\n        if sum(weights) == 0:\n            continue\n        result = split(total, weights)\n        assert sum(result) == total\n\n\ndef test_empty_weights_raises():\n    with pytest.raises(ValueError):\n        split(100, [])\n\n\ndef test_negative_weight_raises():\n    with pytest.raises(ValueError):\n        split(100, [1, -2])\n\n\ndef test_all_zero_weights_raise():\n    with pytest.raises(ValueError):\n        split(100, [0, 0])\n"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/home/user/latte-crew/var/worktrees/1107-b21423/tests/test_money.py","exists":true,"truncated":false},"title":"tests/test_money.py","time":{"start":1794040701829,"end":1794040701833}},"id":"prt_1b52872be001NNW9oBDCO6xRUf","sessionID":"ses_e4ad92dc5ffe76UDhNmswPDcSE","messageID":"msg_1b5286ed5001EejyQNnnThIPcU"}}
