{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01S94xnZwkJm7ACqRtrBVviX","type":"tool_result","content":"diff --git a/ledgerkit/money.py b/ledgerkit/money.py\nindex 583519c..0caf59e 100644\n--- a/ledgerkit/money.py\n+++ b/ledgerkit/money.py\n@@ -1,4 +1,29 @@\n def split(total_cents, weights):\n-    \"\"\"Split an amount between parties in proportion to their weights.\"\"\"\n-    s = sum(weights)\n-    return [round(total_cents * w / s) for w in weights]\n+    \"\"\"Split an amount between parties in proportion to their weights.\n+\n+    Uses the largest remainder method with exact integer arithmetic:\n+    each party receives the floor of its exact share, and the leftover\n+    cents are handed out one at a time to the parties with the largest\n+    fractional remainders, breaking ties by the lower index.\n+    \"\"\"\n+    weights = list(weights)\n+    if not weights:\n+        raise ValueError(\"weights must not be empty\")\n+    if any(w < 0 for w in weights):\n+        raise ValueError(\"weights must be non-negative\")\n+    total_weight = sum(weights)\n+    if total_weight == 0:\n+        raise ValueError(\"weights must not all be zero\")\n+\n+    if total_cents < 0:\n+        return [-x for x in split(-total_cents, weights)]\n+\n+    numerators = [total_cents * w for w in weights]\n+    shares = [n // total_weight for n in numerators]\n+    remainders = [n % total_weight for n in numerators]\n+    leftover = total_cents - sum(shares)\n+    for i in sorted(\n+        range(len(weights)), key=lambda i: (-remainders[i], i)\n+    )[:leftover]:\n+        shares[i] += 1\n+    return shares\ndiff --git a/tests/test_money.py b/tests/test_money.py\nindex a14c927..bdf6390 100644\n--- a/tests/test_money.py\n+++ b/tests/test_money.py\n@@ -1,5 +1,86 @@\n+import random\n+\n+import pytest\n+\n from ledgerkit.money import split\n \n \n def test_even_split():\n     assert split(100, [1, 1]) == [50, 50]\n+\n+\n+def test_three_way_split_largest_remainder():\n+    # 100/3 = 33.33...: floors are [33, 33, 33], all remainders tie at 1/3,\n+    # so the lowest index gets the extra cent.\n+    assert split(100, [1, 1, 1]) == [34, 33, 33]\n+\n+\n+def test_proportional_split():\n+    # Exact shares: 16.667, 33.333, 50.\n+    assert split(100, [1, 2, 3]) == [17, 33, 50]\n+\n+\n+def test_largest_remainder_wins_over_lower_index():\n+    # Exact shares of 10 with weights [1, 2]: 3.333 and 6.667.\n+    # Floors [3, 6], remainders 1/3 and 2/3 -> index 1 gets the leftover.\n+    assert split(10, [1, 2]) == [3, 7]\n+\n+\n+def test_tie_broken_by_lower_index():\n+    # Exact shares of 20 with weights [1, 2]: 6.667 and 13.333.\n+    # Floors [6, 13], remainders 2/3 and 1/3 -> index 0 gets the leftover.\n+    assert split(20, [1, 2]) == [7, 13]\n+\n+\n+def test_zero_total():\n+    assert split(0, [1, 2, 3]) == [0, 0, 0]\n+\n+\n+def test_single_party():\n+    assert split(500, [7]) == [500]\n+\n+\n+def test_negative_total_splits_absolute_value_negated():\n+    assert split(-100, [1, 1, 1]) == [-34, -33, -33]\n+    assert split(-10, [1, 2]) == [-3, -7]\n+\n+\n+def test_uneven_weights_exhaustive_sum():\n+    result = split(1000, [1, 1, 2, 3, 5])\n+    assert sum(result) == 1000\n+\n+\n+def test_exact_integers_no_float_error():\n+    # Large values that a float-based approach would round incorrectly.\n+    total = 10**18 + 1\n+    weights = [3, 3, 1]\n+    result = split(total, weights)\n+    assert all(isinstance(x, int) for x in result)\n+    assert sum(result) == total\n+\n+\n+def test_property_sums_exactly():\n+    rng = random.Random(42)\n+    for _ in range(200):\n+        total = rng.randint(-10_000, 10_000)\n+        n = rng.randint(1, 8)\n+        weights = [rng.randint(0, 50) for _ in range(n)]\n+        if sum(weights) == 0:\n+            continue\n+        result = split(total, weights)\n+        assert sum(result) == total\n+\n+\n+def test_empty_weights_raises():\n+    with pytest.raises(ValueError):\n+        split(100, [])