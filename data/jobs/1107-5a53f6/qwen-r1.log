{"type":"tool_use","timestamp":1794053085682,"sessionID":"ses_e4a1d8700ffefFzRkM6prJ0N1i","part":{"type":"tool","tool":"write","callID":"chatcmpl-tool-bb31e0aea7ad36fa","state":{"status":"completed","input":{"content":"import pytest\n\nfrom ledgerkit.csvstream import CsvStream\n\n\ndef parse(source, chunks=None, delimiter=\",\"):\n    stream = CsvStream(delimiter=delimiter)\n    rows = []\n    for chunk in (chunks if chunks is not None else [source]):\n        rows.extend(stream.feed(chunk))\n    rows.extend(stream.finish())\n    return rows\n\n\ndef all_chunkings(source, boundaries):\n    yield [source]\n    for i in range(1, len(source)):\n        yield [source[:i], source[i:]]\n    yield list(source)\n    points = sorted({0, len(source)} | set(boundaries))\n    yield [source[a:b] for a, b in zip(points, points[1:])]\n\n\nclass TestBasics:\n    def test_simple_rows(self):\n        assert parse(\"a,b\\n1,2\\n\") == [[\"a\", \"b\"], [\"1\", \"2\"]]\n\n    def test_multiple_records_from_one_feed(self):\n        stream = CsvStream()\n        assert stream.feed(\"x,y\\nz,w\\n\") == [[\"x\", \"y\"], [\"z\", \"w\"]]\n        assert stream.finish() == []\n\n    def test_partial_record_held_until_terminated(self):\n        stream = CsvStream()\n        assert stream.feed(\"a,b\") == []\n        assert stream.feed(\"\\n\") == [[\"a\", \"b\"]]\n        assert stream.finish() == []\n\n    def test_empty_middle_field(self):\n        assert parse(\"a,,b\\n\") == [[\"a\", \"\", \"b\"]]\n\n    def test_leading_delimiter(self):\n        assert parse(\",b\\n\") == [[\"\", \"b\"]]\n\n    def test_delimiter_only_line(self):\n        assert parse(\",\\n\") == [[\"\", \"\"]]\n\n    def test_trailing_delimiter_gives_trailing_empty_field(self):\n        assert parse(\"a,\") == [[\"a\", \"\"]]\n        assert parse(\"a,\\n\") == [[\"a\", \"\"]]\n\n    def test_unterminated_final_record_returned_by_finish(self):\n        stream = CsvStream()\n        assert stream.feed(\"last,one\") == []\n        assert stream.finish() == [[\"last\", \"one\"]]\n\n\nclass TestLineEndings:\n    def test_lf(self):\n        assert parse(\"a\\nb\\n\") == [[\"a\"], [\"b\"]]\n\n    def test_crlf(self):\n        assert parse(\"a\\r\\nb\\r\\n\") == [[\"a\"], [\"b\"]]\n\n    def test_lone_cr(self):\n        assert parse(\"a\\rb\\r\") == [[\"a\"], [\"b\"]]\n\n    def test_mixed_endings(self):\n        assert parse(\"a\\nb\\rc\\r\\nd\") == [[\"a\"], [\"b\"], [\"c\"], [\"d\"]]\n\n    def test_crlf_split_across_chunks(self):\n        assert parse(\"a\\r\\nb\\r\\n\", [\"a\\r\", \"\\nb\\r\", \"\\n\"]) == [[\"a\"], [\"b\"]]\n\n    def test_cr_at_chunk_end_then_lf_next_chunk(self):\n        stream = CsvStream()\n        assert stream.feed(\"a,b\\r\") == [[\"a\", \"b\"]]\n        assert stream.feed(\"\\n\") == []\n        assert stream.feed(\"c,d\") == []\n        assert stream.finish() == [[\"c\", \"d\"]]\n\n\nclass TestQuoting:\n    def test_quoted_delimiter(self):\n        assert parse('\"a,b\",c\\n') == [[\"a,b\", \"c\"]]\n\n    def test_quoted_lf(self):\n        assert parse('\"a\\nb\",c\\n') == [[\"a\\nb\", \"c\"]]\n\n    def test_quoted_cr(self):\n        assert parse('\"a\\rb\",c\\n') == [[\"a\\rb\", \"c\"]]\n\n    def test_quoted_crlf(self):\n        assert parse('\"a\\r\\nb\",c\\n') == [[\"a\\r\\nb\", \"c\"]]\n\n    def test_escaped_quote(self):\n        assert parse('\"a\"\"b\",c\\n') == [['a\"b', \"c\"]]\n\n    def test_field_that_is_one_quote(self):\n        assert parse('\"\"\"\"\\n') == [['\"']]\n\n    def test_quoted_empty_field(self):\n        assert parse('\"\"\\n') == [[\"\"]]\n        assert parse('\"\"') == [[\"\"]]\n\n    def test_quote_in_unquoted_field_is_literal(self):\n        assert parse('ab\"cd\\n') == [['ab\"cd']]\n\n    def test_quote_mid_unquoted_field(self):\n        assert parse('a\"b,c\\n') == [['a\"b', \"c\"]]\n\n    def test_closing_quote_followed_by_delimiter_then_more(self):\n        assert parse('\"a\",b,c\\n') == [[\"a\", \"b\", \"c\"]]\n\n\nclass TestBlankLines:\n    def test_blank_line_produces_no_row(self):\n        assert parse(\"a\\n\\nb\\n\") == [[\"a\"], [\"b\"]]\n\n    def test_blank_crlf_line_produces_no_row(self):\n        assert parse(\"a\\r\\n\\r\\nb\\r\\n\") == [[\"a\"], [\"b\"]]\n\n    def test_final_blank_line_produces_no_row(self):\n        assert parse(\"a\\n\\n\") == [[\"a\"]]\n        assert parse(\"a\\r\\n\\r\\n\") == [[\"a\"]]\n\n    def test_all_blank_input(self):\n        assert parse(\"\") == []\n        assert parse(\"\\n\\n\") == []\n        assert parse(\"\\r\\n\") == []\n        assert parse(\"\\r\\n\\r\\n\") == []\n\n\nclass TestErrors:\n    def test_invalid_char_after_closing_quote_in_feed(self):\n        stream = CsvStream()\n        with pytest.raises(ValueError):\n            stream.feed('\"a\"b\\n')\n\n    def test_invalid_char_after_closing_quote_in_later_chunk(self):\n        stream = CsvStream()\n        stream.feed('\"a\"')\n        with pytest.raises(ValueError):\n            stream.feed(\"b\")\n\n    def test_unterminated_quoted_field_raises_from_finish(self):\n        stream = CsvStream()\n        stream.feed('\"a')\n        with pytest.raises(ValueError):\n            stream.finish()\n\n    def test_error_resets_stream_for_reuse(self):\n        stream = CsvStream()\n        with pytest.raises(ValueError):\n            stream.feed('\"a\"b\\n')\n        assert stream.feed(\"x,y\\n\") == [[\"x\", \"y\"]]\n        assert stream.finish() == []\n\n    def test_unterminated_error_resets_stream_for_reuse(self):\n        stream = CsvStream()\n        stream.feed('a,\"b')\n        with pytest.raises(ValueError):\n            stream.finish()\n        assert stream.feed(\"1,2\\n\") == [[\"1\", \"2\"]]\n        assert stream.finish() == []\n\n    def test_feed_rejects_non_string(self):\n        stream = CsvStream()\n        with pytest.raises(TypeError):\n            stream.feed(b\"a,b\\n\")\n\n\nclass TestSplitInvariance:\n    @pytest.mark.parametrize(\n        \"source,expected,boundaries\",\n        [\n            (\"a,b\\r\\nc,d\\r\\ne,f\", [[\"a\", \"b\"], [\"c\", \"d\"], [\"e\", \"f\"]], [3, 4, 8, 9]),\n            ('\"\"', [[\"\"]], [1]),\n            ('\"a\"\"b\",c\\n', [['a\"b', \"c\"]], [2, 3, 5, 6]),\n            (\"x\\ny\\rz\\r\\nw\", [[\"x\"], [\"y\"], [\"z\"], [\"w\"]], [1, 3, 5, 6, 7]),\n            (\"a,b\", [[\"a\", \"b\"]], [1, 2]),\n        ],\n    )\n    def test_identical_results_however_split(self, source, expected, boundaries):\n        assert parse(source) == expected\n        for chunks in all_chunkings(source, boundaries):\n            assert parse(source, chunks) == expected\n\n\nclass TestReuse:\n    def test_reuse_after_finish(self):\n        stream = CsvStream()\n        assert stream.feed(\"a,b\\n\") == [[\"a\", \"b\"]]\n        assert stream.finish() == []\n        assert stream.feed(\"1,2\\n3,4\") == [[\"1\", \"2\"]]\n        assert stream.finish() == [[\"3\", \"4\"]]\n\n\nclass TestDelimiter:\n    def test_custom_delimiter(self):\n        assert parse(\"a;b\\n\", delimiter=\";\") == [[\"a\", \"b\"]]\n\n    def test_tab_delimiter(self):\n        assert parse(\"a\\tb\\n\", delimiter=\"\\t\") == [[\"a\", \"b\"]]\n\n    def test_comma_literal_under_custom_delimiter(self):\n        assert parse(\"a,b;c\\n\", delimiter=\";\") == [[\"a,b\", \"c\"]]\n","filePath":"/home/user/latte-crew/var/worktrees/1107-5a53f6/tests/test_csvstream.py"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/home/user/latte-crew/var/worktrees/1107-5a53f6/tests/test_csvstream.py","exists":false,"truncated":false},"title":"tests/test_csvstream.py","time":{"start":1794053085668,"end":1794053085680}},"id":"prt_1b5e52e9e001mzr5CIYv6c2gYn","sessionID":"ses_e4a1d8700ffefFzRkM6prJ0N1i","messageID":"msg_1b5e51f610013CPtz5fufx7B53"}}
