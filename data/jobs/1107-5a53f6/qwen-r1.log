{"type":"tool_use","timestamp":1794053054194,"sessionID":"ses_e4a1d8700ffefFzRkM6prJ0N1i","part":{"type":"tool","tool":"write","callID":"chatcmpl-tool-82f21b771e5b70f2","state":{"status":"completed","input":{"filePath":"/home/user/latte-crew/var/worktrees/1107-5a53f6/ledgerkit/csvstream.py","content":"\"\"\"Streaming RFC 4180 CSV parser.\"\"\"\n\n\nclass CsvStream:\n    \"\"\"Incremental CSV parser.\n\n    feed(chunk) accepts a str of any length and returns the rows completed\n    by that chunk, each row a list of str. finish() returns the final\n    unterminated row (if any) and resets the stream so it can be reused.\n    \"\"\"\n\n    _FIELD_START = \"field_start\"\n    _UNQUOTED = \"unquoted\"\n    _QUOTED = \"quoted\"\n    _AFTER_QUOTE = \"after_quote\"\n\n    def __init__(self, delimiter=\",\"):\n        self.delimiter = delimiter\n        self._reset()\n\n    def _reset(self):\n        self._state = self._FIELD_START\n        self._row = []\n        self._field = []\n        self._pending_cr = False\n        self._has_content = False\n\n    def feed(self, chunk):\n        if not isinstance(chunk, str):\n            raise TypeError(\"chunk must be a str, got %s\" % type(chunk).__name__)\n        rows = []\n        for ch in chunk:\n            if self._pending_cr:\n                if ch == \"\\n\":\n                    # The CR already ended the record; this LF is its\n                    # CRLF continuation and must not start another one.\n                    self._pending_cr = False\n                    continue\n                self._pending_cr = False\n            if self._state == self._FIELD_START:\n                if ch == self.delimiter:\n                    self._row.append(\"\")\n                    self._has_content = True\n                elif ch == '\"':\n                    self._state = self._QUOTED\n                    self._has_content = True\n                elif ch == \"\\r\":\n                    self._pending_cr = True\n                    rows.extend(self._end_record())\n                elif ch == \"\\n\":\n                    rows.extend(self._end_record())\n                else:\n                    self._field.append(ch)\n                    self._state = self._UNQUOTED\n                    self._has_content = True\n            elif self._state == self._UNQUOTED:\n                if ch == self.delimiter:\n                    self._row.append(\"\".join(self._field))\n                    self._field = []\n                    self._state = self._FIELD_START\n                elif ch == \"\\r\":\n                    self._pending_cr = True\n                    rows.extend(self._end_record())\n                elif ch == \"\\n\":\n                    rows.extend(self._end_record())\n                else:\n                    # Quotes are ordinary characters in unquoted fields.\n                    self._field.append(ch)\n            elif self._state == self._QUOTED:\n                if ch == '\"':\n                    self._state = self._AFTER_QUOTE\n                else:\n                    # Delimiters and line breaks are literal inside quotes.\n                    self._field.append(ch)\n            else:  # _AFTER_QUOTE\n                if ch == '\"':\n                    # Doubled quote is one literal quote, even across chunks.\n                    self._field.append(ch)\n                    self._state = self._QUOTED\n                elif ch == self.delimiter:\n                    self._row.append(\"\".join(self._field))\n                    self._field = []\n                    self._state = self._FIELD_START\n                elif ch == \"\\r\":\n                    self._pending_cr = True\n                    rows.extend(self._end_record())\n                elif ch == \"\\n\":\n                    rows.extend(self._end_record())\n                else:\n                    self._reset()\n                    raise ValueError(\n                        \"unexpected character %r after closing quote\" % ch\n                    )\n        return rows\n\n    def _end_record(self):\n        row = self._row + [\"\".join(self._field)]\n        self._row = []\n        self._field = []\n        self._state = self._FIELD_START\n        has_content = self._has_content\n        self._has_content = False\n        return [row] if has_content else []\n\n    def finish(self):\n        self._pending_cr = False\n        if self._state == self._QUOTED:\n            self._reset()\n            raise ValueError(\"unterminated quoted field\")\n        rows = []\n        if self._has_content:\n            rows.append(self._row + [\"\".join(self._field)])\n        self._reset()\n        return rows\n"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/home/user/latte-crew/var/worktrees/1107-5a53f6/ledgerkit/csvstream.py","exists":false,"truncated":false},"title":"ledgerkit/csvstream.py","time":{"start":1794053054184,"end":1794053054192}},"id":"prt_1b5e4e81d001vVO3SvFbG7pjvV","sessionID":"ses_e4a1d8700ffefFzRkM6prJ0N1i","messageID":"msg_1b5e29b3f001AN6IplKu8r8Pd2"}}
