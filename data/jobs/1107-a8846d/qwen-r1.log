nd_spec(\"zoneinfo\") is None,\n-    reason=\"zoneinfo unavailable\",\n-)\n def test_dst_fall_back_filtering_uses_actual_utc_minutes():\n     from zoneinfo import ZoneInfo\n \n     la = ZoneInfo(\"America/Los_Angeles\")\n","additions":0,"deletions":4},"truncated":false},"title":"tests/test_slots.py","time":{"start":1794050501173,"end":1794050501183}},"id":"prt_1b5be22e6001nBT7vm3OIyGsqw","sessionID":"ses_e4a44d004ffevbAbEQYWC9veiQ","messageID":"msg_1b5be19ed001b9mwolLZvH0uBk"}}
