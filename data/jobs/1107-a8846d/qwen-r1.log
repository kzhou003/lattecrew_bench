{"type":"tool_use","timestamp":1794050450330,"sessionID":"ses_e4a44d004ffevbAbEQYWC9veiQ","part":{"type":"tool","tool":"write","callID":"chatcmpl-tool-bf5dcba1f2fe314f","state":{"status":"completed","input":{"filePath":"/home/user/latte-crew/var/worktrees/1107-a8846d/ledgerkit/slots.py","content":"from datetime import timedelta, timezone\n\n\ndef _require_aware(dt, name):\n    if dt.tzinfo is None or dt.utcoffset() is None:\n        raise ValueError(f\"{name} must be a timezone-aware datetime\")\n\n\ndef free_slots(busy, day_start, day_end, min_minutes=0):\n    \"\"\"Return the free gaps inside [day_start, day_end] as a sorted list of\n    (start, end) tuples, expressed in the timezone of day_start.\n\n    busy is a list of (start, end) timezone-aware datetimes, possibly\n    overlapping, unsorted, and in different UTC offsets. All ordering,\n    clipping, merging, and duration checks happen in UTC; endpoints are\n    converted back to day_start's timezone only for the returned tuples.\n    \"\"\"\n    _require_aware(day_start, \"day_start\")\n    _require_aware(day_end, \"day_end\")\n\n    window_start = day_start.astimezone(timezone.utc)\n    window_end = day_end.astimezone(timezone.utc)\n    if window_end <= window_start:\n        raise ValueError(\"day_end must be strictly after day_start\")\n\n    min_delta = timedelta(minutes=min_minutes)\n    output_tz = day_start.tzinfo\n\n    clipped = []\n    for start, end in busy:\n        _require_aware(start, \"busy interval start\")\n        _require_aware(end, \"busy interval end\")\n        s = start.astimezone(timezone.utc)\n        e = end.astimezone(timezone.utc)\n        if e < s:\n            raise ValueError(\"busy interval end must not be before its start\")\n        if e <= s:\n            continue\n        if e <= window_start or s >= window_end:\n            continue\n        clipped.append((max(s, window_start), min(e, window_end)))\n\n    clipped.sort()\n    merged = []\n    for s, e in clipped:\n        if merged and s <= merged[-1][1]:\n            merged[-1] = (merged[-1][0], max(merged[-1][1], e))\n        else:\n            merged.append((s, e))\n\n    gaps = []\n    cursor = window_start\n    for s, e in merged:\n        if cursor < s and s - cursor >= min_delta:\n            gaps.append((cursor, s))\n        cursor = max(cursor, e)\n    if cursor < window_end and window_end - cursor >= min_delta:\n        gaps.append((cursor, window_end))\n\n    return [(s.astimezone(output_tz), e.astimezone(output_tz)) for s, e in gaps]\n"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/home/user/latte-crew/var/worktrees/1107-a8846d/ledgerkit/slots.py","exists":false,"truncated":false},"title":"ledgerkit/slots.py","time":{"start":1794050450316,"end":1794050450327}},"id":"prt_1b5bd4141001SwVwh0qcI76m4Q","sessionID":"ses_e4a44d004ffevbAbEQYWC9veiQ","messageID":"msg_1b5bd3507001iBtX4W77deudGs"}}
