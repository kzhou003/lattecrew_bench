{"type":"tool_use","timestamp":1794050496909,"sessionID":"ses_e4a44d004ffevbAbEQYWC9veiQ","part":{"type":"tool","tool":"write","callID":"chatcmpl-tool-b1080501989251b7","state":{"status":"completed","input":{"content":"from datetime import datetime, timedelta, timezone\n\nimport pytest\n\nfrom ledgerkit.slots import free_slots\n\nUTC = timezone.utc\nT2 = timezone(timedelta(hours=2))\n\n\ndef d(year, month, day, hour, minute, tz=UTC):\n    return datetime(year, month, day, hour, minute, tzinfo=tz)\n\n\ndef test_empty_busy_returns_full_window():\n    start, end = d(2026, 1, 5, 8, 0), d(2026, 1, 5, 18, 0)\n    assert free_slots([], start, end) == [(start, end)]\n\n\ndef test_unsorted_overlapping_nested_merge():\n    start, end = d(2026, 1, 5, 0, 0), d(2026, 1, 6, 0, 0)\n    busy = [\n        (d(2026, 1, 5, 10, 0), d(2026, 1, 5, 11, 0)),\n        (d(2026, 1, 5, 2, 0), d(2026, 1, 5, 4, 0)),\n        (d(2026, 1, 5, 3, 0), d(2026, 1, 5, 5, 0)),\n        (d(2026, 1, 5, 4, 30), d(2026, 1, 5, 4, 45)),\n        (d(2026, 1, 5, 10, 30), d(2026, 1, 5, 12, 0)),\n    ]\n    assert free_slots(busy, start, end) == [\n        (d(2026, 1, 5, 0, 0), d(2026, 1, 5, 2, 0)),\n        (d(2026, 1, 5, 5, 0), d(2026, 1, 5, 10, 0)),\n        (d(2026, 1, 5, 12, 0), d(2026, 1, 6, 0, 0)),\n    ]\n\n\ndef test_touching_busy_intervals_merge_without_zero_gap():\n    start, end = d(2026, 1, 5, 8, 0), d(2026, 1, 5, 18, 0)\n    busy = [\n        (d(2026, 1, 5, 9, 0), d(2026, 1, 5, 10, 0)),\n        (d(2026, 1, 5, 10, 0), d(2026, 1, 5, 11, 0)),\n    ]\n    assert free_slots(busy, start, end) == [\n        (d(2026, 1, 5, 8, 0), d(2026, 1, 5, 9, 0)),\n        (d(2026, 1, 5, 11, 0), d(2026, 1, 5, 18, 0)),\n    ]\n\n\ndef test_outside_ignored_and_partial_clipped():\n    start, end = d(2026, 1, 5, 10, 0), d(2026, 1, 5, 16, 0)\n    busy = [\n        (d(2026, 1, 5, 6, 0), d(2026, 1, 5, 9, 0)),\n        (d(2026, 1, 5, 17, 0), d(2026, 1, 5, 20, 0)),\n        (d(2026, 1, 5, 8, 0), d(2026, 1, 5, 11, 0)),\n        (d(2026, 1, 5, 15, 0), d(2026, 1, 5, 22, 0)),\n    ]\n    assert free_slots(busy, start, end) == [\n        (d(2026, 1, 5, 11, 0), d(2026, 1, 5, 15, 0))\n    ]\n\n\ndef test_full_coverage_returns_empty():\n    start, end = d(2026, 1, 5, 8, 0), d(2026, 1, 5, 18, 0)\n    busy = [(d(2026, 1, 5, 0, 0), d(2026, 1, 6, 0, 0))]\n    assert free_slots(busy, start, end) == []\n\n\ndef test_zero_length_busy_ignored():\n    start, end = d(2026, 1, 5, 8, 0), d(2026, 1, 5, 18, 0)\n    busy = [(d(2026, 1, 5, 9, 0), d(2026, 1, 5, 9, 0))]\n    assert free_slots(busy, start, end) == [(start, end)]\n\n\ndef test_different_fixed_offsets_normalized_and_output_in_day_start_tz():\n    start = d(2026, 1, 5, 10, 0, T2)  # 08:00 UTC\n    end = d(2026, 1, 5, 14, 0, T2)  # 12:00 UTC\n    busy = [\n        (d(2026, 1, 5, 9, 0), d(2026, 1, 5, 11, 0)),  # UTC\n        (d(2026, 1, 5, 12, 0, T2), d(2026, 1, 5, 14, 0, T2)),  # 10:00-12:00 UTC\n    ]\n    result = free_slots(busy, start, end)\n    assert result == [(d(2026, 1, 5, 10, 0, T2), d(2026, 1, 5, 11, 0, T2))]\n    for s, e in result:\n        assert s.tzinfo is T2\n        assert e.tzinfo is T2\n\n\ndef test_min_minutes_filters_short_gaps():\n    start, end = d(2026, 1, 5, 0, 0), d(2026, 1, 6, 0, 0)\n    busy = [\n        (d(2026, 1, 5, 6, 0), d(2026, 1, 5, 6, 30)),\n        (d(2026, 1, 5, 7, 0), d(2026, 1, 5, 7, 30)),\n        (d(2026, 1, 5, 10, 0), d(2026, 1, 5, 11, 0)),\n    ]\n    all_gaps = [\n        (d(2026, 1, 5, 0, 0), d(2026, 1, 5, 6, 0)),\n        (d(2026, 1, 5, 6, 30), d(2026, 1, 5, 7, 0)),\n        (d(2026, 1, 5, 7, 30), d(2026, 1, 5, 10, 0)),\n        (d(2026, 1, 5, 11, 0), d(2026, 1, 6, 0, 0)),\n    ]\n    assert free_slots(busy, start, end, min_minutes=0) == all_gaps\n    # Exactly-equal gap (30 minutes) is retained at min_minutes=30.\n    assert free_slots(busy, start, end, min_minutes=30) == all_gaps\n    assert free_slots(busy, start, end, min_minutes=45) == [\n        all_gaps[0],\n        all_gaps[2],\n        all_gaps[3],\n    ]\n\n\ndef test_naive_day_start_raises():\n    with pytest.raises(ValueError):\n        free_slots([], datetime(2026, 1, 5, 8, 0), d(2026, 1, 5, 18, 0))\n\n\ndef test_naive_day_end_raises():\n    with pytest.raises(ValueError):\n        free_slots([], d(2026, 1, 5, 8, 0), datetime(2026, 1, 5, 18, 0))\n\n\ndef test_naive_busy_endpoints_raise():\n    start, end = d(2026, 1, 5, 8, 0), d(2026, 1, 5, 18, 0)\n    with pytest.raises(ValueError):\n        free_slots([(datetime(2026, 1, 5, 9, 0), d(2026, 1, 5, 10, 0))], start, end)\n    with pytest.raises(ValueError):\n        free_slots([(d(2026, 1, 5, 9, 0), datetime(2026, 1, 5, 10, 0))], start, end)\n\n\ndef test_reversed_busy_raises_and_zero_length_does_not():\n    start, end = d(2026, 1, 5, 8, 0), d(2026, 1, 5, 18, 0)\n    with pytest.raises(ValueError):\n        free_slots([(d(2026, 1, 5, 10, 0), d(2026, 1, 5, 9, 0))], start, end)\n    assert free_slots(\n        [(d(2026, 1, 5, 10, 0), d(2026, 1, 5, 10, 0))], start, end\n    ) == [(start, end)]\n\n\ndef test_equal_or_reversed_day_bounds_raise():\n    with pytest.raises(ValueError):\n        free_slots([], d(2026, 1, 5, 8, 0), d(2026, 1, 5, 8, 0))\n    with pytest.raises(ValueError):\n        free_slots([], d(2026, 1, 5, 18, 0), d(2026, 1, 5, 8, 0))\n\n\n@pytest.mark.skipif(\n    __import__(\"importlib.util\", fromlist=[\"util\"]).find_spec(\"zoneinfo\") is None,\n    reason=\"zoneinfo unavailable\",\n)\ndef test_dst_fall_back_filtering_uses_actual_utc_minutes():\n    from zoneinfo import ZoneInfo\n\n    la = ZoneInfo(\"America/Los_Angeles\")\n    # 2025-11-02 fall-back: 01:00-02:00 PDT repeats as 01:00-02:00 PST.\n    start = datetime(2025, 11, 2, 1, 30, tzinfo=la)  # 08:30 UTC (PDT)\n    end = datetime(2025, 11, 2, 9, 0, tzinfo=la)  # 17:00 UTC (PST)\n    busy = [\n        (\n            datetime(2025, 11, 2, 1, 45, tzinfo=la),  # 08:45 UTC (PDT)\n            datetime(2025, 11, 2, 1, 55, tzinfo=la),  # 08:55 UTC (PDT)\n        )\n    ]\n    all_gaps = free_slots(busy, start, end, min_minutes=0)\n    assert all_gaps == [\n        (start, datetime(2025, 11, 2, 1, 45, tzinfo=la)),\n        (datetime(2025, 11, 2, 1, 55, tzinfo=la), end),\n    ]\n    # The trailing gap spans the repeated hour: 485 actual UTC minutes,\n    # but only 7h05m (425 wall-clock minutes) on a wall-clock reading.\n    result = free_slots(busy, start, end, min_minutes=480)\n    assert result == [(datetime(2025, 11, 2, 1, 55, tzinfo=la), end)]\n    for s, e in all_gaps:\n        assert s.tzinfo is la\n        assert e.tzinfo is la\n","filePath":"/home/user/latte-crew/var/worktrees/1107-a8846d/tests/test_slots.py"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/home/user/latte-crew/var/worktrees/1107-a8846d/tests/test_slots.py","exists":false,"truncated":false},"title":"tests/test_slots.py","time":{"start":1794050496903,"end":1794050496908}},"id":"prt_1b5bd66da001IUtjtH0WY75Lab","sessionID":"ses_e4a44d004ffevbAbEQYWC9veiQ","messageID":"msg_1b5bd63f1001K6Ctl81sZYJUID"}}
