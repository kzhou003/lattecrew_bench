{"type":"assistant","message":{"model":"claude-sonnet-5-5","id":"msg_011CgoF3Yz4PX2FogH6Uvz9D","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01X4hyt14hhEaXsz7mzRskQJ","name":"Bash","input":{"command":"cat > ledgerkit/cache.py <<'EOF'\n\"\"\"Thread-safe LRU cache with per-entry TTL.\"\"\"\nimport threading\nimport time\nfrom collections import OrderedDict\n\n\nclass TTLCache:\n    def __init__(self, maxsize, ttl, clock=time.monotonic):\n        if maxsize < 1:\n            raise ValueError(\"maxsize must be >= 1\")\n        if ttl <= 0:\n            raise ValueError(\"ttl must be > 0\")\n        self.maxsize = maxsize\n        self.ttl = ttl\n        self._clock = clock\n        self._data = OrderedDict()  # key -> (value, stored_time); LRU first\n        self._lock = threading.RLock()\n        self._hits = 0\n        self._misses = 0\n        self._evictions = 0\n\n    def _purge(self, now):\n        dead = [k for k, (_, t) in self._data.items() if now - t >= self.ttl]\n        for k in dead:\n            del self._data[k]\n\n    def put(self, key, value):\n        with self._lock:\n            now = self._clock()\n            if key in self._data:\n                del self._data[key]\n            else:\n                self._purge(now)\n                while len(self._data) >= self.maxsize:\n                    self._data.popitem(last=False)\n                    self._evictions += 1\n            self._data[key] = (value, now)\n\n    def get(self, key, default=None):\n        with self._lock:\n            item = self._data.get(key)\n            if item is not None:\n                value, stored = item\n                if self._clock() - stored < self.ttl:\n                    self._data.move_to_end(key)\n                    self._hits += 1\n                    return value\n                del self._data[key]\n            self._misses += 1\n            return default\n\n    def __len__(self):\n        with self._lock:\n            self._purge(self._clock())\n            return len(self._data)\n\n    def __contains__(self, key):\n        with self._lock:\n            item = self._data.get(key)\n            return item is not None and self._clock() - item[1] < self.ttl\n\n    def stats(self):\n        with self._lock:\n            return {\"hits\": self._hits, \"misses\": self._misses,\n                    \"evictions\": self._evictions}\nEOF\ncat > tests/test_cache.py <<'EOF'\nimport threading\n\nimport pytest\n\nfrom ledgerkit.cache import TTLCache\n\n\nclass Clock:\n    def __init__(self):\n        self.t = 0.0\n\n    def __call__(self):\n        return self.t\n\n\ndef make(maxsize=2, ttl=10):\n    c = Clock()\n    return TTLCache(maxsize, ttl, clock=c), c\n\n\ndef test_invalid_args():\n    with pytest.raises(ValueError):\n        TTLCache(0, 1)\n    with pytest.raises(ValueError):\n        TTLCache(1, 0)\n\n\ndef test_basic_and_stats():\n    cache, _ = make()\n    cache.put(\"a\", 1)\n    assert cache.get(\"a\") == 1\n    assert cache.get(\"x\", \"d\") == \"d\"\n    assert cache.stats() == {\"hits\": 1, \"misses\": 1, \"evictions\": 0}\n\n\ndef test_lru_eviction():\n    cache, _ = make()\n    cache.put(\"a\", 1)\n    cache.put(\"b\", 2)\n    cache.get(\"a\")\n    cache.put(\"c\", 3)\n    assert \"b\" not in cache and \"a\" in cache and \"c\" in cache\n    assert cache.stats()[\"evictions\"] == 1\n\n\ndef test_expiry_boundary_and_len():\n    cache, clock = make(ttl=10)\n    cache.put(\"a\", 1)\n    clock.t = 9.99\n    assert cache.get(\"a\") == 1\n    clock.t = 10\n    assert \"a\" not in cache\n    assert len(cache) == 0\n    assert cache.get(\"a\") is None\n    assert cache.stats()[\"misses\"] == 1\n    assert cache.stats()[\"evictions\"] == 0\n\n\ndef test_get_does_not_refresh_expiry():\n    cache, clock = make(ttl=10)\n    cache.put(\"a\", 1)\n    clock.t = 5\n    cache.get(\"a\")\n    clock.t = 10\n    assert \"a\" not in cache\n\n\ndef test_expired_dropped_before_lru_eviction():\n    cache, clock = make(maxsize=2, ttl=10)\n    cache.put(\"a\", 1)      # t=0, will expire\n    clock.t = 5\n    cache.put(\"b\", 2)\n    cache.get(\"a\")         # a is now most recent, b is LRU\n    clock.t = 10           # a expired, b live\n    cache.put(\"c\", 3)\n    assert \"b\" in cache and \"c\" in cache\n    assert cache.stats()[\"evictions\"] == 0\n\n\ndef test_put_existing_restarts_ttl_and_order():\n    cache, clock = make(maxsize=2, ttl=10)\n    cache.put(\"a\", 1)\n    cache.put(\"b\", 2)\n    clock.t = 8\n    cache.put(\"a\", 9)\n    clock.t = 12\n    assert cache.get(\"a\") == 9\n    assert \"b\" not in cache\n    assert cache.stats()[\"evictions\"] == 0\n\n\ndef test_contains_no_side_effects():\n    cache, _ = make()\n    cache.put(\"a\", 1)\n    cache.put(\"b\", 2)\n    assert \"a\" in cache and \"z\" not in cache\n    assert cache.stats() == {\"hits\": 0, \"misses\": 0, \"evictions\": 0}\n    cache.put(\"c\", 3)  # a still LRU\n    assert \"a\" not in cache\n\n\ndef test_threads():\n    cache = TTLCache(50, 100)\n\n    def work(n):\n        for i in range(2000):\n            cache.put((n, i % 100), i)\n            cache.get((n, i % 100))\n            len(cache)\n\n    ts = [threading.Thread(target=work, args=(n,)) for n in range(8)]\n    for t in ts:\n        t.start()\n    for t in ts:\n        t.join()\n    assert len(cache) <= 50\n    s = cache.stats()\n    assert s[\"hits\"] + s[\"misses\"] == 8 * 2000\nEOF\npython3 -m pytest -q 2>&1 | tail -5; git add -A; git commit -qm \"Add thread-safe TTLCache with tests\n\nCo-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>\"; git log --oneline | head -2"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":142,"cache_read_input_tokens":31583,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":142},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed"