{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_019vjzcJBG2S18mLTTHSxvgr","type":"tool_result","content":"diff --git a/ledgerkit/money.py b/ledgerkit/money.py\nindex 583519c..8d9cfec 100644\n--- a/ledgerkit/money.py\n+++ b/ledgerkit/money.py\n@@ -1,4 +1,33 @@\n def split(total_cents, weights):\n-    \"\"\"Split an amount between parties in proportion to their weights.\"\"\"\n-    s = sum(weights)\n-    return [round(total_cents * w / s) for w in weights]\n+    \"\"\"Split an amount between parties in proportion to their weights.\n+\n+    Uses the largest remainder method with exact integer arithmetic:\n+    each party gets the floor of its exact share, and leftover cents\n+    go one at a time to the parties with the largest fractional\n+    remainder, ties broken by the lower index.\n+    \"\"\"\n+    ws = list(weights)\n+    if not ws:\n+        raise ValueError(\"weights must not be empty\")\n+    if any(w < 0 for w in ws):\n+        raise ValueError(\"weights must be non-negative\")\n+    weight_sum = sum(ws)\n+    if weight_sum == 0:\n+        raise ValueError(\"sum of weights must be positive\")\n+\n+    amount = abs(total_cents)\n+    quotients = []\n+    remainders = []\n+    for w in ws:\n+        q, r = divmod(amount * w, weight_sum)\n+        quotients.append(q)\n+        remainders.append(r)\n+\n+    leftover = amount - sum(quotients)\n+    order = sorted(range(len(ws)), key=lambda i: (-remainders[i], i))\n+    for i in order[:leftover]:\n+        quotients[i] += 1\n+\n+    if total_cents < 0:\n+        quotients = [-q for q in quotients]\n+    return quotients\ndiff --git a/tests/test_money.py b/tests/test_money.py\nindex a14c927..5fc6c34 100644\n--- a/tests/test_money.py\n+++ b/tests/test_money.py\n@@ -1,5 +1,58 @@\n+import pytest\n+\n from ledgerkit.money import split\n \n \n def test_even_split():\n     assert split(100, [1, 1]) == [50, 50]\n+\n+\n+def test_largest_remainder_three_way_split():\n+    assert split(100, [1, 1, 1]) == [34, 33, 33]\n+\n+\n+def test_largest_fractional_remainder_wins():\n+    assert split(10, [1, 2, 3]) == [2, 3, 5]\n+\n+\n+def test_tie_broken_by_lower_index():\n+    assert split(5, [1, 1, 1]) == [2, 2, 1]\n+\n+\n+def test_negative_total_mirrors_positive_allocation():\n+    assert split(-5, [1, 1, 1]) == [-2, -2, -1]\n+\n+\n+def test_zero_total_with_valid_weights():\n+    assert split(0, [1, 2, 3]) == [0, 0, 0]\n+\n+\n+def test_sum_preserved_positive_uneven():\n+    result = split(100, [1, 2, 3])\n+    assert sum(result) == 100\n+    assert all(isinstance(x, int) for x in result)\n+\n+\n+def test_sum_preserved_negative_uneven():\n+    result = split(-100, [1, 2, 3])\n+    assert sum(result) == -100\n+    assert all(isinstance(x, int) for x in result)\n+\n+\n+def test_empty_weights_raise():\n+    with pytest.raises(ValueError):\n+        split(100, [])\n+\n+\n+def test_negative_weight_raises():\n+    with pytest.raises(ValueError):\n+        split(100, [1, -1, 2])\n+\n+\n+def test_all_zero_weights_raise():\n+    with pytest.raises(ValueError):\n+        split(100, [0, 0])\n+\n+\n+def test_accepts_any_iterable():\n+    assert split(10, iter([1, 2, 3])) == [2, 3, 5]\n............                                                             [100%]\n12 passed in 0.01s","is_error":false}]},"parent_tool_use_id":null,"session_id":"c3d425fa-ec9d-448f-b0fc-9fedd7dba32d","uuid":"39ddeca9-c950-435c-a6e3-0ba2af4c6ae1","timestamp":"2026-11-07T11:12:51.898Z","tool_use_result":{"stdout":"diff --git a/ledgerkit/money.py b/ledgerkit/money.py\nindex 583519c..8d9cfec 100644\n--- a/ledgerkit/money.py\n+++ b/ledgerkit/money.py\n@@ -1,4 +1,33 @@\n def split(total_cents, weights):\n-    \"\"\"Split an amount between parties in proportion to their weights.\"\"\"\n-    s = sum(weights)\n-    return [round(total_cents * w / s) for w in weights]\n+    \"\"\"Split an amount between parties in proportion to their weights.\n+\n+    Uses the largest remainder method with exact integer arithmetic:\n+    each party gets the floor of its exact share, and leftover cents\n+    go one at a time to the parties with the largest fractional\n+    remainder, ties broken by the lower index.\n+    \"\"\"\n+    ws = list(weights)\n+    if not ws:\n+        raise ValueError(\"weights must not be empty\")\n+    if any(w < 0 for w in ws):\n+        raise ValueError(\"weights must be non-negative\")\n+    weight_sum = sum(ws)\n+    if weight_sum == 0:\n+        raise ValueError(\"sum of weights must be positive\")\n+\n+    amount = abs(total_cents)\n+    quotients = []\n+    remainders = []\n+    for w in ws:\n+        q, r = divmod(amount * w, weight_sum)\n+        quotients.append(q)\n+        remainders.append(r)\n+\n+    leftover = amount - sum(quotients)\n+    order = sorted(range(len(ws)), key=lambda i: (-remainders[i], i))\n+    for i in order[:leftover]:\n+        quotients[i] += 1\n+\n+    if total_cents < 0:\n+        quotients = [-q for q in quotients]\n+    return quotients\ndiff --git a/tests/test_money.py b/tests/test_money.py\nindex a14c927..5fc6c34 100644\n--- a/tests/test_money.py\n+++ b/tests/test_money.py\n@@ -1,5 +1,58 @@\n+import pytest\n+\n from ledgerkit.money import split\n \n \n def test_even_split():\n     assert split(100, [1, 1]) == [50, 50]\n+\n+\n+def test_largest_remainder_three_way_split():\n+    assert split(100, [1, 1, 1]) == [34, 33, 33]\n+\n+\n+def test_largest_fractional_remainder_wins():\n+    assert split(10, [1, 2, 3]) == [2, 3, 5]\n+\n+\n+def test_tie_broken_by_lower_index():\n+    assert split(5, [1, 1, 1]) == [2, 2, 1]\n+\n+\n+def test_negative_total_mirrors_positive_allocation():\n+    assert split(-5, [1, 1, 1]) == [-2, -2, -1]\n+\n+\n+def test_zero_total_with_valid_weights():\n+    assert split(0, [1, 2, 3]) == [0, 0, 0]\n+\n+\n+def test_sum_preserved_positive_uneven():\n+    result = split(100, [1, 2, 3])\n+    assert sum(result) == 100\n+    assert all(isinstance(x, int) for x in result)\n+\n+\n+def test_sum_preserved_negative_uneven():\n+    result = split(-100, [1, 2, 3])\n+    assert sum(result) == -100\n+    assert all(isinstance(x, int) for x in result)\n+\n+\n+def test_empty_weights_raise():\n+    with pytest.raises(ValueError):\n+        split(100, [])\n+\n+\n+def test_negative_weight_raises():\n+    with pytest.raises(ValueError):\n+        split(100, [1, -1, 2])\n+\n+\n+def test_all_zero_weights_raise():\n+    with pytest.raises(ValueError):\n+        split(100, [0, 0])\n+\n+\n+def test_accepts_any_iterable():\n+    assert split(10, iter([1, 2, 3])) == [2, 3, 5]\n............                                                             [100%]\n12 passed in 0.01s","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_019vjzcJBG2S18mLTTHSxvgr","permission_decision":{"decision":"accept","source":"config","reason_type":"classifier"}}]}
