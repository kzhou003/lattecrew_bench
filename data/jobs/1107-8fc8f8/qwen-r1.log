{"type":"tool_use","timestamp":1794041665298,"sessionID":"ses_e4ac9a066ffeyAfkgy12TJiPzo","part":{"type":"tool","tool":"bash","callID":"chatcmpl-tool-adcabb5809000515","state":{"status":"completed","input":{"command":"git diff","workdir":"/home/user/latte-crew/var/worktrees/1107-8fc8f8"},"output":"diff --git a/ledgerkit/money.py b/ledgerkit/money.py\nindex 583519c..1534523 100644\n--- a/ledgerkit/money.py\n+++ b/ledgerkit/money.py\n@@ -1,4 +1,31 @@\n def split(total_cents, weights):\n-    \"\"\"Split an amount between parties in proportion to their weights.\"\"\"\n-    s = sum(weights)\n-    return [round(total_cents * w / s) for w in weights]\n+    \"\"\"Split an amount between parties in proportion to their weights.\n+\n+    Uses the largest remainder method with exact integer arithmetic so the\n+    results always sum exactly to ``total_cents``.\n+    \"\"\"\n+    ws = list(weights)\n+    if not ws:\n+        raise ValueError(\"weights must not be empty\")\n+    if any(w < 0 for w in ws):\n+        raise ValueError(\"weights must not be negative\")\n+    weight_sum = sum(ws)\n+    if weight_sum == 0:\n+        raise ValueError(\"weights must not all be zero\")\n+\n+    amount = abs(total_cents)\n+    quotients = []\n+    remainders = []\n+    for w in ws:\n+        q, r = divmod(amount * w, weight_sum)\n+        quotients.append(q)\n+        remainders.append(r)\n+\n+    leftover = amount - sum(quotients)\n+    order = sorted(range(len(ws)), key=lambda i: (-remainders[i], i))\n+    for i in order[:leftover]:\n+        quotients[i] += 1\n+\n+    if total_cents < 0:\n+        quotients = [-q for q in quotients]\n+    return quotients\ndiff --git a/tests/test_money.py b/tests/test_money.py\nindex a14c927..56162cc 100644\n--- a/tests/test_money.py\n+++ b/tests/test_money.py\n@@ -1,5 +1,54 @@\n+import pytest\n+\n from ledgerkit.money import split\n \n \n def test_even_split():\n     assert split(100, [1, 1]) == [50, 50]\n+\n+\n+def test_largest_remainder_distribution():\n+    assert split(100, [1, 1, 1]) == [34, 33, 33]\n+\n+\n+def test_largest_fractional_remainder_wins():\n+    assert split(10, [1, 2, 3]) == [2, 3, 5]\n+\n+\n+def test_tie_breaks_by_lower_index():\n+    assert split(5, [1, 1, 1]) == [2, 2, 1]\n+\n+\n+def test_negative_total_mirrors_positive_allocation():\n+    assert split(-5, [1, 1, 1]) == [-2, -2, -1]\n+\n+\n+def test_zero_total_returns_all_zeroes():\n+    assert split(0, [1, 2, 3]) == [0, 0, 0]\n+\n+\n+def test_empty_weights_raises():\n+    with pytest.raises(ValueError):\n+        split(100, [])\n+\n+\n+def test_negative_weight_raises():\n+    with pytest.raises(ValueError):\n+        split(100, [1, -2])\n+\n+\n+def test_all_zero_weights_raise():\n+    with pytest.raises(ValueError):\n+        split(100, [0, 0, 0])\n+\n+\n+def test_sum_preserved_positive_uneven():\n+    result = split(100, [1, 2, 3])\n+    assert result == [17, 33, 50]\n+    assert sum(result) == 100\n+\n+\n+def test_sum_preserved_negative_uneven():\n+    result = split(-100, [1, 2, 3])\n+    assert result == [-17, -33, -50]\n+    assert sum(result) == -100\n","metadata":{"output":"diff --git a/ledgerkit/money.py b/ledgerkit/money.py\nindex 583519c..1534523 100644\n--- a/ledgerkit/money.py\n+++ b/ledgerkit/money.py\n@@ -1,4 +1,31 @@\n def split(total_cents, weights):\n-    \"\"\"Split an amount between parties in proportion to their weights.\"\"\"\n-    s = sum(weights)\n-    return [round(total_cents * w / s) for w in weights]\n+    \"\"\"Split an amount between parties in proportion to their weights.\n+\n+    Uses the largest remainder method with exact integer arithmetic so the\n+    results always sum exactly to ``total_cents``.\n+    \"\"\"\n+    ws = list(weights)\n+    if not ws:\n+        raise ValueError(\"weights must not be empty\")\n+    if any(w < 0 for w in ws):\n+        raise ValueError(\"weights must not be negative\")\n+    weight_sum = sum(ws)\n+    if weight_sum == 0:\n+        raise ValueError(\"weights must not all be zero\")\n+\n+    amount = abs(total_cents)\n+    quotients = []\n+    remainders = []\n+    for w in ws:\n+        q, r = divmod(amount * w, weight_sum)\n+        quotients.append(q)\n+        remainders.append(r)\n+\n+    leftover = amount - sum(quotients)\n+    order = sorted(range(len(ws)), key=lambda i: (-remainders[i], i))\n+    for i in order[:leftover]:\n+        quotients[i] += 1\n+\n+    if total_cents < 0:\n+        quotients = [-q for q in quotients]\n+    return quotients\ndiff --git a/tests/test_money.py b/tests/test_money.py\nindex a14c927..56162cc 100644\n--- a/tests/test_money.py\n+++ b/tests/test_money.py\n@@ -1,5 +1,54 @@\n+import pytest\n+\n from ledgerkit.money import split\n \n \n def test_even_split():\n     assert split(100, [1, 1]) == [50, 50]\n+\n+\n+def test_largest_remainder_distribution():\n+    assert split(100, [1, 1, 1]) == [34, 33, 33]\n+\n+\n+def test_largest_fractional_remainder_wins():\n+    assert split(10, [1, 2, 3]) == [2, 3, 5]\n+\n+\n+def test_tie_breaks_by_lower_index():\n+    assert split(5, [1, 1, 1]) == [2, 2, 1]\n+\n+\n+def test_negative_total_mirrors_positive_allocation():\n+    assert split(-5, [1, 1, 1]) == [-2, -2, -1]\n+\n+\n+def test_zero_total_returns_all_zeroes():\n+    assert split(0, [1, 2, 3]) == [0, 0, 0]\n+\n+\n+def test_empty_weights_raises():\n+    with pytest.raises(ValueError):\n+        split(100, [])\n+\n+\n+def test_negative_weight_raises():\n+    with pytest.raises(ValueError):\n+        split(100, [1, -2])\n+\n+\n+def test_all_zero_weights_raise():\n+    with pytest.raises(ValueError):\n+        split(100, [0, 0, 0])\n+\n+\n+def test_sum_preserved_positive_uneven():\n+    result = split(100, [1, 2, 3])\n+    assert result == [17, 33, 50]\n+    assert sum(result) == 100\n+\n+\n+def test_sum_preserved_negative_uneven():\n+    result = split(-100, [1, 2, 3])\n+    assert result == [-17, -33, -50]\n+    assert sum(result) == -100\n","exit":0,"truncated":false},"title":"git diff","time":{"start":1794041665284,"end":1794041665296}},"id":"prt_1b5375434001tUuZ502LbP2qfT","sessionID":"ses_e4ac9a066ffeyAfkgy12TJiPzo","messageID":"msg_1b537517e001fnKroXbM3sOsO8"}}
