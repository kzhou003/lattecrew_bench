{"type":"tool_use","timestamp":1794041632815,"sessionID":"ses_e4ac9a066ffeyAfkgy12TJiPzo","part":{"type":"tool","tool":"write","callID":"chatcmpl-tool-80cc3bc55bd0cc46","state":{"status":"completed","input":{"filePath":"/home/user/latte-crew/var/worktrees/1107-8fc8f8/ledgerkit/money.py","content":"def split(total_cents, weights):\n    \"\"\"Split an amount between parties in proportion to their weights.\n\n    Uses the largest remainder method with exact integer arithmetic so the\n    results always sum exactly to ``total_cents``.\n    \"\"\"\n    ws = list(weights)\n    if not ws:\n        raise ValueError(\"weights must not be empty\")\n    if any(w < 0 for w in ws):\n        raise ValueError(\"weights must not be negative\")\n    weight_sum = sum(ws)\n    if weight_sum == 0:\n        raise ValueError(\"weights must not all be zero\")\n\n    amount = abs(total_cents)\n    quotients = []\n    remainders = []\n    for w in ws:\n        q, r = divmod(amount * w, weight_sum)\n        quotients.append(q)\n        remainders.append(r)\n\n    leftover = amount - sum(quotients)\n    order = sorted(range(len(ws)), key=lambda i: (-remainders[i], i))\n    for i in order[:leftover]:\n        quotients[i] += 1\n\n    if total_cents < 0:\n        quotients = [-q for q in quotients]\n    return quotients\n"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/home/user/latte-crew/var/worktrees/1107-8fc8f8/ledgerkit/money.py","exists":true,"truncated":false},"title":"ledgerkit/money.py","time":{"start":1794041632803,"end":1794041632813}},"id":"prt_1b536c72b001I5o59mofLhD5r2","sessionID":"ses_e4ac9a066ffeyAfkgy12TJiPzo","messageID":"msg_1b5368a4d001zN22nrSkauE8gE"}}
