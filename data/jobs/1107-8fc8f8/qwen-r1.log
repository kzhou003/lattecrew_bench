{"type":"tool_use","timestamp":1794041640115,"sessionID":"ses_e4ac9a066ffeyAfkgy12TJiPzo","part":{"type":"tool","tool":"write","callID":"chatcmpl-tool-b110e4f3d3a059c2","state":{"status":"completed","input":{"content":"import pytest\n\nfrom ledgerkit.money import split\n\n\ndef test_even_split():\n    assert split(100, [1, 1]) == [50, 50]\n\n\ndef test_largest_remainder_distribution():\n    assert split(100, [1, 1, 1]) == [34, 33, 33]\n\n\ndef test_largest_fractional_remainder_wins():\n    assert split(10, [1, 2, 3]) == [2, 3, 5]\n\n\ndef test_tie_breaks_by_lower_index():\n    assert split(5, [1, 1, 1]) == [2, 2, 1]\n\n\ndef test_negative_total_mirrors_positive_allocation():\n    assert split(-5, [1, 1, 1]) == [-2, -2, -1]\n\n\ndef test_zero_total_returns_all_zeroes():\n    assert split(0, [1, 2, 3]) == [0, 0, 0]\n\n\ndef test_empty_weights_raises():\n    with pytest.raises(ValueError):\n        split(100, [])\n\n\ndef test_negative_weight_raises():\n    with pytest.raises(ValueError):\n        split(100, [1, -2])\n\n\ndef test_all_zero_weights_raise():\n    with pytest.raises(ValueError):\n        split(100, [0, 0, 0])\n\n\ndef test_sum_preserved_positive_uneven():\n    result = split(100, [1, 2, 3])\n    assert result == [2, 3, 5]\n    assert sum(result) == 100\n\n\ndef test_sum_preserved_negative_uneven():\n    result = split(-100, [1, 2, 3])\n    assert result == [-2, -3, -5]\n    assert sum(result) == -100\n","filePath":"/home/user/latte-crew/var/worktrees/1107-8fc8f8/tests/test_money.py"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/home/user/latte-crew/var/worktrees/1107-8fc8f8/tests/test_money.py","exists":true,"truncated":false},"title":"tests/test_money.py","time":{"start":1794041640101,"end":1794041640113}},"id":"prt_1b536db58001OR0sfnVuEFqvQC","sessionID":"ses_e4ac9a066ffeyAfkgy12TJiPzo","messageID":"msg_1b536d881001PDl4bNxg2ekIYG"}}
