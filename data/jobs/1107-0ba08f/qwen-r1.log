{"type":"tool_use","timestamp":1794041251676,"sessionID":"ses_e4ad11da4ffeXSBWqow35RTTrs","part":{"type":"tool","tool":"write","callID":"chatcmpl-tool-bbe5d7f1aa0f841c","state":{"status":"completed","input":{"content":"from datetime import datetime, timedelta, timezone\n\nimport pytest\n\nfrom ledgerkit.slots import free_slots\n\nUTC = timezone.utc\nPLUS2 = timezone(timedelta(hours=2))\nJST = timezone(timedelta(hours=9))\n\n\ndef dt(hour, minute=0, tz=UTC):\n    return datetime(2026, 1, 15, hour, minute, tzinfo=tz)\n\n\ndef test_empty_busy_returns_whole_window():\n    assert free_slots([], dt(9), dt(17)) == [(dt(9), dt(17))]\n\n\ndef test_busy_in_middle_splits_window():\n    free = free_slots([(dt(11), dt(12))], dt(9), dt(13))\n    assert free == [(dt(9), dt(11)), (dt(12), dt(13))]\n\n\ndef test_busy_covers_whole_window():\n    assert free_slots([(dt(8), dt(18))], dt(9), dt(13)) == []\n\n\ndef test_busy_exactly_filling_window():\n    assert free_slots([(dt(9), dt(13))], dt(9), dt(13)) == []\n\n\ndef test_overlapping_busy_intervals_merge():\n    free = free_slots([(dt(10), dt(12)), (dt(11), dt(13))], dt(9), dt(17))\n    assert free == [(dt(9), dt(10)), (dt(13), dt(17))]\n\n\ndef test_unsorted_busy():\n    free = free_slots([(dt(14), dt(15)), (dt(10), dt(11))], dt(9), dt(17))\n    assert free == [(dt(9), dt(10)), (dt(11), dt(14)), (dt(15), dt(17))]\n\n\ndef test_touching_busy_intervals_merge():\n    free = free_slots([(dt(10), dt(11)), (dt(11), dt(12))], dt(9), dt(13))\n    assert free == [(dt(9), dt(10)), (dt(12), dt(13))]\n\n\ndef test_contained_busy_interval_ignored():\n    assert free_slots([(dt(8), dt(18)), (dt(10), dt(11))], dt(9), dt(13)) == []\n\n\ndef test_busy_outside_window_ignored():\n    free = free_slots([(dt(6), dt(7)), (dt(18), dt(19))], dt(9), dt(13))\n    assert free == [(dt(9), dt(13))]\n\n\ndef test_busy_clipped_to_window():\n    free = free_slots([(dt(8), dt(10)), (dt(12), dt(20))], dt(9), dt(13))\n    assert free == [(dt(10), dt(12))]\n\n\ndef test_zero_length_busy_ignored():\n    free = free_slots([(dt(10), dt(10))], dt(9), dt(13))\n    assert free == [(dt(9), dt(13))]\n\n\ndef test_mixed_utc_offsets():\n    # 11:00+02:00 == 09:00 UTC, 13:00+02:00 == 11:00 UTC\n    busy = [(dt(11, tz=PLUS2), dt(13, tz=PLUS2))]\n    free = free_slots(busy, dt(8), dt(12))\n    assert free == [(dt(11), dt(12))]\n\n\ndef test_cross_offset_clipping():\n    # busy 20:00-22:30 JST == 11:00-13:30 UTC, window 12:00-14:00 UTC\n    busy = [\n        (datetime(2026, 1, 15, 20, 0, tzinfo=JST), datetime(2026, 1, 15, 22, 30, tzinfo=JST))\n    ]\n    free = free_slots(busy, dt(12), dt(14))\n    assert free == [(dt(13, 30), dt(14))]\n\n\ndef test_result_expressed_in_day_start_timezone():\n    window_start = datetime(2026, 1, 15, 6, 0, tzinfo=JST)\n    window_end = datetime(2026, 1, 15, 10, 0, tzinfo=JST)\n    busy = [\n        (datetime(2026, 1, 14, 23, 0, tzinfo=UTC), datetime(2026, 1, 15, 0, 0, tzinfo=UTC))\n    ]\n    # busy is 08:00-09:00 JST\n    free = free_slots(busy, window_start, window_end)\n    assert free == [\n        (datetime(2026, 1, 15, 6, 0, tzinfo=JST), datetime(2026, 1, 15, 8, 0, tzinfo=JST)),\n        (datetime(2026, 1, 15, 9, 0, tzinfo=JST), datetime(2026, 1, 15, 10, 0, tzinfo=JST)),\n    ]\n\n\ndef test_min_minutes_filters_short_gaps():\n    busy = [(dt(9, 40), dt(10)), (dt(10, 50), dt(11))]\n    free = free_slots(busy, dt(9), dt(12), min_minutes=30)\n    assert free == [(dt(9), dt(9, 40)), (dt(10), dt(10, 50))]\n\n\ndef test_min_minutes_drops_short_gaps_only():\n    busy = [(dt(9, 30), dt(10)), (dt(10, 45), dt(11))]\n    free = free_slots(busy, dt(9), dt(12), min_minutes=60)\n    assert free == [(dt(11), dt(12))]\n\n\ndef test_min_minutes_exactly_long_enough_kept():\n    free = free_slots([(dt(9), dt(9, 30))], dt(9), dt(11), min_minutes=30)\n    assert free == [(dt(9, 30), dt(11))]\n\n\ndef test_naive_day_start_raises():\n    with pytest.raises(ValueError):\n        free_slots([], datetime(2026, 1, 15, 9), dt(17))\n\n\ndef test_naive_day_end_raises():\n    with pytest.raises(ValueError):\n        free_slots([], dt(9), datetime(2026, 1, 15, 17))\n\n\ndef test_naive_busy_start_raises():\n    with pytest.raises(ValueError):\n        free_slots([(datetime(2026, 1, 15, 10), dt(11))], dt(9), dt(17))\n\n\ndef test_naive_busy_end_raises():\n    with pytest.raises(ValueError):\n        free_slots([(dt(10), datetime(2026, 1, 15, 11))], dt(9), dt(17))\n\n\ndef test_busy_end_before_start_raises():\n    with pytest.raises(ValueError):\n        free_slots([(dt(11), dt(10))], dt(9), dt(17))\n\n\ndef test_day_end_equal_to_start_raises():\n    with pytest.raises(ValueError):\n        free_slots([], dt(9), dt(9))\n\n\ndef test_day_end_before_start_raises():\n    with pytest.raises(ValueError):\n        free_slots([], dt(17), dt(9))\n\n\ndef test_returns_sorted_tuple_list():\n    free = free_slots([(dt(10), dt(11)), (dt(14), dt(15))], dt(9), dt(17))\n    assert isinstance(free, list)\n    assert all(isinstance(item, tuple) and len(item) == 2 for item in free)\n    assert [item[0] for item in free] == sorted(item[0] for item in free)\n","filePath":"/home/user/latte-crew/var/worktrees/1107-0ba08f/tests/test_slots.py"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/home/user/latte-crew/var/worktrees/1107-0ba08f/tests/test_slots.py","exists":false,"truncated":false},"title":"tests/test_slots.py","time":{"start":1794041251670,"end":1794041251675}},"id":"prt_1b5309c56001pcSV3IjbS5Mw1d","sessionID":"ses_e4ad11da4ffeXSBWqow35RTTrs","messageID":"msg_1b5309961001NsRwI1iIQPrBZP"}}
