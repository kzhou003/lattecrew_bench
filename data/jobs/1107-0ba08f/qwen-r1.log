{"type":"tool_use","timestamp":1794041223436,"sessionID":"ses_e4ad11da4ffeXSBWqow35RTTrs","part":{"type":"tool","tool":"write","callID":"chatcmpl-tool-bcda84b5acbfd51b","state":{"status":"completed","input":{"filePath":"/home/user/latte-crew/var/worktrees/1107-0ba08f/ledgerkit/slots.py","content":"from datetime import datetime, timedelta\n\n\ndef free_slots(busy, day_start, day_end, min_minutes=0):\n    \"\"\"Return the free gaps inside [day_start, day_end], in day_start's timezone.\n\n    busy is a list of (start, end) timezone-aware datetimes, possibly\n    overlapping, unsorted, and in different UTC offsets. Gaps are returned as\n    a sorted list of (start, end) tuples, each at least min_minutes long.\n    \"\"\"\n    _require_aware(day_start)\n    _require_aware(day_end)\n    if day_end <= day_start:\n        raise ValueError(\"day_end must be strictly after day_start\")\n\n    min_length = timedelta(minutes=min_minutes)\n    clipped = []\n    for start, end in busy:\n        _require_aware(start)\n        _require_aware(end)\n        if end < start:\n            raise ValueError(\"busy interval end must not be before start\")\n        if end == start:\n            continue\n        s = max(start, day_start)\n        e = min(end, day_end)\n        if s < e:\n            clipped.append((s, e))\n\n    clipped.sort()\n    merged = []\n    for s, e in clipped:\n        if merged and s <= merged[-1][1]:\n            merged[-1] = (merged[-1][0], max(merged[-1][1], e))\n        else:\n            merged.append((s, e))\n\n    tz = day_start.tzinfo\n    free = []\n    cursor = day_start\n    for s, e in merged:\n        if s > cursor:\n            _record(free, cursor, s, tz, min_length)\n        cursor = e\n    if day_end > cursor:\n        _record(free, cursor, day_end, tz, min_length)\n    return free\n\n\ndef _record(free, start, end, tz, min_length):\n    if end - start >= min_length:\n        free.append((start.astimezone(tz), end.astimezone(tz)))\n\n\ndef _require_aware(value):\n    if (\n        not isinstance(value, datetime)\n        or value.tzinfo is None\n        or value.tzinfo.utcoffset(value) is None\n    ):\n        raise ValueError(\"all datetimes must be timezone-aware\")\n"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/home/user/latte-crew/var/worktrees/1107-0ba08f/ledgerkit/slots.py","exists":false,"truncated":false},"title":"ledgerkit/slots.py","time":{"start":1794041223425,"end":1794041223434}},"id":"prt_1b5307a6f001tGHcHxDaBAD23a","sessionID":"ses_e4ad11da4ffeXSBWqow35RTTrs","messageID":"msg_1b5306fe9001atHuJD65L38F8S"}}
