{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_013aAeoQw1ouhsPANtweRaMM","type":"tool_result","content":"diff --git a/ledgerkit/slots.py b/ledgerkit/slots.py\nnew file mode 100644\nindex 0000000..3d95c05\n--- /dev/null\n+++ b/ledgerkit/slots.py\n@@ -0,0 +1,61 @@\n+from datetime import datetime, timedelta\n+\n+\n+def free_slots(busy, day_start, day_end, min_minutes=0):\n+    \"\"\"Return the free gaps inside [day_start, day_end], in day_start's timezone.\n+\n+    busy is a list of (start, end) timezone-aware datetimes, possibly\n+    overlapping, unsorted, and in different UTC offsets. Gaps are returned as\n+    a sorted list of (start, end) tuples, each at least min_minutes long.\n+    \"\"\"\n+    _require_aware(day_start)\n+    _require_aware(day_end)\n+    if day_end <= day_start:\n+        raise ValueError(\"day_end must be strictly after day_start\")\n+\n+    min_length = timedelta(minutes=min_minutes)\n+    clipped = []\n+    for start, end in busy:\n+        _require_aware(start)\n+        _require_aware(end)\n+        if end < start:\n+            raise ValueError(\"busy interval end must not be before start\")\n+        if end == start:\n+            continue\n+        s = max(start, day_start)\n+        e = min(end, day_end)\n+        if s < e:\n+            clipped.append((s, e))\n+\n+    clipped.sort()\n+    merged = []\n+    for s, e in clipped:\n+        if merged and s <= merged[-1][1]:\n+            merged[-1] = (merged[-1][0], max(merged[-1][1], e))\n+        else:\n+            merged.append((s, e))\n+\n+    tz = day_start.tzinfo\n+    free = []\n+    cursor = day_start\n+    for s, e in merged:\n+        if s > cursor:\n+            _record(free, cursor, s, tz, min_length)\n+        cursor = e\n+    if day_end > cursor:\n+        _record(free, cursor, day_end, tz, min_length)\n+    return free\n+\n+\n+def _record(free, start, end, tz, min_length):\n+    if end - start >= min_length:\n+        free.append((start.astimezone(tz), end.astimezone(tz)))\n+\n+\n+def _require_aware(value):\n+    if (\n+        not isinstance(value, datetime)\n+        or value.tzinfo is None\n+        or value.tzinfo.utcoffset(value) is None\n+    ):\n+        raise ValueError(\"all datetimes must be timezone-aware\")\ndiff --git a/tests/test_slots.py b/tests/test_slots.py\nnew file mode 100644\nindex 0000000..bb2e551\n--- /dev/null\n+++ b/tests/test_slots.py\n@@ -0,0 +1,153 @@\n+from datetime import datetime, timedelta, timezone\n+\n+import pytest\n+\n+from ledgerkit.slots import free_slots\n+\n+UTC = timezone.utc\n+PLUS2 = timezone(timedelta(hours=2))\n+JST = timezone(timedelta(hours=9))\n+\n+\n+def dt(hour, minute=0, tz=UTC):\n+    return datetime(2026, 1, 15, hour, minute, tzinfo=tz)\n+\n+\n+def test_empty_busy_returns_whole_window():\n+    assert free_slots([], dt(9), dt(17)) == [(dt(9), dt(17))]\n+\n+\n+def test_busy_in_middle_splits_window():\n+    free = free_slots([(dt(11), dt(12))], dt(9), dt(13))\n+    assert free == [(dt(9), dt(11)), (dt(12), dt(13))]\n+\n+\n+def test_busy_covers_whole_window():\n+    assert free_slots([(dt(8), dt(18))], dt(9), dt(13)) == []\n+\n+\n+def test_busy_exactly_filling_window():\n+    assert free_slots([(dt(9), dt(13))], dt(9), dt(13)) == []\n+\n+\n+def test_overlapping_busy_intervals_merge():\n+    free = free_slots([(dt(10), dt(12)), (dt(11), dt(13))], dt(9), dt(17))\n+    assert free == [(dt(9), dt(10)), (dt(13), dt(17))]\n+\n+\n+def test_unsorted_busy():\n+    free = free_slots([(dt(14), dt(15)), (dt(10), dt(11))], dt(9), dt(17))\n+    assert free == [(dt(9), dt(10)), (dt(11), dt(14)), (dt(15), dt(17))]\n+\n+\n+def test_touching_busy_intervals_merge():\n+    free = free_slots([(dt(10), dt(11)), (dt(11), dt(12))], dt(9), dt(13))\n+    assert free == [(dt(9), dt(10)), (dt(12), dt(13))]\n+\n+\n+def test_contained_busy_interval_ignored():\n+    assert free_slots([(dt(8), dt(18)), (dt(10), dt(11))], dt(9), dt(13)) == []\n+\n+\n+def test_busy_outside_window_ignored():\n+    free = free_slots([(dt(6), dt(7)), (dt(18), dt(19))], dt(9), dt(13))\n+    assert free == [(dt(9), dt(13))]\n+\n+\n+def test_busy_clipped_to_window():\n+    free = free_slots([(dt(8), dt(10)), (dt(12), dt(20))], dt(9), dt(13))\n+    assert free == [(dt(10), dt(12))]\n+\n+\n+def test_zero_length_busy_ignored():\n+    free = free_slots([(dt(10), dt(10))], dt(9), dt(13))\n+    assert free == [(dt(9), dt(13))]\n+\n+\n+def test_mixed_utc_offsets():\n+    # 11:00+02:00 == 09:00 UTC, 13:00+02:00 == 11:00 UTC\n+    busy = [(dt(11, tz=PLUS2), dt(13, tz=PLUS2))]\n+    free = free_slots(busy, dt(8), dt(12))\n+    assert free == [(dt(8), dt(9)), (dt(11), dt(12))]\n+\n+\n+def test_cross_offset_clipping():\n+    # busy 20:00-22:30 JST == 11:00-13:30 UTC, window 12:00-14:00 UTC\n+    busy = [\n+        (datetime(2026, 1, 15, 20, 0, tzinfo=JST), datetime(2026, 1, 15, 22, 30, tzinfo=JST))\n+    ]\n+    free = free_slots(busy, dt(12), dt(14))\n+    assert free == [(dt(13, 30), dt(14))]\n+\n+\n+def test_result_expressed_in_day_start_timezone():\n+    window_start = datetime(2026, 1, 15, 6, 0, tzinfo=JST)\n+    window_end = datetime(2026, 1, 15, 10, 0, tzinfo=JST)\n+    busy = [\n+        (datetime(2026, 1, 14, 23, 0, tzinfo=UTC), datetime(2026, 1, 15, 0, 0, tzinfo=UTC))\n+    ]\n+    # busy is 08:00-09:00 JST\n+    free = free_slots(busy, window_start, window_end)\n+    assert free == [\n+        (datetime(2026, 1, 15, 6, 0, tzinfo=JST), datetime(2026, 1, 15, 8, 0, tzinfo=JST)),\n+        (datetime(2026, 1, 15, 9, 0, tzinfo=JST), datetime(2026, 1, 15, 10, 0, tzinfo=JST)),\n+    ]\n+\n+\n+def test_min_minutes_filters_short_gaps():\n+    busy = [(dt(9, 40), dt(10)), (dt(10, 50), dt(11))]\n+    free = free_slots(busy, dt(9), dt(12), min_minutes=30)\n+    assert free == [(dt(9), dt(9, 40)), (dt(10), dt(10, 50)), (dt(11), dt(12))]\n+\n+\n+def test_min_minutes_drops_short_gaps_only():\n+    busy = [(dt(9, 30), dt(10)), (dt(10, 45), dt(11))]\n+    free = free_slots(busy, dt(9), dt(12), min_minutes=60)\n+    assert free == [(dt(11), dt(12))]\n+\n+\n+def test_min_minutes_exactly_long_enough_kept():\n+    free = free_slots([(dt(9), dt(9, 30))], dt(9), dt(11), min_minutes=30)\n+    assert free == [(dt(9, 30), dt(11))]\n+\n+\n+def test_naive_day_start_raises():\n+    with pytest.raises(ValueError):\n+        free_slots([], datetime(2026, 1, 15, 9), dt(17))\n+\n+\n+def test_naive_day_end_raises():\n+    with pytest.raises(ValueError):\n+        free_slots([], dt(9), datetime(2026, 1, 15, 17))\n+\n+\n+def test_naive_busy_start_raises():\n+    with pytest.raises(ValueError):\n+        free_slots([(datetime(2026, 1, 15, 10), dt(11))], dt(9), dt(17))\n+\n+\n+def test_naive_busy_end_raises():\n+    with pytest.raises(ValueError):\n+        free_slots([(dt(10), datetime(2026, 1, 15, 11))], dt(9), dt(17))\n+\n+\n+def test_busy_end_before_start_raises():\n+    with pytest.raises(ValueError):\n+        free_slots([(dt(11), dt(10))], dt(9), dt(17))\n+\n+\n+def test_day_end_equal_to_start_raises():\n+    with pytest.raises(ValueError):\n+        free_slots([], dt(9), dt(9))\n+\n+\n+def test_day_end_before_start_raises():\n+    with pytest.raises(ValueError):\n+        free_slots([], dt(17), dt(9))\n+\n+\n+def test_returns_sorted_tuple_list():\n+    free = free_slots([(dt(10), dt(11)), (dt(14), dt(15))], dt(9), dt(17))\n+    assert isinstance(free, list)\n+    assert all(isinstance(item, tuple) and len(item) == 2 for item in free)\n+    assert [item[0] for item in free] == sorted(item[0] for item in free)\n..........................                                               [100%]\n26 passed in 0.02s","is_error":false}]},"parent_tool_use_id":null,"session_id":"ab7c1a02-bf9d-4cea-855e-b5cad0e569f1","uuid":"d2214c14-0707-40e3-bc7a-d26d9a625d55","timestamp":"2026-11-07T08:48:04.613Z","tool_use_result":{"stdout":"diff --git a/ledgerkit/slots.py b/ledgerkit/slots.py\nnew file mode 100644\nindex 0000000..3d95c05\n--- /dev/null\n+++ b/ledgerkit/slots.py\n@@ -0,0 +1,61 