44:             self._refill()\n45:             deficit = amount - self._tokens\n46:             if deficit <= 0:\n47:                 return 0.0\n48:             try:\n49:                 seconds = float(deficit / self._rate)\n50:             except OverflowError as exc:\n51:                 raise OverflowError(\"wait_time would overflow\") from exc\n52:             while True:\n53:                 simulated = self._last_time + seconds\n54:                 if not math.isfinite(simulated):\n55:                     raise OverflowError(\"wait_time would overflow\")\n56:                 if simulated == self._last_time:\n57:                     next_time = math.nextafter(self._last_time, math.inf)\n58:                     if not math.isfinite(next_time):\n59:                         raise OverflowError(\"wait_time would overflow\")\n60:                     seconds = next_time - self._last_time\n61:                     continue\n62:                 delta = simulated - self._last_time\n63:                 gained = Fraction(delta) * self._rate if delta > 0 else Fraction(0)\n64:                 if self._tokens + gained >= amount:\n65:                     return seconds\n66:                 seconds = math.nextafter(seconds, math.inf)\n67:                 if not math.isfinite(seconds):\n68:                     raise OverflowError(\"wait_time would overflow\")\n69: \n70:     def _checked_amount(self, n):\n71:         amount = _as_fraction(n, \"n\")\n72:         if amount <= 0:\n73:             raise ValueError(\"n must be positive\")\n74:         if amount > self._capacity:\n75:             raise ValueError(\"n exceeds the bucket capacity\")\n76:         return amount\n77: \n78:     def _refill(self):\n79:         now = float(self._clock())\n80:         if now >= self._last_time:\n81:             delta = now - self._last_time\n82:             if delta == math.inf:\n83:                 self._tokens = self._capacity\n84:             else:\n85:                 gained = Fraction(delta) * self._rate if delta > 0 else Fraction(0)\n86:                 self._tokens = min(self._capacity, self._tokens + gained)\n87:         self._last_time = now\n\n(End of file - total 87 lines)\n</content>","metadata":{"preview":"import math\nimport threading\nimport time\nfrom fractions import Fraction\n\n\ndef _as_fraction(value, name):\n    if isinstance(value, (bool, str, bytes, bytearray)):\n        raise ValueError(f\"{name} must be a real number\")\n    try:\n        result = Fraction(value)\n    except (TypeError, ValueError, OverflowError) as exc:\n        raise ValueError(f\"{name} must be a real number\") from exc\n    if not math.isfinite(result):\n        raise ValueError(f\"{name} must be a real number\")\n    return result\n\n\nclass TokenBucket:\n    def __init__(self, rate, capacity, clock=time.monotonic):","truncated":false,"loaded":[],"display":{"type":"file","path":"/home/user/latte-crew/var/worktrees/1107-8d1f9e/ledgerkit/limiter.py","text":"import math\nimport threading\nimport time\nfrom fractions import Fraction\n\n\ndef _as_fraction(value, name):\n    if isinstance(value, (bool, str, bytes, bytearray)):\n        raise ValueError(f\"{name} must be a real number\")\n    try:\n        result = Fraction(value)\n    except (TypeError, ValueError, OverflowError) as exc:\n        raise ValueError(f\"{name} must be a real number\") from exc\n    if not math.isfinite(result):\n        raise ValueError(f\"{name} must be a real number\")\n    return result\n\n\nclass TokenBucket:\n    def __init__(self, rate, capacity, clock=time.monotonic):\n        self._rate = _as_fraction(rate, \"rate\")\n        if self._rate <= 0:\n            raise ValueError(\"rate must be positive\")\n        self._capacity = _as_fraction(capacity, \"capacity\")\n        if self._capacity <= 0:\n            raise ValueError(\"capacity must be positive\")\n        self._clock = clock\n        self._tokens = self._capacity\n        self._last_time = float(clock())\n        self._lock = threading.Lock()\n\n    def try_acquire(self, n=1):\n        with self._lock:\n            amount = self._checked_amount(n)\n            self._refill()\n            if self._tokens >= amount:\n                self._tokens -= amount\n                return True\n            return False\n\n    def wait_time(self, n=1):\n        with self._lock:\n            amount = self._checked_amount(n)\n            self._refill()\n            deficit = amount - self._tokens\n            if deficit <= 0:\n                return 0.0\n            try:\n                seconds = float(deficit / self._rate)\n            except OverflowError as exc:\n                raise OverflowError(\"wait_time would overflow\") from exc\n            while True:\n                simulated = self._last_time + seconds\n                if not math.isfinite(simulated):\n                    raise OverflowError(\"wait_time would overflow\")\n                if simulated == self._last_time:\n                    next_time = math.nextafter(self._last_time, math.inf)\n                    if not math.isfinite(next_time):\n                        raise OverflowError(\"wait_time would overflow\")\n                    seconds = next_time - self._last_time\n                    continue\n                delta = simulated - self._last_time\n                gained = Fraction(delta) * self._rate if delta > 0 else Fraction(0)\n                if self._tokens + gained >= amount:\n                    return seconds\n                seconds = math.nextafter(seconds, math.inf)\n                if not math.isfinite(seconds):\n                    raise OverflowError(\"wait_time would overflow\")\n\n    def _checked_amount(self, n):\n        amount = _as_fraction(n, \"n\")\n        if amount <= 0:\n            raise ValueError(\"n must be positive\")\n        if amount > self._capacity:\n            raise ValueError(\"n exceeds the bucket capacity\")\n        return amount\n\n    def _refill(self):\n        now = float(self._clock())\n        if now >= self._last_time:\n            delta = now - self._last_time\n            if delta == math.inf:\n                self._tokens = self._capacity\n            else:\n                gained = Fraction(delta) * self._rate if delta > 0 else Fraction(0)\n                self._tokens = min(self._capacity, self._tokens + gained)\n        self._last_time = now","lineStart":1,"lineEnd":87,"totalLines":87,"truncated":false}},"title":"ledgerkit/limiter.py","time":{"start":1794051688385,"end":1794051688395}},"id":"prt_1b5d0454c001oXgM0Fctlqd7Wr","sessionID":"ses_e4a416acfffetoYUwsB6di0P2O","messageID":"msg_1b5d03a23001GN7RXpTVsIERVK"}}
