{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_017wXjASGEew5tg89hi3aFGt","type":"tool_result","content":" ledgerkit/limiter.py  |  87 +++++++++++++++++++\n tests/test_limiter.py | 231 ++++++++++++++++++++++++++++++++++++++++++++++++++\n 2 files changed, 318 insertions(+)\nimport math\nimport threading\nimport time\nfrom fractions import Fraction\n\n\ndef _as_fraction(value, name):\n    if isinstance(value, (bool, str, bytes, bytearray)):\n        raise ValueError(f\"{name} must be a real number\")\n    try:\n        result = Fraction(value)\n    except (TypeError, ValueError, OverflowError) as exc:\n        raise ValueError(f\"{name} must be a real number\") from exc\n    if not math.isfinite(result):\n        raise ValueError(f\"{name} must be a real number\")\n    return result\n\n\nclass TokenBucket:\n    def __init__(self, rate, capacity, clock=time.monotonic):\n        self._rate = _as_fraction(rate, \"rate\")\n        if self._rate <= 0:\n            raise ValueError(\"rate must be positive\")\n        self._capacity = _as_fraction(capacity, \"capacity\")\n        if self._capacity <= 0:\n            raise ValueError(\"capacity must be positive\")\n        self._clock = clock\n        self._tokens = self._capacity\n        self._last_time = float(clock())\n        self._lock = threading.Lock()\n\n    def try_acquire(self, n=1):\n        with self._lock:\n            amount = self._checked_amount(n)\n            self._refill()\n            if self._tokens >= amount:\n                self._tokens -= amount\n                return True\n            return False\n\n    def wait_time(self, n=1):\n        with self._lock:\n            amount = self._checked_amount(n)\n            self._refill()\n            deficit = amount - self._tokens\n            if deficit <= 0:\n                return 0.0\n            try:\n                seconds = float(deficit / self._rate)\n            except OverflowError as exc:\n                raise OverflowE