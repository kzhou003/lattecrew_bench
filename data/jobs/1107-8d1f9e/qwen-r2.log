 not bucket.try_acquire(1)\n\n\ndef test_wait_time_is_zero_when_tokens_are_available():\n    bucket = TokenBucket(rate=1, capacity=10, clock=FakeClock())\n    assert bucket.wait_time(10) == 0.0\n\n\ndef test_wait_time_for_missing_tokens():\n    bucket = TokenBucket(rate=1, capacity=10, clock=FakeClock())\n    assert bucket.try_acquire(10)\n    assert bucket.wait_time(1) == 1.0\n\n\ndef test_wait_time_does_not_consume_tokens():\n    bucket = TokenBucket(rate=1, capacity=10, clock=FakeClock())\n    assert bucket.try_acquire(10)\n    assert bucket.wait_time(1) == 1.0\n    assert not bucket.try_acquire(1)\n    assert bucket.wait_time(1) == 1.0\n\n\ndef test_lazy_refill_before_waiting():\n    clock = FakeClock()\n    bucket = TokenBucket(rate=1, capacity=2, clock=clock)\n    assert bucket.try_acquire(2)\n    clock.t = float(clock.t) + 1.0\n    assert bucket.wait_time(2) == 1.0\n\n\ndef test_advancing_by_wait_time_succeeds():\n    clock = FakeClock()\n    bucket = TokenBucket(rate=2, capacity=10, clock=clock)\n    assert bucket.try_acquire(10)\n    wait = bucket.wait_time(5)\n    assert wait == 2.5\n    clock.t = float(clock.t) + wait\n    assert bucket.try_acquire(5)\n\n\ndef test_wait_time_fractional_rate():\n    clock = FakeClock()\n    bucket = TokenBucket(rate=3, capacity=10, clock=clock)\n    assert bucket.try_acquire(10)\n    wait = bucket.wait_time(1)\n    assert wait >= 1 / 3\n    clock.t = float(clock.t) + wait\n    assert bucket.try_acquire(1)\n\n\ndef test_many_wait_and_acquire_cycles_do_not_drift():\n    clock = FakeClock()\n    bucket = TokenBucket(rate=3, capacity=10, clock=clock)\n    assert bucket.try_acquire(10)\n    for _ in range(100):\n        wait = bucket.wait_time(1)\n        clock.t = float(clock.t) + wait\n        assert bucket.try_acquire(1)\n\n\ndef test_fractional_capacity_and_rate():\n    clock = FakeClock()\n    bucket = TokenBucket(rate=0.5, capacity=1.5, clock=clock)\n    assert bucket.try_acquire(0.75)\n    assert bucket.try_acquire(0.75)\n    assert not bucket.try_acquire(0.25)\n    clock.t = float(clock.t) + 1.0\n    assert bucket.try_acquire(0.5)\n    wait = bucket.wait_time(0.25)\n    assert wait >= 0.5\n    clock.t = float(clock.t) + wait\n    assert bucket.try_acquire(0.25)\n\n\ndef test_fraction_input_values():\n    clock = FakeClock()\n    bucket = TokenBucket(rate=Fraction(1, 3), capacity=Fraction(10), clock=clock)\n    assert bucket.try_acquire(Fraction(10))\n    wait = bucket.wait_time(Fraction(1))\n    assert wait >= Fraction(3, 1)\n    clock.t = float(clock.t) + float(wait)\n    assert bucket.try_acquire(Fraction(1))\n\n\ndef test_clock_going_backward_does_not_refill():\n    clock = FakeClock(10)\n    bucket = TokenBucket(rate=1, capacity=10, clock=clock)\n    assert bucket.try_acquire(10)\n    clock.t = 9.0\n    assert not bucket.try_acquire(1)\n    assert bucket.wait_time(1) == 1.0\n\n\ndef test_default_clock_wait_time_is_reasonable():\n    bucket = TokenBucket(rate=100, capacity=10)\n    assert bucket.try_acquire(10)\n    wait = bucket.wait_time(10)\n    assert 0.0 < wait < 2.0\n\n\ndef test_try_acquire_is_thread_safe():\n    clock = FakeClock()\n    bucket = TokenBucket(rate=1, capacity=1000, clock=clock)\n    results = []\n\n    def worker():\n        local = 0\n        for _ in range(60):\n            if bucket.try_acquire(1):\n                local += 1\n        results.append(local)\n\n    threads = [threading.Thread(target=worker) for _ in range(20)]\n    for thread in threads:\n        thread.start()\n    for thread in threads:\n        thread.join()\n\n    assert sum(results) == 1000\n\n\n@pytest.mark.parametrize(\"rate\", INVALID_NUMBERS)\ndef test_invalid_rate(rate):\n    with pytest.raises(ValueError):\n        TokenBucket(rate=rate, capacity=10, clock=FakeClock())\n\n\n@pytest.mark.parametrize(\"capacity\", INVALID_NUMBERS)\ndef test_invalid_capacity(capacity):\n    with pytest.raises(ValueError):\n        TokenBucket(rate=1, capacity=capacity, clock=FakeClock())\n\n\ndef test_rate_must_be_positive():\n    with pytest.raises(ValueError, match=\"rate must be positive\"):\n        TokenBucket(rate=0, capacity=10, clock=FakeClock())\n\n\ndef test_capacity_must_be_positive():\n    with pytest.raises(ValueError, match=\"capacity must be positive\"):\n        TokenBucket(rate=1, capacity=0, clock=FakeClock())\n\n\n@pytest.mark.parametrize(\"n\", INVALID_NUMBERS)\ndef test_invalid_n(n):\n    bucket = TokenBucket(rate=1, capacity=10, clock=FakeClock())\n    with pytest.raises(ValueError):\n        bucket.try_acquire(n)\n    with pytest.raises(ValueError):\n        bucket.wait_time(n)\n\n\ndef test_n_exceeds_capacity():\n    bucket = TokenBucket(rate=1, capacity=10, clock=FakeClock())\n    with pytest.raises(ValueError, match=\"n exceeds the bucket capacity\"):\n        bucket.try_acquire(10.000000000000002)\n    with pytest.raises(ValueError, match=\"n exceeds the bucket capacity\"):\n        bucket.wait_time(11)\n\n\ndef test_invalid_n_does_not_mutate_bucket():\n    clock = FakeClock()\n    bucket = TokenBucket(rate=1, capacity=10, clock=clock)\n    assert bucket.try_acquire(10)\n    for n in INVALID_NUMBERS:\n        with pytest.raises(ValueError):\n            bucket.try_acquire(n)\n        with pytest.raises(ValueError):\n            bucket.wait_time(n)\n    assert not bucket.try_acquire(1)\n    assert bucket.wait_time(1) == 1.0","lineStart":1,"lineEnd":231,"totalLines":231,"truncated":false}},"title":"tests/test_limiter.py","time":{"start":1794052774543,"end":1794052774552}},"id":"prt_1b5e0d835001GioHsukd6Aqfx8","sessionID":"ses_e4a416acfffetoYUwsB6di0P2O","messageID":"msg_1b5e0c83b0010M17kIWLEdG1ku"}}
