44:             self._refill()\n45:             deficit = amount - self._tokens\n46:             if deficit <= 0:\n47:                 return 0.0\n48:             try:\n49:                 seconds = float(deficit / self._rate)\n50:             except OverflowError as exc:\n51:                 raise OverflowError(\"wait_time would overflow\") from exc\n52:             target = self._last_time + seconds\n53:             if not math.isfinite(target):\n54:                 raise OverflowError(\"wait_time would overflow\")\n55:             while True:\n56:                 if target == self._last_time:\n57:                     target = math.nextafter(self._last_time, math.inf)\n58:                     if not math.isfinite(target):\n59:                         raise OverflowError(\"wait_time would overflow\")\n60:                     continue\n61:                 delta = target - self._last_time\n62:                 now = self._last_time + delta\n63:                 if not math.isfinite(now):\n64:                     raise OverflowError(\"wait_time would overflow\")\n65:                 elapsed = now - self._last_time\n66:                 if not math.isfinite(elapsed):\n67:                     raise OverflowError(\"wait_time would overflow\")\n68:                 if elapsed > 0:\n69:                     gained = Fraction(elapsed) * self._rate\n70:                     if self._tokens + gained >= amount:\n71:                         return delta\n72:                 target = math.nextafter(target, math.inf)\n73:                 if not math.isfinite(target):\n74:                     raise OverflowError(\"wait_time would overflow\")\n75: \n76:     def _checked_amount(self, n):\n77:         amount = _as_fraction(n, \"n\")\n78:         if amount <= 0:\n79:             raise ValueError(\"n must be positive\")\n80:         if amount > self._capacity:\n81:             raise ValueError(\"n exceeds the bucket capacity\")\n82:         return amount\n83: \n84:     def _refill(self):\n85:         now = float(self._clock())\n86:         if now >= self._last_time:\n87:             delta = now - self._last_time\n88:             if delta == math.inf:\n89:                 self._tokens = self._capacity\n90:             else:\n91:                 gained = Fraction(delta) * self._rate if delta > 0 else Fraction(0)\n92:                 self._tokens = min(self._capacity, self._tokens + gained)\n93:         self._last_time = now\n\n(End of file - total 93 lines)\n</content>","metadata":{"preview":"import math\nimport threading\nimport time\nfrom fractions import Fraction\n\n\ndef _as_fraction(value, name):\n    if isinstance(value, (bool, str, bytes, bytearray)):\n        raise ValueError(f\"{name} must be a real number\")\n    try:\n        result = Fraction(value)\n    except (TypeError, ValueError, OverflowError) as exc:\n        raise ValueError(f\"{name} must be a real number\") from exc\n    if not math.isfinite(result):\n        raise ValueError(f\"{name} must be a real number\")\n    return result\n\n\nclass TokenBucket:\n    def __init__(self, rate, capacity, clock=time.monotonic):","truncated":false,"loaded":[],"display":{"type":"file","path":"/home/user/latte-crew/var/worktrees/1107-8d1f9e/ledgerkit/limiter.py","text":"import math\nimport threading\nimport time\nfrom fractions import Fraction\n\n\ndef _as_fraction(value, name):\n    if isinstance(value, (bool, str, bytes, bytearray)):\n        raise ValueError(f\"{name} must be a real number\")\n    try:\n        result = Fraction(value)\n    except (TypeError, ValueError, OverflowError) as exc:\n        raise ValueError(f\"{name} must be a real number\") from exc\n    if not math.isfinite(result):\n        raise ValueError(f\"{name} must be a real number\")\n    return result\n\n\nclass TokenBucket:\n    def __init__(self, rate, capacity, clock=time.monotonic):\n        self._rate = _as_fraction(rate, \"rate\")\n        if self._rate <= 0:\n            raise ValueError(\"rate must be positive\")\n        self._capacity = _as_fraction(capacity, \"capacity\")\n        if self._capacity <= 0:\n            raise ValueError(\"capacity must be positive\")\n        self._clock = clock\n        self._tokens = self._capacity\n        self._last_time = float(clock())\n        self._lock = threading.Lock()\n\n    def try_acquire(self, n=1):\n        with self._lock:\n            amount = self._checked_amount(n)\n            self._refill()\n            if self._tokens >= amount:\n                self._tokens -= amount\n                return True\n            return False\n\n    def wait_time(self, n=1):\n        with self._lock:\n            amount = self._checked_amount(n)\n            self._refill()\n            deficit = amount - self._tokens\n            if deficit <= 0:\n                return 0.0\n            try:\n                seconds = float(deficit / self._rate)\n            except OverflowError as exc:\n                raise OverflowError(\"wait_time would overflow\") from exc\n            target = self._last_time + seconds\n            if not math.isfinite(target):\n                raise OverflowError(\"wait_time would overflow\")\n            while True:\n                if target == self._last_time:\n                    target = math.nextafter(self._last_time, math.inf)\n                    if not math.isfinite(target):\n                        raise OverflowError(\"wait_time would overflow\")\n                    continue\n                delta = target - self._last_time\n                now = self._last_time + delta\n                if not math.isfinite(now):\n                    raise OverflowError(\"wait_time would overflow\")\n                elapsed = now - self._last_time\n                if not math.isfinite(elapsed):\n                    raise OverflowError(\"wait_time would overflow\")\n                if elapsed > 0:\n                    gained = Fraction(elapsed) * self._rate\n                    if self._tokens + gained >= amount:\n                        return delta\n                target = math.nextafter(target, math.inf)\n                if not math.isfinite(target):\n                    raise OverflowError(\"wait_time would overflow\")\n\n    def _checked_amount(self, n):\n        amount = _as_fraction(n, \"n\")\n        if amount <= 0:\n            raise ValueError(\"n must be positive\")\n        if amount > self._capacity:\n            raise ValueError(\"n exceeds the bucket capacity\")\n        return amount\n\n    def _refill(self):\n        now = float(self._clock())\n        if now >= self._last_time:\n            delta = now - self._last_time\n            if delta == math.inf:\n                self._tokens = self._capacity\n            else:\n                gained = Fraction(delta) * self._rate if delta > 0 else Fraction(0)\n                self._tokens = min(self._capacity, self._tokens + gained)\n        self._last_time = now","lineStart":1,"lineEnd":93,"totalLines":93,"truncated":false}},"title":"ledgerkit/limiter.py","time":{"start":1794052773806,"end":1794052773816}},"id":"prt_1b5e0d538001n3svPaETbqKIqQ","sessionID":"ses_e4a416acfffetoYUwsB6di0P2O","messageID":"msg_1b5e0c83b0010M17kIWLEdG1ku"}}
