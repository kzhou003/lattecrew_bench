{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01MCcBSwuZiwnRDtQuJDsgKE","type":"tool_result","content":" ledgerkit/limiter.py  |  93 ++++++++++++++++++\n tests/test_limiter.py | 260 ++++++++++++++++++++++++++++++++++++++++++++++++++\n 2 files changed, 353 insertions(+)\nimport math\nimport threading\nimport time\nfrom fractions import Fraction\n\n\ndef _as_fraction(value, name):\n    if isinstance(value, (bool, str, bytes, bytearray)):\n        raise ValueError(f\"{name} must be a real number\")\n    try:\n        result = Fraction(value)\n    except (TypeError, ValueError, OverflowError) as exc:\n        raise ValueError(f\"{name} must be a real number\") from exc\n    if not math.isfinite(result):\n        raise ValueError(f\"{name} must be a real number\")\n    return result\n\n\nclass TokenBucket:\n    def __init__(self, rate, capacity, clock=time.monotonic):\n        self._rate = _as_fraction(rate, \"rate\")\n        if self._rate <= 0:\n            raise ValueError(\"rate must be positive\")\n        self._capacity = _as_fraction(capacity, \"capacity\")\n        if self._capacity <= 0:\n            raise ValueError(\"capacity must be positive\")\n        self._clock = clock\n        self._tokens = self._capacity\n        self._last_time = float(clock())\n        self._lock = threading.Lock()\n\n    def try_acquire(self, n=1):\n        with self._lock:\n            amount = self._checked_amount(n)\n            self._refill()\n            if self._tokens >= amount:\n                self._tokens -= amount\n                return True\n            return False\n\n    def wait_time(self, n=1):\n        with self._lock:\n            amount = self._checked_amount(n)\n            self._refill()\n            deficit = amount - self._tokens\n            if deficit <= 0:\n                return 0.0\n            try:\n                seconds = float(deficit / self._rate)\n            except OverflowError as exc:\n                raise OverflowError(\"wait_time would overflow\") from exc\n            target = self._last_time + seconds\n            if not math.isfinite(target):\n                raise OverflowError(\"wait_time would overflow\")\n            while True:\n                if target == self._last_time:\n                    target = math.nextafter(self._last_time, math.inf)\n                    if not math.isfinite(target):\n                        raise OverflowError(\"wait_time would overflow\")\n                    continue\n                delta = target - self._last_time\n                now = self._last_time + delta\n                if not math.isfinite(now):\n                    raise OverflowError(\"wait_time would overflow\")\n                elapsed = now - self._last_time\n                if not math.isfinite(elapsed):\n                    raise OverflowError(\"wait_time would overflow\")\n                if elapsed > 0:\n                    gained = Fraction(elapsed) * self._rate\n                    if self._tokens + gained >= amount:\n                        return delta\n                target = math.nextafter(target, math.inf)\n                if not math.isfinite(target):\n                    raise OverflowError(\"wait_time would overflow\")\n\n    def _checked_amount(self, n):\n        amount = _as_fraction(n, \"n\")\n        if amount <= 0:\n            raise ValueError(\"n must be positive\")\n        if amount > self._capacity:\n            raise ValueError(\"n exceeds the bucket capacity\")\n        return amount\n\n    def _refill(self):\n        now = float(self._clock())\n        if now >= self._last_time:\n            delta = now - self._last_time\n            if delta == math.inf:\n                self._tokens = self._capacity\n            else:\n                gained = Fraction(delta) * self._rate if delta > 0 else Fraction(0)\n                self._tokens = min(self._capacity, self._tokens + gained)\n        self._last_time = now\n.....................................