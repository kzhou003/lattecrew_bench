{"type":"tool_use","timestamp":1794042021032,"sessionID":"ses_e4ac4a523ffegYmi27ctWuC1f1","part":{"type":"tool","tool":"write","callID":"chatcmpl-tool-87f5654fa1441f00","state":{"status":"completed","input":{"content":"import threading\n\nimport pytest\n\nfrom ledgerkit.cache import TTLCache\n\n\nclass FakeClock:\n    def __init__(self, now=0.0):\n        self.now = now\n\n    def __call__(self):\n        return self.now\n\n    def advance(self, seconds):\n        self.now += seconds\n\n\ndef test_constructor_rejects_invalid_maxsize():\n    with pytest.raises(ValueError):\n        TTLCache(0, 1.0)\n\n\ndef test_constructor_rejects_invalid_ttl():\n    with pytest.raises(ValueError):\n        TTLCache(4, 0)\n    with pytest.raises(ValueError):\n        TTLCache(4, -1.0)\n\n\ndef test_basic_put_get():\n    cache = TTLCache(3, 10.0, clock=FakeClock())\n    cache.put(\"a\", 1)\n    cache.put(\"b\", 2)\n    assert cache.get(\"a\") == 1\n    assert cache.get(\"b\") == 2\n    assert cache.get(\"missing\") is None\n    assert cache.get(\"missing\", \"fallback\") == \"fallback\"\n    s = cache.stats()\n    assert s[\"hits\"] == 2\n    assert s[\"misses\"] == 2\n    assert s[\"evictions\"] == 0\n\n\ndef test_expiry_boundary_inclusive():\n    clock = FakeClock()\n    cache = TTLCache(2, 1.0, clock=clock)\n    cache.put(\"a\", 1)\n    clock.advance(0.999)\n    assert cache.get(\"a\") == 1\n    clock.advance(0.001)\n    assert cache.get(\"a\") is None\n    assert len(cache) == 0\n\n\ndef test_expired_entries():\n    clock = FakeClock()\n    cache = TTLCache(3, 1.0, clock=clock)\n    cache.put(\"a\", 1)\n    cache.put(\"b\", 2)\n    clock.advance(2.0)\n    assert cache.get(\"a\") is None\n    assert \"a\" not in cache\n    assert len(cache) == 0\n    s = cache.stats()\n    assert s[\"misses\"] == 1\n    assert s[\"evictions\"] == 0\n\n\ndef test_lru_eviction_ordering():\n    clock = FakeClock()\n    cache = TTLCache(2, 100.0, clock=clock)\n    cache.put(\"a\", 1)\n    cache.put(\"b\", 2)\n    cache.get(\"a\")\n    cache.put(\"c\", 3)\n    assert len(cache) == 2\n    assert \"b\" not in cache\n    assert cache.get(\"a\") == 1\n    assert cache.get(\"c\") == 3\n    assert cache.stats()[\"evictions\"] == 1\n\n\ndef test_expired_dropped_before_eviction():\n    clock = FakeClock()\n    cache = TTLCache(2, 1.0, clock=clock)\n    cache.put(\"a\", 1)\n    clock.advance(0.9)\n    cache.put(\"b\", 2)\n    clock.advance(0.2)\n    assert len(cache) == 2\n    cache.put(\"c\", 3)\n    assert \"a\" not in cache\n    assert cache.get(\"b\") == 2\n    assert cache.get(\"c\") == 3\n    assert len(cache) == 2\n    assert cache.stats()[\"evictions\"] == 0\n\n\ndef test_put_existing_key():\n    clock = FakeClock()\n    cache = TTLCache(2, 10.0, clock=clock)\n    cache.put(\"a\", 1)\n    cache.put(\"a\", 10)\n    assert len(cache) == 1\n    assert cache.get(\"a\") == 10\n    s = cache.stats()\n    assert s[\"evictions\"] == 0\n    assert s[\"hits\"] == 1\n\n\ndef test_put_existing_key_refreshes_order():\n    clock = FakeClock()\n    cache = TTLCache(2, 100.0, clock=clock)\n    cache.put(\"a\", 1)\n    cache.put(\"b\", 2)\n    cache.put(\"a\", 10)\n    cache.put(\"c\", 3)\n    assert \"b\" not in cache\n    assert cache.get(\"a\") == 10\n    assert cache.get(\"c\") == 3\n\n\ndef test_put_existing_key_restarts_ttl():\n    clock = FakeClock()\n    cache = TTLCache(2, 1.0, clock=clock)\n    cache.put(\"a\", 1)\n    cache.put(\"b\", 2)\n    clock.advance(0.6)\n    cache.put(\"a\", 10)\n    clock.advance(0.5)\n    assert len(cache) == 1\n    assert cache.get(\"a\") == 10\n    assert cache.get(\"b\") is None\n\n\ndef test_contains_no_side_effects():\n    clock = FakeClock()\n    cache = TTLCache(2, 100.0, clock=clock)\n    cache.put(\"a\", 1)\n    cache.put(\"b\", 2)\n    before = cache.stats()\n    assert \"a\" in cache\n    assert \"z\" not in cache\n    assert cache.stats() == before\n    cache.put(\"c\", 3)\n    assert \"a\" not in cache\n    assert \"b\" in cache\n\n\ndef test_stats_initial_shape():\n    cache = TTLCache(1, 1.0, clock=FakeClock())\n    s = cache.stats()\n    assert s == {\"hits\": 0, \"misses\": 0, \"evictions\": 0}\n    assert set(s) == {\"hits\", \"misses\", \"evictions\"}\n\n\ndef test_concurrent_smoke():\n    cache = TTLCache(8, 60.0)\n    nthreads = 8\n    nops = 500\n    errors = []\n\n    def worker(i):\n        try:\n            for j in range(nops):\n                k = \"k{}\".format((i * 7 + j) % 16)\n                cache.put(k, j)\n                cache.get(k, \"d\")\n                k in cache\n                len(cache)\n                cache.stats()\n        except Exception as e:\n            errors.append(e)\n\n    threads = [threading.Thread(target=worker, args=(i,)) for i in range(nthreads)]\n    for t in threads:\n        t.start()\n    for t in threads:\n        t.join()\n    assert not errors\n    assert len(cache) <= 8\n","filePath":"/home/user/latte-crew/var/worktrees/1107-010944/tests/test_cache.py"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/home/user/latte-crew/var/worktrees/1107-010944/tests/test_cache.py","exists":false,"truncated":false},"title":"tests/test_cache.py","time":{"start":1794042021024,"end":1794042021030}},"id":"prt_1b53c72c8001YxGyO0xa114vgv","sessionID":"ses_e4ac4a523ffegYmi27ctWuC1f1","messageID":"msg_1b53c6c750015EhjnMNtXqKqzt"}}
