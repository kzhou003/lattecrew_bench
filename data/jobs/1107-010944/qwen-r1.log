{"type":"tool_use","timestamp":1794041998363,"sessionID":"ses_e4ac4a523ffegYmi27ctWuC1f1","part":{"type":"tool","tool":"write","callID":"chatcmpl-tool-8c723e53f51fafd8","state":{"status":"completed","input":{"filePath":"/home/user/latte-crew/var/worktrees/1107-010944/ledgerkit/cache.py","content":"\"\"\"Thread-safe LRU cache with per-entry TTL expiry.\"\"\"\n\nimport threading\nimport time\nfrom collections import OrderedDict\n\n\nclass TTLCache:\n    \"\"\"LRU cache where entries expire ttl seconds after their last put.\n\n    All methods are safe to call from multiple threads.\n    \"\"\"\n\n    def __init__(self, maxsize, ttl, clock=time.monotonic):\n        if maxsize < 1:\n            raise ValueError(\"maxsize must be >= 1\")\n        if ttl <= 0:\n            raise ValueError(\"ttl must be > 0\")\n        self._maxsize = maxsize\n        self._ttl = ttl\n        self._clock = clock\n        self._store = OrderedDict()\n        self._lock = threading.RLock()\n        self._hits = 0\n        self._misses = 0\n        self._evictions = 0\n\n    def _purge_expired(self, now):\n        expired = [\n            key\n            for key, (_value, stored_time) in self._store.items()\n            if now - stored_time >= self._ttl\n        ]\n        for key in expired:\n            del self._store[key]\n\n    def put(self, key, value):\n        with self._lock:\n            now = self._clock()\n            self._purge_expired(now)\n            if key in self._store:\n                self._store[key] = (value, now)\n                self._store.move_to_end(key)\n            else:\n                if len(self._store) >= self._maxsize:\n                    self._store.popitem(last=False)\n                    self._evictions += 1\n                self._store[key] = (value, now)\n\n    def get(self, key, default=None):\n        with self._lock:\n            now = self._clock()\n            self._purge_expired(now)\n            if key not in self._store:\n                self._misses += 1\n                return default\n            self._hits += 1\n            self._store.move_to_end(key)\n            value, _stored_time = self._store[key]\n            return value\n\n    def __len__(self):\n        with self._lock:\n            self._purge_expired(self._clock())\n            return len(self._store)\n\n    def __contains__(self, key):\n        with self._lock:\n            self._purge_expired(self._clock())\n            return key in self._store\n\n    def stats(self):\n        with self._lock:\n            self._purge_expired(self._clock())\n            return {\n                \"hits\": self._hits,\n                \"misses\": self._misses,\n                \"evictions\": self._evictions,\n            }\n"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/home/user/latte-crew/var/worktrees/1107-010944/ledgerkit/cache.py","exists":false,"truncated":false},"title":"ledgerkit/cache.py","time":{"start":1794041998342,"end":1794041998352}},"id":"prt_1b53c4916001mezXls9TVibZr2","sessionID":"ses_e4ac4a523ffegYmi27ctWuC1f1","messageID":"msg_1b53b79f9001rTLTkOaWmbYGJy"}}
