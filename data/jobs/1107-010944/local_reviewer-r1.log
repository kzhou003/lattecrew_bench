{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01D2rv2nMBXZc4VjZ7PYEqDS","type":"tool_result","content":"\"\"\"Thread-safe LRU cache with per-entry TTL expiry.\"\"\"\n\nimport threading\nimport time\nfrom collections import OrderedDict\n\n\nclass TTLCache:\n    \"\"\"LRU cache where entries expire ttl seconds after their last put.\n\n    All methods are safe to call from multiple threads.\n    \"\"\"\n\n    def __init__(self, maxsize, ttl, clock=time.monotonic):\n        if maxsize < 1:\n            raise ValueError(\"maxsize must be >= 1\")\n        if ttl <= 0:\n            raise ValueError(\"ttl must be > 0\")\n        self._maxsize = maxsize\n        self._ttl = ttl\n        self._clock = clock\n        self._store = OrderedDict()\n        self._lock = threading.RLock()\n        self._hits = 0\n        self._misses = 0\n        self._evictions = 0\n\n    def _purge_expired(self, now):\n        expired = [\n            key\n            for key, (_value, stored_time) in self._store.items()\n            if now - stored_time >= self._ttl\n        ]\n        for key in expired:\n            del self._store[key]\n\n    def put(self, key, value):\n        with self._lock:\n            now = self._clock()\n            self._purge_expired(now)\n            if key in self._store:\n                self._store[key] = (value, now)\n                self._store.move_to_end(key)\n            else:\n                if len(self._store) >= self._maxsize:\n                    self._store.popitem(last=False)\n                    self._evictions += 1\n                self._store[key] = (value, now)\n\n    def get(self, key, default=None):\n        with self._lock:\n            now = self._clock()\n            self._purge_expired(now)\n            if key not in self._store:\n                self._misses += 1\n                return default\n            self._hits += 1\n            self._store.move_to_end(key)\n            value, _stored_time = self._store[key]\n            return value\n\n    def __len__(self):\n        with self._lock:\n            self._purge_expired(self._clock())\n            return len(self._store)\n\n    def __contains__(self, key):\n        with self._lock:\n            self._purge_expired(self._clock())\n            return key in self._store\n\n    def stats(self):\n        with self._lock:\n            self._purge_expired(self._clock())\n            return {\n                \"hits\": self._hits,\n                \"misses\": self._misses,\n                \"evictions\": self._evictions,\n            }\n..............                                                           [100%]\n14 passed in 0.05s\n181 tests/test_cache.py","is_error":false}]},"parent_tool_use_id":null,"session_id":"3275a93a-4814-493d-b42e-ff32774027f2","uuid":"2baf8657-f37f-49a5-a0f1-e929e12c9f11","timestamp":"2026-11-07T09:01:03.236Z","tool_use_result":{"stdout":"\"\"\"Thread-safe LRU cache with per-entry TTL expiry.\"\"\"\n\nimport threading\nimport time\nfrom collections import OrderedDict\n\n\nclass TTLCache:\n    \"\"\"LRU cache where entries expire ttl seconds after their last put.\n\n    All methods are safe to call from multiple threads.\n    \"\"\"\n\n    def __init__(self, maxsize, ttl, clock=time.monotonic):\n        if maxsize < 1:\n            raise ValueError(\"maxsize must be >= 1\")\n        if ttl <= 0:\n            raise ValueError(\"ttl must be > 0\")\n        self._maxsize = maxsize\n        self._ttl = ttl\n        self._clock = clock\n        self._store = OrderedDict()\n        self._lock = threading.RLock()\n        self._hits = 0\n        self._misses = 0\n        self._evictions = 0\n\n    def _purge_expired(self, now):\n        expired = [\n            key\n            for key, (_value, stored_time) in self._store.items()\n            if now - stored_time >= self._ttl\n        ]\n        for key in expired:\n            del self._store[key]\n\n    def put(self, key, value):\n        with self._lock