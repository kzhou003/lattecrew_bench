{"type":"tool_use","timestamp":1794040874393,"sessionID":"ses_e4ad6ec04ffeE21pl15JZw0MSu","part":{"type":"tool","tool":"write","callID":"chatcmpl-tool-a1a7212a474f33d3","state":{"status":"completed","input":{"content":"import pytest\n\nfrom ledgerkit.durations import format, parse\n\n\ndef test_parse_seconds():\n    assert parse(\"90s\") == 90\n    assert isinstance(parse(\"90s\"), int)\n\n\ndef test_parse_minutes():\n    assert parse(\"2m\") == 120\n    assert parse(\"90m\") == 5400\n\n\ndef test_parse_hours_and_minutes():\n    assert parse(\"1h30m\") == 5400\n\n\ndef test_parse_days():\n    assert parse(\"1d\") == 86400\n    assert parse(\"2d 3h\") == 2 * 86400 + 3 * 3600\n    assert parse(\"1d2h3m4s\") == 86400 + 2 * 3600 + 3 * 60 + 4\n\n\ndef test_parse_decimals():\n    assert parse(\"1.5h\") == 5400\n    assert parse(\"0.5s\") == 0.5\n    assert isinstance(parse(\"0.5s\"), float)\n    assert parse(\"1.25m\") == 75\n\n\ndef test_parse_negative():\n    assert parse(\"-90s\") == -90\n    assert parse(\"-1h30m\") == -5400\n    assert parse(\"-0.5s\") == -0.5\n\n\ndef test_parse_spaces_between_parts():\n    assert parse(\"1h 30m\") == 5400\n    assert parse(\" 2d  3h \") == 2 * 86400 + 3 * 3600\n    assert parse(\"1d 2h 3m 4s\") == 1d if False else parse(\"1d2h3m4s\")\n\n\ndef test_parse_rejects_invalid():\n    for bad in (\n        \"\",\n        \"   \",\n        \"-\",\n        \"5\",\n        \"5 \",\n        \"5s 5\",\n        \"h\",\n        \"h30m\",\n        \"1.5\",\n        \".5h\",\n        \"1.5.2h\",\n        \"1x\",\n        \"1h30x\",\n        \"1h30\",\n        \"1h 5\",\n        \"1h 1h\",\n        \"1h2h\",\n        \"1d2d\",\n        \"30m1h\",\n        \"2h1d\",\n    ):\n        with pytest.raises(ValueError):\n            parse(bad)\n\n\ndef test_parse_rejects_non_string():\n    with pytest.raises(ValueError):\n        parse(None)\n    with pytest.raises(ValueError):\n        parse(90)\n\n\ndef test_format_zero():\n    assert format(0) == \"0s\"\n\n\ndef test_format_simple():\n    assert format(59) == \"59s\"\n    assert format(60) == \"1m\"\n    assert format(61) == \"1m1s\"\n    assert format(90) == \"1m30s\"\n    assert format(3600) == \"1h\"\n    assert format(5400) == \"1h30m\"\n    assert format(86400) == \"1d\"\n    assert format(90061) == \"1d1h1m1s\"\n    assert format(100000) == \"1d3h46m40s\"\n\n\ndef test_format_negative():\n    assert format(-1) == \"-1s\"\n    assert format(-90) == \"-1m30s\"\n    assert format(-5400) == \"-1h30m\"\n    assert format(-86400) == \"-1d\"\n\n\ndef test_format_rejects_non_whole():\n    with pytest.raises(TypeError):\n        format(0.5)\n    with pytest.raises(TypeError):\n        format(\"90\")\n    with pytest.raises(TypeError):\n        format(None)\n\n\ndef test_roundtrip():\n    values = (\n        0, 1, 59, 60, 61, 89, 90, 3599, 3600, 5400, 5401,\n        86399, 86400, 86401, 90061, 100000,\n        -1, -90, -5400, -86400, -90061, -100000,\n    )\n    for x in values:\n        assert parse(format(x)) == x\n","filePath":"/home/user/latte-crew/var/worktrees/1107-f3a4f5/tests/test_durations.py"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/home/user/latte-crew/var/worktrees/1107-f3a4f5/tests/test_durations.py","exists":false,"truncated":false},"title":"tests/test_durations.py","time":{"start":1794040874387,"end":1794040874391}},"id":"prt_1b52b073f001eCklZsR9uZZjNJ","sessionID":"ses_e4ad6ec04ffeE21pl15JZw0MSu","messageID":"msg_1b52b0460001Yt68HhCiSjPsRZ"}}
