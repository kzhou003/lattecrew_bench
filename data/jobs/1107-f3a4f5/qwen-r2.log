    if total == int(total):\n51:         return int(total)\n52:     return total\n53: \n54: \n55: def format(seconds):\n56:     \"\"\"Format a whole number of seconds as the canonical '1h30m' form.\n57: \n58:     Zero parts are omitted, zero is '0s', and negative values get a\n59:     leading '-'.\n60:     \"\"\"\n61:     if isinstance(seconds, bool) or not isinstance(seconds, (int, float)):\n62:         raise TypeError(\"seconds must be a whole number of seconds\")\n63:     if not float(seconds).is_integer():\n64:         raise TypeError(\"seconds must be a whole number of seconds\")\n65:     value = int(seconds)\n66:     sign = \"-\" if value < 0 else \"\"\n67:     n = abs(value)\n68:     days, rem = divmod(n, 86400)\n69:     hours, rem = divmod(rem, 3600)\n70:     minutes, secs = divmod(rem, 60)\n71:     parts = []\n72:     if days:\n73:         parts.append(f\"{days}d\")\n74:     if hours:\n75:         parts.append(f\"{hours}h\")\n76:     if minutes:\n77:         parts.append(f\"{minutes}m\")\n78:     if secs or not parts:\n79:         parts.append(f\"{secs}s\")\n80:     return sign + \"\".join(parts)\n\n(End of file - total 80 lines)\n</content>","metadata":{"preview":"import re\n\n_UNITS = {\n    \"d\": 86400,\n    \"h\": 3600,\n    \"m\": 60,\n    \"s\": 1,\n}\n\n_ORDER = \"dhms\"\n\n_PART = re.compile(r\"(\\d+(?:\\.\\d+)?)([dhms])\")\n\n\ndef parse(text):\n    \"\"\"Parse a duration like '1h30m' or '2d 3h' into seconds.\n\n    Units d, h, m, s must be written largest to smallest, each at most\n    once, with optional spaces between parts. A leading '-' negates the\n    whole value. Returns an int when the value is whole, else a float.","truncated":false,"loaded":[],"display":{"type":"file","path":"/home/user/latte-crew/var/worktrees/1107-f3a4f5/ledgerkit/durations.py","text":"import re\n\n_UNITS = {\n    \"d\": 86400,\n    \"h\": 3600,\n    \"m\": 60,\n    \"s\": 1,\n}\n\n_ORDER = \"dhms\"\n\n_PART = re.compile(r\"(\\d+(?:\\.\\d+)?)([dhms])\")\n\n\ndef parse(text):\n    \"\"\"Parse a duration like '1h30m' or '2d 3h' into seconds.\n\n    Units d, h, m, s must be written largest to smallest, each at most\n    once, with optional spaces between parts. A leading '-' negates the\n    whole value. Returns an int when the value is whole, else a float.\n    \"\"\"\n    if not isinstance(text, str):\n        raise ValueError(\"duration text must be a string\")\n    s = text.strip()\n    if not s:\n        raise ValueError(\"duration text is empty\")\n    negative = s.startswith(\"-\")\n    if negative:\n        s = s[1:]\n    if not s:\n        raise ValueError(f\"invalid duration {text!r}\")\n    total = 0.0\n    prev_order = -1\n    i = 0\n    while i < len(s):\n        if s[i].isspace():\n            i += 1\n            continue\n        match = _PART.match(s, i)\n        if match is None:\n            raise ValueError(f\"invalid duration {text!r}\")\n        order = _ORDER.index(match.group(2))\n        if order <= prev_order:\n            raise ValueError(f\"invalid duration {text!r}\")\n        prev_order = order\n        total += float(match.group(1)) * _UNITS[match.group(2)]\n        i = match.end()\n    if negative:\n        total = -total\n    if total == int(total):\n        return int(total)\n    return total\n\n\ndef format(seconds):\n    \"\"\"Format a whole number of seconds as the canonical '1h30m' form.\n\n    Zero parts are omitted, zero is '0s', and negative values get a\n    leading '-'.\n    \"\"\"\n    if isinstance(seconds, bool) or not isinstance(seconds, (int, float)):\n        raise TypeError(\"seconds must be a whole number of seconds\")\n    if not float(seconds).is_integer():\n        raise TypeError(\"seconds must be a whole number of seconds\")\n    value = int(seconds)\n    sign = \"-\" if value < 0 else \"\"\n    n = abs(value)\n    days, rem = divmod(n, 86400)\n    hours, rem = divmod(rem, 3600)\n    minutes, secs = divmod(rem, 60)\n    parts = []\n    if days:\n        parts.append(f\"{days}d\")\n    if hours:\n        parts.append(f\"{hours}h\")\n    if minutes:\n        parts.append(f\"{minutes}m\")\n    if secs or not parts:\n        parts.append(f\"{secs}s\")\n    return sign + \"\".join(parts)","lineStart":1,"lineEnd":80,"totalLines":80,"truncated":false}},"title":"ledgerkit/durations.py","time":{"start":1794040924654,"end":1794040924671}},"id":"prt_1b52c07720013X1esZ08y4s3lr","sessionID":"ses_e4ad6ec04ffeE21pl15JZw0MSu","messageID":"msg_1b52bc6a9001YH6Mjt1mbZFag2"}}
