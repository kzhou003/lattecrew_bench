{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01LuxbFwC38uABWVxpsbMyAf","type":"tool_result","content":"diff --git a/ledgerkit/durations.py b/ledgerkit/durations.py\nnew file mode 100644\nindex 0000000..3cfcd2b\n--- /dev/null\n+++ b/ledgerkit/durations.py\n@@ -0,0 +1,81 @@\n+import re\n+from fractions import Fraction\n+\n+_UNITS = {\n+    \"d\": 86400,\n+    \"h\": 3600,\n+    \"m\": 60,\n+    \"s\": 1,\n+}\n+\n+_ORDER = \"dhms\"\n+\n+_PART = re.compile(r\"([0-9]+(?:\\.[0-9]+)?)([dhms])\")\n+\n+\n+def parse(text):\n+    \"\"\"Parse a duration like '1h30m' or '2d 3h' into seconds.\n+\n+    Units d, h, m, s must be written largest to smallest, each at most\n+    once, with optional spaces between parts. A leading '-' negates the\n+    whole value. Returns an int when the value is whole, else a float.\n+    \"\"\"\n+    if not isinstance(text, str):\n+        raise ValueError(\"duration text must be a string\")\n+    s = text.strip()\n+    if not s:\n+        raise ValueError(\"duration text is empty\")\n+    negative = s.startswith(\"-\")\n+    if negative:\n+        s = s[1:]\n+    if not s:\n+        raise ValueError(f\"invalid duration {text!r}\")\n+    total = Fraction(0)\n+    prev_order = -1\n+    i = 0\n+    while i < len(s):\n+        if s[i].isspace():\n+            i += 1\n+            continue\n+        match = _PART.match(s, i)\n+        if match is None:\n+            raise ValueError(f\"invalid duration {text!r}\")\n+        order = _ORDER.index(match.group(2))\n+        if order <= prev_order:\n+            raise ValueError(f\"invalid duration {text!r}\")\n+        prev_order = order\n+        total += Fraction(match.group(1)) * _UNITS[match.group(2)]\n+        i = match.end()\n+    if negative:\n+        total = -total\n+    if total.denominator == 1:\n+        return int(total)\n+    return float(total)\n+\n+\n+def format(seconds):\n+    \"\"\"Format a whole number of seconds as the canonical '1h30m' form.\n+\n+    Zero parts are omitted, zero is '0s', and negative values get a\n+    leading '-'.\n+    \"\"\"\n+    if isinstance(seconds, bool) or not isinstance(seconds, (int, float)):\n+        raise TypeError(\"seconds must be a whole number of seconds\")\n+    if not float(seconds).is_integer():\n+        raise TypeError(\"seconds must be a whole number of seconds\")\n+    value = int(seconds)\n+    sign = \"-\" if value < 0 else \"\"\n+    n = abs(value)\n+    days, rem = divmod(n, 86400)\n+    hours, rem = divmod(rem, 3600)\n+    minutes, secs = divmod(rem, 60)\n+    parts = []\n+    if days:\n+        parts.append(f\"{days}d\")\n+    if hours:\n+        parts.append(f\"{hours}h\")\n+    if minutes:\n+        parts.append(f\"{minutes}m\")\n+    if secs or not parts:\n+        parts.append(f\"{secs}s\")\n+    return sign + \"\".join(parts)\ndiff --git a/tests/test_durations.py b/tests/test_durations.py\nnew file mode 100644\nindex 0000000..8c8eb48\n--- /dev/null\n+++ b/tests/test_durations.py\n@@ -0,0 +1,128 @@\n+import pytest\n+\n+from ledgerkit.durations import format, parse\n+\n+\n+def test_parse_seconds():\n+    assert parse(\"90s\") == 90\n+    assert isinstance(parse(\"90s\"), int)\n+\n+\n+def test_parse_minutes():\n+    assert parse(\"2m\") == 120\n+    assert parse(\"90m\") == 5400\n+\n+\n+def test_parse_hours_and_minutes():\n+    assert parse(\"1h30m\") == 5400\n+\n+\n+def test_parse_days():\n+    assert parse(\"1d\") == 86400\n+    assert parse(\"2d 3h\") == 2 * 86400 + 3 * 3600\n+    assert parse(\"1d2h3m4s\") == 86400 + 2 * 3600 + 3 * 60 + 4\n+\n+\n+def test_parse_decimals():\n+    assert parse(\"1.5h\") == 5400\n+    assert parse(\"0.5s\") == 0.5\n+    assert isinstance(parse(\"0.5s\"), float)\n+    assert parse(\"1.25m\") == 75\n+\n+\n+def test_parse_decimal_whole_values_are_int():\n+    assert parse(\"0.7d\") == 60480\n+    assert isinstance(parse(\"0.7d\"), int)\n+    assert parse(\"0.1d\") == 8640\n+    assert parse(\"2.3h\") == 8280\n+    assert parse(\"1.1h2.3m\") == 4098\n+    assert isinstance(parse(\"1.1h2.3m\"), int)\n+\n+\n+def test_parse_negative():\n+    assert parse(\"-90s\") == -90\n+    assert parse(\"-1h30m\") == -5400\n+    assert parse(\"-0.5s\") == -0.5\n+\n+\n+def test_parse_spaces_between_parts():\n+    assert parse(\"1h 30m\") == 5400\n+    assert parse(\" 2d  3h \") == 2 * 86400 + 3 * 3600\n+    assert parse(\"1d 2h 3m 4s\") == parse(\"1d2h3m4s\")\n+\n+\n+def test_parse_rejects_invalid():\n+    for bad in (\n+        \"\",\n+        \"   \",\n+        \"-\",\n+        \"5\",\n+        \"5 \",\n+        \"5s 5\",\n+        \"h\",\n+        \"h30m\",\n+        \"1.5\",\n+        \".5h\",\n+        \"1.5.2h\",\n+        \"1x\",\n+        \"1h30x\",\n+        \"1h30\",\n+        \"1h 5\",\n+        \"1h 1h\",\n+        \"1h2h\",\n+        \"1d2d\",\n+        \"30m1h\",\n+        \"2h1d\",\n+        \"\\u0663s\",\n+    ):\n+        with pytest.raises(ValueError):\n+            parse(bad)\n+\n+\n+def test_parse_rejects_non_string():\n+    with pytest.raises(ValueError):\n+        parse(None)\n+    with pytest.raises(ValueError):\n+        parse(90)\n+\n+\n+def test_format_zero():\n+    assert format(0) == \"0s\"\n+\n+\n+def test_format_simple():\n+    assert format(59) == \"59s\"\n+    assert format(60) == \"1m\"\n+    assert format(61) == \"1m1s\"\n+    assert format(90) == \"1m30s\"\n+    assert format(3600) == \"1h\"\n+    assert format(5400) == \"1h30m\"\n+    assert format(86400) == \"1d\"\n+    assert format(90061) == \"1d1h1m1s\"\n+    assert format(100000) == \"1d3h46m40s\"\n+\n+\n+def test_format_negative():\n+    assert format(-1) == \"-1s\"\n+    assert format(-90) == \"-1m30s\"\n+    assert format(-5400) == \"-1h30m\"\n+    assert format(-86400) == \"-1d\"\n+\n+\n+def test_format_rejects_non_whole():\n+    with pytest.raises(TypeError):\n+        format(0.5)\n+    with pytest.raises(TypeError):\n+        format(\"90\")\n+    with pytest.raises(TypeError):\n+        format(None)\n+\n+\n+def test_roundtrip():\n+    values = (\n+        0, 1, 59, 60, 61, 89, 90, 3599, 3600, 5400, 5401,\n+        86399, 86400, 86401, 90061, 100000,\n+        -1, -90, -5400, -86400, -90061, -100000,\n+    )\n+    for x in values:\n+        assert parse(format(x)) == x\n................                                                         [100%]\n16 passed in 0.02s","is_error":false}]},"parent_tool_use_id":null,"session_id":"d7dbdf69-ab34-40b9-9416-ea07bf384c28","uuid":"dc0c195b-2797-49b5-9ffd-5c877a418815","timestamp":"2026-11-07T08:42:47.509Z","tool_use_result":{"stdout":"diff --git a/ledgerkit/durations.py b/ledgerkit/durations.py\nnew file mode 100644\nindex 0000000..3cfcd2b\n--- /dev/null\n+++ b/ledgerkit/durations.py\n@@ -0,0 +1,81 @@\n+import re\n+from fractions import Fraction\n+\n+_UNITS = {\n+    \"d\": 86400,\n+    \"h\": 3600,\n+    \"m\": 60,\n+    \"s\": 1,\n+}\n+\n+_ORDER = \"dhms\"\n+\n+_PART = re.compile(r\"([0-9]+(?:\\.[0-9]+)?)([dhms])\")\n+\n+\n+def parse(text):\n+    \"\"\"Parse a duration like '1h30m' or '2d 3h' into seconds.\n+\n+    Units d, h, m, s must be written largest to smallest, each at most\n+    once, with optional spaces between parts. A leading '-' negates the\n+    whole value. Returns an int when the value is whole, else a float.\n+    \"\"\"\n+    if not isinstance(text, str):\n+        raise ValueError(\"duration text must be a string\")\n+    s = text.strip()\n+    if not s:\n+        raise ValueError(\"duration text is empty\")\n+    negative = s.startswith(\"-\")\n+    if negative:\n+        s = s[1:]\n+    if not s:\n+        raise ValueError(f\"invalid duration {text!r}\")\n+    total = Fraction(0)\n+    prev_order = -1\n+    i = 0\n+    while i < len(s):\n+        if s[i].isspace():\n+            i += 1\n+            continue\n+        match = _PART.match(s, i)\n+        if match is None:\n+            raise ValueError(f\"invalid duration {text!r}\")\n+        order = _ORDER.index(match.group(2))\n+        if order <= prev_order:\n+     