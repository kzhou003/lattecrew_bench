rt datetime, timedelta, timezone\nfrom zoneinfo import ZoneInfo\n\nny_zone = ZoneInfo('America/New_York')\nedt = timezone(timedelta(hours=-4))\nUTC = timezone.utc\n\na = datetime(2025, 11, 2, 1, 30, tzinfo=ny_zone)\nb = datetime(2025, 11, 2, 1, 30, tzinfo=edt)\n\n# Compare UTC representations\na_utc = a.astimezone(UTC)\nb_utc = b.astimezone(UTC)\nprint('a_utc == b_utc:', a_utc == b_utc)\n\n# Compare offsets\nprint('a.utcoffset() == b.utcoffset():', a.utcoffset() == b.utcoffset())\nprint('a.utcoffset():', repr(a.utcoffset()))\nprint('b.utcoffset():', repr(b.utcoffset()))\n\n# Compare naive parts after offset adjustment\nprint('a naive + offset:', a.replace(tzinfo=None) + a.utcoffset())\nprint('b naive + offset:', b.replace(tzinfo=None) + b.utcoffset())\n\n# Direct comparison of the underlying _cmp\nprint()\nprint('Python version:')\nimport sys\nprint(sys.version)\n\"\n","time":{"start":1794047199602,"end":1794047199647}},"id":"prt_1b58bb761001zXXGuyvI2SfAtu","sessionID":"ses_e4a838527ffe8oucTkjfNF4FOG","messageID":"msg_1b58b8202001J142eZSaLXFVE1"}}
