{"type":"tool_use","timestamp":1794047010429,"sessionID":"ses_e4a838527ffe8oucTkjfNF4FOG","part":{"type":"tool","tool":"read","callID":"chatcmpl-tool-ab5e0f49cfc58617","state":{"status":"completed","input":{"filePath":"/home/user/latte-crew/var/worktrees/1107-b2704c/ledgerkit/slots.py"},"output":"<path>/home/user/latte-crew/var/worktrees/1107-b2704c/ledgerkit/slots.py</path>\n<type>file</type>\n<content>\n1: \"\"\"Compute free time gaps in a day, given busy intervals.\"\"\"\n2: \n3: from datetime import timezone\n4: \n5: UTC = timezone.utc\n6: \n7: \n8: def free_slots(busy, day_start, day_end, min_minutes=0):\n9:     \"\"\"Return free gaps in [day_start, day_end] not covered by `busy`.\n10: \n11:     `busy` is a list of (start, end) pairs of timezone-aware datetimes.\n12:     All interval math (clip, sort, merge, gaps, durations) is done in UTC\n13:     so that DST transitions measure real elapsed time. Gaps shorter than\n14:     `min_minutes` are dropped. The result is sorted, in day_start's\n15:     timezone.\n16:     \"\"\"\n17:     if _is_naive(day_start) or _is_naive(day_end):\n18:         raise ValueError(\"day_start and day_end must be timezone-aware\")\n19:     if day_end <= day_start:\n20:         raise ValueError(\"day_end must be strictly after day_start\")\n21: \n22:     min_seconds = min_minutes * 60\n23:     start_utc = day_start.astimezone(UTC)\n24:     end_utc = day_end.astimezone(UTC)\n25: \n26:     clipped = []\n27:     for start, end in busy:\n28:         if _is_naive(start) or _is_naive(end):\n29:             raise ValueError(\"busy intervals must use timezone-aware datetimes\")\n30:         if end < start:\n31:             raise ValueError(\"busy interval end must not be before start\")\n32:         s = max(start.astimezone(UTC), start_utc)\n33:         e = min(end.astimezone(UTC), end_utc)\n34:         if e > s:\n35:             clipped.append((s, e))\n36: \n37:     clipped.sort()\n38:     merged = []\n39:     for s, e in clipped:\n40:         if merged and s <= merged[-1][1]:\n41:             merged[-1] = (merged[-1][0], max(merged[-1][1], e))\n42:         else:\n43:             merged.append((s, e))\n44: \n45:     gaps = []\n46:     cursor = start_utc\n47:     for s, e in merged:\n48:         if s > cursor:\n49:             gaps.append((cursor, s))\n50:         cursor = e\n51:     if end_utc > cursor:\n52:         gaps.append((cursor, end_utc))\n53: \n54:     return [\n55:         (s.astimezone(day_start.tzinfo), e.astimezone(day_start.tzinfo))\n56:         for s, e in gaps\n57:         if (e - s).total_seconds() >= min_seconds\n58:     ]\n59: \n60: \n61: def _is_naive(dt):\n62:     return dt.tzinfo is None or dt.tzinfo.utcoffset(dt) is None\n\n(End of file - total 62 lines)\n</content>","metadata":{"preview":"\"\"\"Compute free time gaps in a day, given busy intervals.\"\"\"\n\nfrom datetime import timezone\n\nUTC = timezone.utc\n\n\ndef free_slots(busy, day_start, day_end, min_minutes=0):\n    \"\"\"Return free gaps in [day_start, day_end] not covered by `busy`.\n\n    `busy` is a list of (start, end) pairs of timezone-aware datetimes.\n    All interval math (clip, sort, merge, gaps, durations) is done in UTC\n    so that DST transitions measure real elapsed time. Gaps shorter than\n    `min_minutes` are dropped. The result is sorted, in day_start's\n    timezone.\n    \"\"\"\n    if _is_naive(day_start) or _is_naive(day_end):\n        raise ValueError(\"day_start and day_end must be timezone-aware\")\n    if day_end <= day_start:\n        raise ValueError(\"day_end must be strictly after day_start\")","truncated":false,"loaded":[],"display":{"type":"file","path":"/home/user/latte-crew/var/worktrees/1107-b2704c/ledgerkit/slots.py","text":"\"\"\"Compute free time gaps in a day, given busy intervals.\"\"\"\n\nfrom datetime import timezone\n\nUTC = timezone.utc\n\n\ndef free_slots(busy, day_start, day_end, min_minutes=0):\n    \"\"\"Return free gaps in [day_start, day_end] not covered by `busy`.\n\n    `busy` is a list of (start, end) pairs of timezone-aware datetimes.\n    All interval math (clip, sort, merge, gaps, durations) is done in UTC\n    so that DST transitions measure real elapsed time. Gaps shorter than\n    `min_minutes` are dropped. The result is sorted, in day_start's\n    timezone.\n    \"\"\"\n    if _is_naive(day_start) or _is_naive(day_end):\n        raise ValueError(\"day_start and day_end must be timezone-aware\")\n    if day_end <= day_start:\n        raise ValueError(\"day_end must be strictly after day_start\")\n\n    min_seconds = min_minutes * 60\n    start_utc = day_start.astimezone(UTC)\n    end_utc = day_end.astimezone(UTC)\n\n    clipped = []\n    for start, end in busy:\n        if _is_naive(start) or _is_naive(end):\n            raise ValueError(\"busy intervals must use timezone-aware datetimes\")\n        if end < start:\n            raise ValueError(\"busy interval end must not be before start\")\n        s = max(start.astimezone(UTC), start_utc)\n        e = min(end.astimezone(UTC), end_utc)\n        if e > s:\n            clipped.append((s, e))\n\n    clipped.sort()\n    merged = []\n    for s, e in clipped:\n        if merged and s <= merged[-1][1]:\n            merged[-1] = (merged[-1][0], max(merged[-1][1], e))\n        else:\n            merged.append((s, e))\n\n    gaps = []\n    cursor = start_utc\n    for s, e in merged:\n        if s > cursor:\n            gaps.append((cursor, s))\n        cursor = e\n    if end_utc > cursor:\n        gaps.append((cursor, end_utc))\n\n    return [\n        (s.astimezone(day_start.tzinfo), e.astimezone(day_start.tzinfo))\n        for s, e in gaps\n        if (e - s).total_seconds() >= min_seconds\n    ]\n\n\ndef _is_naive(dt):\n    return dt.tzinfo is None or dt.tzinfo.utcoffset(dt) is None","lineStart":1,"lineEnd":62,"totalLines":62,"truncated":false}},"title":"ledgerkit/slots.py","time":{"start":1794047010415,"end":1794047010427}},"id":"prt_1b588e415001VP4OIbbcQu8jnP","sessionID":"ses_e4a838527ffe8oucTkjfNF4FOG","messageID":"msg_1b58886ce001pRmKwQ4vu1k7s2"}}
{"type":"tool_use","timestamp":1794047011139,"sessionID":"ses_e4a838527ffe8oucTkjfNF4FOG","part":{"type":"tool","tool":"read","callID":"chatcmpl-tool-9c17d18b5c5c6d74","state":{"status":"completed","input":{"filePath":"/home/user/latte-crew/var/worktrees/1107-b2704c/tests/test_slots.py"},"output":"<path>/home/user/latte-crew/var/worktrees/1107-b2704c/tests/test_slots.py</path>\n<type>file</type>\n<content>\n1: from datetime import datetime, timedelta, timezone, tzinfo\n2: from zoneinfo import ZoneInfo\n3: \n4: import pytest\n5: \n6: from ledgerkit.slots import free_slots\n7: \n8: UTC = timezone.utc\n9: JST = timezone(timedelta(hours=9))\n10: NY = timezone(timedelta(hours=-5))\n11: \n12: \n13: def utc(*args):\n14:     return datetime(*args, tzinfo=UTC)\n15: \n16: \n17: def jst(*args):\n18:     return datetime(*args, tzinfo=JST)\n19: \n20: \n21: def ny(*args):\n22:     return datetime(*args, tzinfo=NY)\n23: \n24: \n25: def test_empty_busy_returns_whole_window():\n26:     assert free_slots([], utc(2026, 11, 7, 0), utc(2026, 11, 8, 0)) == [\n27:         (utc(2026, 11, 7, 0), utc(2026, 11, 8, 0))\n28:     ]\n29: \n30: \n31: def test_single_busy_interval_in_middle():\n32:     gaps = free_slots(\n33:         [(utc(2026, 11, 7, 10), utc(2026, 11, 7, 12))],\n34:         utc(2026, 11, 7, 0),\n35:         utc(2026, 11, 7, 20),\n36:     )\n37:     assert gaps == [\n38:         (utc(2026, 11, 7, 0), utc(2026, 11, 7, 10)),\n39:         (utc(2026, 11, 7, 12), utc(2026, 11, 7, 20)),\n40:     ]\n41: \n42: \n43: def test_fully_busy_window():\n44:     day_start = utc(2026, 11, 7, 9)\n45:     day_end = utc(2026, 11, 7, 17)\n46:     assert free_slots([(day_start, day_end)], day_start, day_end) == []\n47: \n48: \n49: def test_busy_exactly_at_edges_leaves_no_zero_gap():\n50:     day_start = utc(2026, 11, 7, 9)\n51:     day_end = utc(2026, 11, 7, 12)\n52:     assert free_slots([(day_start, utc(2026, 11, 7, 10))], day_start, day_end) == [\n53:         (utc(2026, 11, 7, 10), day_end)\n54:     ]\n55:     assert free_slots([(utc(2026, 11, 7, 10), day_end)], day_start, day_end) == [\n56:         (day_start, utc(2026, 11, 7, 10))\n57:     ]\n58: \n59: \n60: def test_busy_entirely_outside_window_ignored():\n61:     day_start = utc(2026, 11, 7, 9)\n62:     day_end = utc(2026, 11, 7, 17)\n63:     busy = [\n64:         (utc(2026, 11, 6, 22), utc(2026, 11, 7, 8)),\n65:         (utc(2026, 11, 7, 18), utc(2026, 11, 7, 20)),\n66:     ]\n67:     assert free_slots(busy, day_start, day_end) == [(day_start, day_end)]\n68: \n69: \n70: def test_busy_clipped_to_window():\n71:     day_start = utc(2026, 11, 7, 9)\n72:     day_end = utc(2026, 11, 7, 17)\n73:     busy = [\n74:         (utc(2026, 11, 7, 8), utc(2026, 11, 7, 10)),\n75:         (utc(2026, 11, 7, 16), utc(2026, 11, 7, 18)),\n76:     ]\n77:     assert free_slots(busy, day_start, day_end) == [\n78:         (utc(2026, 11, 7, 10), utc(2026, 11, 7, 16))\n79:     ]\n80: \n81: \n82: def test_overlapping_and_unsorted_busy_merge():\n83:     day_start = utc(2026, 11, 7, 0)\n84:     day_end = utc(2026, 11, 7, 10)\n85:     busy = [\n86:         (utc(2026, 11, 7, 8), utc(2026, 11, 7, 9)),\n87:         (utc(2026, 11, 7, 2), utc(2026, 11, 7, 4)),\n88:         (utc(2026, 11, 7, 3), utc(2026, 11, 7, 5)),\n89:     ]\n90:     gaps = free_slots(busy, day_start, day_end)\n91:     assert gaps == [\n92:         (utc(2026, 11, 7, 0), utc(2026, 11, 7, 2)),\n93:         (utc(2026, 11, 7, 5), utc(2026, 11, 7, 8)),\n94:         (utc(2026, 11, 7, 9), utc(2026, 11, 7, 10)),\n95:     ]\n96:     assert gaps == sorted(gaps)\n97: \n98: \n99: def test_contained_busy_interval_absorbed():\n100:     day_start = utc(2026, 11, 7, 0)\n101:     day_end = utc(2026, 11, 7, 10)\n102:     busy = [\n103:         (utc(2026, 11, 7, 2), utc(2026, 11, 7, 6)),\n104:         (utc(2026, 11, 7, 3), utc(2026, 11, 7, 4)),\n105:     ]\n106:     assert free_slots(busy, day_start, day_end) == [\n107:         (utc(2026, 11, 7, 0), utc(2026, 11, 7, 2)),\n108:         (utc(2026, 11, 7, 6), utc(2026, 11, 7, 10)),\n109:     ]\n110: \n111: \n112: def test_touching_busy_intervals_merge_no_zero_gap():\n113:     day_start = utc(2026, 11, 7, 0)\n114:     day_end = utc(2026, 11, 7, 6)\n115:     busy = [\n116:         (utc(2026, 11, 7, 1), utc(2026, 11, 7, 3)),\n117:         (utc(2026, 11, 7, 3), utc(2026, 11, 7, 4)),\n118:     ]\n119:     gaps = free_slots(busy, day_start, day_end)\n120:     assert gaps == [\n121:         (utc(2026, 11, 7, 0), utc(2026, 11, 7, 1)),\n122:         (utc(2026, 11, 7, 4), utc(2026, 11, 7, 6)),\n123:     ]\n124:     for start, end in gaps:\n125:         assert end > start\n126: \n127: \n128: def test_zero_length_busy_ignored():\n129:     day_start = utc(2026, 11, 7, 0)\n130:     day_end = utc(2026, 11, 7, 1)\n131:     busy = [(utc(2026, 11, 7, 0, 30), utc(2026, 11, 7, 0, 30))]\n132:     assert free_slots(busy, day_start, day_end) == [(day_start, day_end)]\n133: \n134: \n135: def test_mixed_timezones_converted_to_day_start_tz():\n136:     day_start = jst(2026, 11, 7, 0)\n137:     day_end = jst(2026, 11, 8, 0)\n138:     # 09:00-10:00 UTC is 18:00-19:00 JST\n139:     busy = [(utc(2026, 11, 7, 9), utc(2026, 11, 7, 10))]\n140:     gaps = free_slots(busy, day_start, day_end)\n141:     assert gaps == [\n142:         (jst(2026, 11, 7, 0), jst(2026, 11, 7, 18)),\n143:         (jst(2026, 11, 7, 19), jst(2026, 11, 8, 0)),\n144:     ]\n145:     for start, end in gaps:\n146:         assert start.tzinfo is JST\n147:         assert end.tzinfo is JST\n148: \n149: \n150: def test_mixed_offsets_between_busy_intervals():\n151:     day_start = utc(2026, 11, 7, 0)\n152:     day_end = utc(2026, 11, 8, 0)\n153:     busy = [\n154:         (ny(2026, 11, 7, 4, 0), ny(2026, 11, 7, 8, 0)),  # 09:00-13:00 UTC\n155:         (jst(2026, 11, 8, 2, 0), jst(2026, 11, 8, 5, 0)),  # 17:00-20:00 UTC\n156:     ]\n157:     gaps = free_slots(busy, day_start, day_end)\n158:     assert gaps == [\n159:         (utc(2026, 11, 7, 0), utc(2026, 11, 7, 9)),\n160:         (utc(2026, 11, 7, 13), utc(2026, 11, 7, 17)),\n161:         (utc(2026, 11, 7, 20), utc(2026, 11, 8, 0)),\n162:     ]\n163: \n164: \n165: def test_min_minutes_filters_short_gaps():\n166:     day_start = utc(2026, 11, 7, 0)\n167:     day_end = utc(2026, 11, 7, 3)\n168:     busy = [\n169:         (utc(2026, 11, 7, 1), utc(2026, 11, 7, 1, 30)),\n170:         (utc(2026, 11, 7, 2), utc(2026, 11, 7, 2, 30)),\n171:     ]\n172:     # Gaps are 60, 30, 30 minutes\n173:     gaps = free_slots(busy, day_start, day_end, min_minutes=30)\n174:     assert gaps == [\n175:         (utc(2026, 11, 7, 0), utc(2026, 11, 7, 1)),\n176:         (utc(2026, 11, 7, 1, 30), utc(2026, 11, 7, 2)),\n177:         (utc(2026, 11, 7, 2, 30), utc(2026, 11, 7, 3)),\n178:     ]\n179:     gaps = free_slots(busy, day_start, day_end, min_minutes=45)\n180:     assert gaps == [(utc(2026, 11, 7, 0), utc(2026, 11, 7, 1))]\n181:     assert free_slots(busy, day_start, day_end, min_minutes=61) == []\n182: \n183: \n184: def test_naive_day_start_raises():\n185:     with pytest.raises(ValueError):\n186:         free_slots([], datetime(2026, 11, 7, 0), utc(2026, 11, 7, 1))\n187: \n188: \n189: def test_naive_day_end_raises():\n190:     with pytest.raises(ValueError):\n191:         free_slots([], utc(2026, 11, 7, 0), datetime(2026, 11, 7, 1))\n192: \n193: \n194: def test_naive_busy_start_raises():\n195:     with pytest.raises(ValueError):\n196:         free_slots(\n197:             [(datetime(2026, 11, 7, 1), utc(2026, 11, 7, 2))],\n198:             utc(2026, 11, 7, 0),\n199:             utc(2026, 11, 7, 3),\n200:         )\n201: \n202: \n203: def test_naive_busy_end_raises():\n204:     with pytest.raises(ValueError):\n205:         free_slots(\n206:             [(utc(2026, 11, 7, 1), datetime(2026, 11, 7, 2))],\n207:             utc(2026, 11, 7, 0),\n208:             utc(2026, 11, 7, 3),\n209:         )\n210: \n211: \n212: def test_busy_end_before_start_raises():\n213:     with pytest.raises(ValueError):\n214:         free_slots(\n215:             [(utc(2026, 11, 7, 2), utc(2026, 11, 7, 1))],\n216:             utc(2026, 11, 7, 0),\n217:             utc(2026, 11, 7, 3),\n218:         )\n219: \n220: \n221: def test_day_end_equal_to_day_start_raises():\n222:     day = utc(2026, 11, 7, 0)\n223:     with pytest.raises(ValueError):\n224:         free_slots([], day, day)\n225: \n226: \n227: def test_day_end_before_day_start_raises():\n228:     with pytest.raises(ValueError):\n229:         free_slots([], utc(2026, 11, 7, 1), utc(2026, 11, 7, 0))\n230: \n231: \n232: class OffsetlessTZ(tzinfo):\n233:     def utcoffset(self, dt):\n234:         return None\n235: \n236:     def dst(self, dt):\n237:         return None\n238: \n239:     def tzname(self, dt):\n240:         return \"?\"\n241: \n242: \n243: def test_offsetless_tzinfo_treated_as_naive():\n244:     tz = OffsetlessTZ()\n245:     with pytest.raises(ValueError):\n246:         free_slots([], datetime(2026, 11, 7, 0, tzinfo=tz), datetime(2026, 11, 7, 1, tzinfo=tz))\n247: \n248: \n249: def test_fall_back_day_full_window_survives_min_minutes():\n250:     ny_zone = ZoneInfo(\"America/New_York\")\n251:     day_start = datetime(2025, 11, 2, 0, 0, tzinfo=ny_zone)\n252:     day_end = datetime(2025, 11, 3, 0, 0, tzinfo=ny_zone)\n253:     gaps = free_slots([], day_start, day_end, min_minutes=24 * 60 + 30)\n254:     assert gaps == [(day_start, day_end)]\n255: \n256: \n257: def test_busy_inside_repeated_fall_back_hour():\n258:     ny_zone = ZoneInfo(\"America/New_York\")\n259:     day_start = datetime(2025, 11, 2, 0, 0, tzinfo=ny_zone)\n260:     day_end = datetime(2025, 11, 3, 0, 0, tzinfo=ny_zone)\n261:     edt = timezone(timedelta(hours=-4))\n262:     busy = [\n263:         (\n264:             datetime(2025, 11, 2, 1, 30, tzinfo=edt),\n265:             datetime(2025, 11, 2, 1, 45, tzinfo=edt),\n266:         )\n267:     ]\n268:     gaps = free_slots(busy, day_start, day_end)\n269:     assert len(gaps) == 2\n270:     first, second = gaps\n271:     assert first[0].tzinfo is ny_zone\n272:     assert first[0] == day_start\n273:     assert first[1] == datetime(2025, 11, 2, 1, 30, tzinfo=edt)\n274:     assert second[0] == datetime(2025, 11, 2, 1, 45, tzinfo=edt)\n275:     assert second[1] == day_end\n276:     total = sum(\n277:         end.astimezone(UTC) - start.astimezone(UTC) for start, end in gaps\n278:     )\n279:     assert total == timedelta(hours=24, minutes=15)\n\n(End of file - total 279 lines)\n</content>","metadata":{"preview":"from datetime import datetime, timedelta, timezone, tzinfo\nfrom zoneinfo import ZoneInfo\n\nimport pytest\n\nfrom ledgerkit.slots import free_slots\n\nUTC = timezone.utc\nJST = timezone(timedelta(hours=9))\nNY = timezone(timedelta(hours=-5))\n\n\ndef utc(*args):\n    return datetime(*args, tzinfo=UTC)\n\n\ndef jst(*args):\n    return datetime(*args, tzinfo=JST)\n\n","truncated":false,"loaded":[],"display":{"type":"file","path":"/home/user/latte-crew/var/worktrees/1107-b2704c/tests/test_slots.py","text":"from datetime import datetime, timedelta, timezone, tzinfo\nfrom zoneinfo import ZoneInfo\n\nimport pytest\n\nfrom ledgerkit.slots import free_slots\n\nUTC = timezone.utc\nJST = timezone(timedelta(hours=9))\nNY = timezone(timedelta(hours=-5))\n\n\ndef utc(*args):\n    return datetime(*args, tzinfo=UTC)\n\n\ndef jst(*args):\n    return datetime(*args, tzinfo=JST)\n\n\ndef ny(*args):\n    return datetime(*args, tzinfo=NY)\n\n\ndef test_empty_busy_returns_whole_window():\n    assert free_slots([], utc(2026, 11, 7, 0), utc(2026, 11, 8, 0)) == [\n        (utc(2026, 11, 7, 0), utc(2026, 11, 8, 0))\n    ]\n\n\ndef test_single_busy_interval_in_middle():\n    gaps = free_slots(\n        [(utc(2026, 11, 7, 10), utc(2026, 11, 7, 12))],\n        utc(2026, 11, 7, 0),\n        utc(2026, 11, 7, 20),\n    )\n    assert gaps == [\n        (utc(2026, 11, 7, 0), utc(2026, 11, 7, 10)),\n        (utc(2026, 11, 7, 12), utc(2026, 11, 7, 20)),\n    ]\n\n\ndef test_fully_busy_window():\n    day_start = utc(2026, 11, 7, 9)\n    day_end = utc(2026, 11, 7, 17)\n    assert free_slots([(day_start, day_end)], day_start, day_end) == []\n\n\ndef test_busy_exactly_at_edges_leaves_no_zero_gap():\n    day_start = utc(2026, 11, 7, 9)\n    day_end = utc(2026, 11, 7, 12)\n    assert free_slots([(day_start, utc(2026, 11, 7, 10))], day_start, day_end) == [\n        (utc(2026, 11, 7, 10), day_end)\n    ]\n    assert free_slots([(utc(2026, 11, 7, 10), day_end)], day_start, day_end) == [\n        (day_start, utc(2026, 11, 7, 10))\n    ]\n\n\ndef test_busy_entirely_outside_window_ignored():\n    day_start = utc(2026, 11, 7, 9)\n    day_end = utc(2026, 11, 7, 17)\n    busy = [\n        (utc(2026, 11, 6, 22), utc(2026, 11, 7, 8)),\n        (utc(2026, 11, 7, 18), utc(2026, 11, 7, 20)),\n    ]\n    assert free_slots(busy, day_start, day_end) == [(day_start, day_end)]\n\n\ndef test_busy_clipped_to_window():\n    day_start = utc(2026, 11, 7, 9)\n    day_end = utc(2026, 11, 7, 17)\n    busy = [\n        (utc(2026, 11, 7, 8), utc(2026, 11, 7, 10)),\n        (utc(2026, 11, 7, 16), utc(2026, 11, 7, 18)),\n    ]\n    assert free_slots(busy, day_start, day_end) == [\n        (utc(2026, 11, 7, 10), utc(2026, 11, 7, 16))\n    ]\n\n\ndef test_overlapping_and_unsorted_busy_merge():\n    day_start = utc(2026, 11, 7, 0)\n    day_end = utc(2026, 11, 7, 10)\n    busy = [\n        (utc(2026, 11, 7, 8), utc(2026, 11, 7, 9)),\n        (utc(2026, 11, 7, 2), utc(2026, 11, 7, 4)),\n        (utc(2026, 11, 7, 3), utc(2026, 11, 7, 5)),\n    ]\n    gaps = free_slots(busy, day_start, day_end)\n    assert gaps == [\n        (utc(2026, 11, 7, 0), utc(2026, 11, 7, 2)),\n        (utc(2026, 11, 7, 5), utc(2026, 11, 7, 8)),\n        (utc(2026, 11, 7, 9), utc(2026, 11, 7, 10)),\n    ]\n    assert gaps == sorted(gaps)\n\n\ndef test_contained_busy_interval_absorbed():\n    day_start = utc(2026, 11, 7, 0)\n    day_end = utc(2026, 11, 7, 10)\n    busy = [\n        (utc(2026, 11, 7, 2), utc(2026, 11, 7, 6)),\n        (utc(2026, 11, 7, 3), utc(2026, 11, 7, 4)),\n    ]\n    assert free_slots(busy, day_start, day_end) == [\n        (utc(2026, 11, 7, 0), utc(2026, 11, 7, 2)),\n        (utc(2026, 11, 7, 6), utc(2026, 11, 7, 10)),\n    ]\n\n\ndef test_touching_busy_intervals_merge_no_zero_gap():\n    day_start = utc(2026, 11, 7, 0)\n    day_end = utc(2026, 11, 7, 6)\n    busy = [\n        (utc(2026, 11, 7, 1), utc(2026, 11, 7, 3)),\n        (utc(2026, 11, 7, 3), utc(2026, 11, 7, 4)),\n    ]\n    gaps = free_slots(busy, day_start, day_end)\n    assert gaps == [\n        (utc(2026, 11, 7, 0), utc(2026, 11, 7, 1)),\n        (utc(2026, 11, 7, 4), utc(2026, 11, 7, 6)),\n    ]\n    for start, end in gaps:\n        assert end > start\n\n\ndef test_zero_length_busy_ignored():\n    day_start = utc(2026, 11, 7, 0)\n    day_end = utc(2026, 11, 7, 1)\n    busy = [(utc(2026, 11, 7, 0, 30), utc(2026, 11, 7, 0, 30))]\n    assert free_slots(busy, day_start, day_end) == [(day_start, day_end)]\n\n\ndef test_mixed_timezones_converted_to_day_start_tz():\n    day_start = jst(2026, 11, 7, 0)\n    day_end = jst(2026, 11, 8, 0)\n    # 09:00-10:00 UTC is 18:00-19:00 JST\n    busy = [(utc(2026, 11, 7, 9), utc(2026, 11, 7, 10))]\n    gaps = free_slots(busy, day_start, day_end)\n    assert gaps == [\n        (jst(2026, 11, 7, 0), jst(2026, 11, 7, 18)),\n        (jst(2026, 11, 7, 19), jst(2026, 11, 8, 0)),\n    ]\n    for start, end in gaps:\n        assert start.tzinfo is JST\n        assert end.tzinfo is JST\n\n\ndef test_mixed_offsets_between_busy_intervals():\n    day_start = utc(2026, 11, 7, 0)\n    day_end = utc(2026, 11, 8, 0)\n    busy = [\n        (ny(2026, 11, 7, 4, 0), ny(2026, 11, 7, 8, 0)),  # 09:00-13:00 UTC\n        (jst(2026, 11, 8, 2, 0), jst(2026, 11, 8, 5, 0)),  # 17:00-20:00 UTC\n    ]\n    gaps = free_slots(busy, day_start, day_end)\n    assert gaps == [\n        (utc(2026, 11, 7, 0), utc(2026, 11, 7, 9)),\n        (utc(2026, 11, 7, 13), utc(2026, 11, 7, 17)),\n        (utc(2026, 11, 7, 20), utc(2026, 11, 8, 0)),\n    ]\n\n\ndef test_min_minutes_filters_short_gaps():\n    day_start = utc(2026, 11, 7, 0)\n    day_end = utc(2026, 11, 7, 3)\n    busy = [\n        (utc(2026, 11, 7, 1), utc(2026, 11, 7, 1, 30)),\n        (utc(2026, 11, 7, 2), utc(2026, 11, 7, 2, 30)),\n    ]\n    # Gaps are 60, 30, 30 minutes\n    gaps = free_slots(busy, day_start, day_end, min_minutes=30)\n    assert gaps == [\n        (utc(2026, 11, 7, 0), utc(2026, 11, 7, 1)),\n        (utc(2026, 11, 7, 1, 30), utc(2026, 11, 7, 2)),\n        (utc(2026, 11, 7, 2, 30), utc(2026, 11, 7, 3)),\n    ]\n    gaps = free_slots(busy, day_start, day_end, min_minutes=45)\n    assert gaps == [(utc(2026, 11, 7, 0), utc(2026, 11, 7, 1))]\n    assert free_slots(busy, day_start, day_end, min_minutes=61) == []\n\n\ndef test_naive_day_start_raises():\n    with pytest.raises(ValueError):\n        free_slots([], datetime(2026, 11, 7, 0), utc(2026, 11, 7, 1))\n\n\ndef test_naive_day_end_raises():\n    with pytest.raises(ValueError):\n        free_slots([], utc(2026, 11, 7, 0), datetime(2026, 11, 7, 1))\n\n\ndef test_naive_busy_start_raises():\n    with pytest.raises(ValueError):\n        free_slots(\n            [(datetime(2026, 11, 7, 1), utc(2026, 11, 7, 2))],\n            utc(2026, 11, 7, 0),\n            utc(2026, 11, 7, 3),\n        )\n\n\ndef test_naive_busy_end_raises():\n    with pytest.raises(ValueError):\n        free_slots(\n            [(utc(2026, 11, 7, 1), datetime(2026, 11, 7, 2))],\n            utc(2026, 11, 7, 0),\n            utc(2026, 11, 7, 3),\n        )\n\n\ndef test_busy_end_before_start_raises():\n    with pytest.raises(ValueError):\n        free_slots(\n            [(utc(2026, 11, 7, 2), utc(2026, 11, 7, 1))],\n            utc(2026, 11, 7, 0),\n            utc(2026, 11, 7, 3),\n        )\n\n\ndef test_day_end_equal_to_day_start_raises():\n    day = utc(2026, 11, 7, 0)\n    with pytest.raises(ValueError):\n        free_slots([], day, day)\n\n\ndef test_day_end_before_day_start_raises():\n    with pytest.raises(ValueError):\n        free_slots([], utc(2026, 11, 7, 1), utc(2026, 11, 7, 0))\n\n\nclass OffsetlessTZ(tzinfo):\n    def utcoffset(self, dt):\n        return None\n\n    def dst(self, dt):\n        return None\n\n    def tzname(self, dt):\n        return \"?\"\n\n\ndef test_offsetless_tzinfo_treated_as_naive():\n    tz = OffsetlessTZ()\n    with pytest.raises(ValueError):\n        free_slots([], datetime(2026, 11, 7, 0, tzinfo=tz), datetime(2026, 11, 7, 1, tzinfo=tz))\n\n\ndef test_fall_back_day_full_window_survives_min_minutes():\n    ny_zone = ZoneInfo(\"America/New_York\")\n    day_start = datetime(2025, 11, 2, 0, 0, tzinfo=ny_zone)\n    day_end = datetime(2025, 11, 3, 0, 0, tzinfo=ny_zone)\n    gaps = free_slots([], day_start, day_end, min_minutes=24 * 60 + 30)\n    assert gaps == [(day_start, day_end)]\n\n\ndef test_busy_inside_repeated_fall_back_hour():\n    ny_zone = ZoneInfo(\"America/New_York\")\n    day_start = datetime(2025, 11, 2, 0, 0, tzinfo=ny_zone)\n    day_end = datetime(2025, 11, 3, 0, 0, tzinfo=ny_zone)\n    edt = timezone(timedelta(hours=-4))\n    busy = [\n        (\n            datetime(2025, 11, 2, 1, 30, tzinfo=edt),\n            datetime(2025, 11, 2, 1, 45, tzinfo=edt),\n        )\n    ]\n    gaps = free_slots(busy, day_start, day_end)\n    assert len(gaps) == 2\n    first, second = gaps\n    assert first[0].tzinfo is ny_zone\n    assert first[0] == day_start\n    assert first[1] == datetime(2025, 11, 2, 1, 30, tzinfo=edt)\n    assert second[0] == datetime(2025, 11, 2, 1, 45, tzinfo=edt)\n    assert second[1] == day_end\n    total = sum(\n        end.astimezone(UTC) - start.astimezone(UTC) for start, end in gaps\n    )\n    assert total == timedelta(hours=24, minutes=15)","lineStart":1,"lineEnd":279,"totalLines":279,"truncated":false}},"title":"tests/test_slots.py","time":{"start":1794047011127,"end":1794047011137}},"id":"prt_1b588e6f6001Y3Cx9V7nrx2hAX","sessionID":"ses_e4a838527ffe8oucTkjfNF4FOG","messageID":"msg_1b58886ce001pRmKwQ4vu1k7s2"}}
