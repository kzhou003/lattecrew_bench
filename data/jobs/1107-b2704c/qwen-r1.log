{"type":"tool_use","timestamp":1794046286123,"sessionID":"ses_e4a838527ffe8oucTkjfNF4FOG","part":{"type":"tool","tool":"write","callID":"chatcmpl-tool-a62559472fd9d235","state":{"status":"completed","input":{"content":"def _is_naive(dt):\n    return dt.tzinfo is None or dt.tzinfo.utcoffset(dt) is None\n\n\ndef free_slots(busy, day_start, day_end, min_minutes=0):\n    \"\"\"Return the free gaps inside [day_start, day_end] not covered by busy.\n\n    busy is a list of (start, end) timezone-aware datetimes, possibly\n    overlapping, unsorted, and in different UTC offsets. The result is a\n    sorted list of (start, end) tuples in the timezone of day_start.\n    \"\"\"\n    if _is_naive(day_start) or _is_naive(day_end):\n        raise ValueError(\"day_start and day_end must be timezone-aware\")\n    if day_end <= day_start:\n        raise ValueError(\"day_end must be strictly after day_start\")\n\n    tz = day_start.tzinfo\n    min_seconds = min_minutes * 60\n\n    clipped = []\n    for start, end in busy:\n        if _is_naive(start) or _is_naive(end):\n            raise ValueError(\"busy intervals must use timezone-aware datetimes\")\n        if end < start:\n            raise ValueError(\"busy interval end must not be before start\")\n        s = start.astimezone(tz)\n        e = end.astimezone(tz)\n        if e <= s:\n            continue\n        s = max(s, day_start)\n        e = min(e, day_end)\n        if e > s:\n            clipped.append((s, e))\n\n    clipped.sort()\n    merged = []\n    for s, e in clipped:\n        if merged and s <= merged[-1][1]:\n            merged[-1] = (merged[-1][0], max(merged[-1][1], e))\n        else:\n            merged.append((s, e))\n\n    gaps = []\n    cursor = day_start\n    for s, e in merged:\n        if s > cursor:\n            gaps.append((cursor, s))\n        cursor = e\n    if day_end > cursor:\n        gaps.append((cursor, day_end))\n\n    return [(s, e) for s, e in gaps if (e - s).total_seconds() >= min_seconds]\n","filePath":"/home/user/latte-crew/var/worktrees/1107-b2704c/ledgerkit/slots.py"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/home/user/latte-crew/var/worktrees/1107-b2704c/ledgerkit/slots.py","exists":false,"truncated":false},"title":"ledgerkit/slots.py","time":{"start":1794046286116,"end":1794046286122}},"id":"prt_1b57dbbf7001iHLtMyZqbMbMRR","sessionID":"ses_e4a838527ffe8oucTkjfNF4FOG","messageID":"msg_1b57c924e001zeQ6wIYhxFv2oL"}}
