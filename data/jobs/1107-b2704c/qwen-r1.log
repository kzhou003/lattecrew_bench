{"type":"tool_use","timestamp":1794046338423,"sessionID":"ses_e4a838527ffe8oucTkjfNF4FOG","part":{"type":"tool","tool":"write","callID":"chatcmpl-tool-adcd7827a8275c75","state":{"status":"completed","input":{"content":"from datetime import datetime, timedelta, timezone\n\nimport pytest\n\nfrom ledgerkit.slots import free_slots\n\nUTC = timezone.utc\nJST = timezone(timedelta(hours=9))\nNY = timezone(timedelta(hours=-5))\n\n\ndef utc(*args):\n    return datetime(*args, tzinfo=UTC)\n\n\ndef jst(*args):\n    return datetime(*args, tzinfo=JST)\n\n\ndef test_empty_busy_returns_whole_window():\n    assert free_slots([], utc(2026, 11, 7, 0), utc(2026, 11, 8, 0)) == [\n        (utc(2026, 11, 7, 0), utc(2026, 11, 8, 0))\n    ]\n\n\ndef test_single_busy_interval_in_middle():\n    gaps = free_slots(\n        [(utc(2026, 11, 7, 10), utc(2026, 11, 7, 12))],\n        utc(2026, 11, 7, 0),\n        utc(2026, 11, 7, 20),\n    )\n    assert gaps == [\n        (utc(2026, 11, 7, 0), utc(2026, 11, 7, 10)),\n        (utc(2026, 11, 7, 12), utc(2026, 11, 7, 20)),\n    ]\n\n\ndef test_fully_busy_window():\n    day_start = utc(2026, 11, 7, 9)\n    day_end = utc(2026, 11, 7, 17)\n    assert free_slots([(day_start, day_end)], day_start, day_end) == []\n\n\ndef test_busy_exactly_at_edges_leaves_no_zero_gap():\n    day_start = utc(2026, 11, 7, 9)\n    day_end = utc(2026, 11, 7, 12)\n    assert free_slots([(day_start, utc(2026, 11, 7, 10))], day_start, day_end) == [\n        (utc(2026, 11, 7, 10), day_end)\n    ]\n    assert free_slots([(utc(2026, 11, 7, 10), day_end)], day_start, day_end) == [\n        (day_start, utc(2026, 11, 7, 10))\n    ]\n\n\ndef test_busy_entirely_outside_window_ignored():\n    day_start = utc(2026, 11, 7, 9)\n    day_end = utc(2026, 11, 7, 17)\n    busy = [\n        (utc(2026, 11, 6, 22), utc(2026, 11, 7, 8)),\n        (utc(2026, 11, 7, 18), utc(2026, 11, 7, 20)),\n    ]\n    assert free_slots(busy, day_start, day_end) == [(day_start, day_end)]\n\n\ndef test_busy_clipped_to_window():\n    day_start = utc(2026, 11, 7, 9)\n    day_end = utc(2026, 11, 7, 17)\n    busy = [\n        (utc(2026, 11, 7, 8), utc(2026, 11, 7, 10)),\n        (utc(2026, 11, 7, 16), utc(2026, 11, 7, 18)),\n    ]\n    assert free_slots(busy, day_start, day_end) == [\n        (utc(2026, 11, 7, 10), utc(2026, 11, 7, 16))\n    ]\n\n\ndef test_overlapping_and_unsorted_busy_merge():\n    day_start = utc(2026, 11, 7, 0)\n    day_end = utc(2026, 11, 7, 10)\n    busy = [\n        (utc(2026, 11, 7, 8), utc(2026, 11, 7, 9)),\n        (utc(2026, 11, 7, 2), utc(2026, 11, 7, 4)),\n        (utc(2026, 11, 7, 3), utc(2026, 11, 7, 5)),\n    ]\n    gaps = free_slots(busy, day_start, day_end)\n    assert gaps == [\n        (utc(2026, 11, 7, 0), utc(2026, 11, 7, 2)),\n        (utc(2026, 11, 7, 5), utc(2026, 11, 7, 8)),\n        (utc(2026, 11, 7, 9), utc(2026, 11, 7, 10)),\n    ]\n    assert gaps == sorted(gaps)\n\n\ndef test_contained_busy_interval_absorbed():\n    day_start = utc(2026, 11, 7, 0)\n    day_end = utc(2026, 11, 7, 10)\n    busy = [\n        (utc(2026, 11, 7, 2), utc(2026, 11, 7, 6)),\n        (utc(2026, 11, 7, 3), utc(2026, 11, 7, 4)),\n    ]\n    assert free_slots(busy, day_start, day_end) == [\n        (utc(2026, 11, 7, 0), utc(2026, 11, 7, 2)),\n        (utc(2026, 11, 7, 6), utc(2026, 11, 7, 10)),\n    ]\n\n\ndef test_touching_busy_intervals_merge_no_zero_gap():\n    day_start = utc(2026, 11, 7, 0)\n    day_end = utc(2026, 11, 7, 6)\n    busy = [\n        (utc(2026, 11, 7, 1), utc(2026, 11, 7, 3)),\n        (utc(2026, 11, 7, 3), utc(2026, 11, 7, 4)),\n    ]\n    gaps = free_slots(busy, day_start, day_end)\n    assert gaps == [\n        (utc(2026, 11, 7, 0), utc(2026, 11, 7, 1)),\n        (utc(2026, 11, 7, 4), utc(2026, 11, 7, 6)),\n    ]\n    for start, end in gaps:\n        assert end > start\n\n\ndef test_zero_length_busy_ignored():\n    day_start = utc(2026, 11, 7, 0)\n    day_end = utc(2026, 11, 7, 1)\n    busy = [(utc(2026, 11, 7, 30), utc(2026, 11, 7, 30))]\n    assert free_slots(busy, day_start, day_end) == [(day_start, day_end)]\n\n\ndef test_mixed_timezones_converted_to_day_start_tz():\n    day_start = jst(2026, 11, 7, 0)\n    day_end = jst(2026, 11, 8, 0)\n    # 09:00-10:00 UTC is 18:00-19:00 JST\n    busy = [(utc(2026, 11, 7, 9), utc(2026, 11, 7, 10))]\n    gaps = free_slots(busy, day_start, day_end)\n    assert gaps == [\n        (jst(2026, 11, 7, 0), jst(2026, 11, 7, 18)),\n        (jst(2026, 11, 7, 19), jst(2026, 11, 8, 0)),\n    ]\n    for start, end in gaps:\n        assert start.tzinfo is JST\n        assert end.tzinfo is JST\n\n\ndef test_mixed_offsets_between_busy_intervals():\n    day_start = utc(2026, 11, 7, 0)\n    day_end = utc(2026, 11, 7, 24).replace(hour=0) + timedelta(days=1)\n    day_end = utc(2026, 11, 8, 0)\n    busy = [\n        (NY(2026, 11, 7, 4, 0), NY(2026, 11, 7, 8, 0)),  # 09:00-13:00 UTC\n        (JST(2026, 11, 8, 2, 0), JST(2026, 11, 8, 5, 0)),  # 17:00-20:00 UTC\n    ]\n    gaps = free_slots(busy, day_start, day_end)\n    assert gaps == [\n        (utc(2026, 11, 7, 0), utc(2026, 11, 7, 9)),\n        (utc(2026, 11, 7, 13), utc(2026, 11, 7, 17)),\n        (utc(2026, 11, 7, 20), utc(2026, 11, 8, 0)),\n    ]\n\n\ndef test_min_minutes_filters_short_gaps():\n    day_start = utc(2026, 11, 7, 0)\n    day_end = utc(2026, 11, 7, 3)\n    busy = [\n        (utc(2026, 11, 7, 1), utc(2026, 11, 7, 1, 30)),\n        (utc(2026, 11, 7, 2), utc(2026, 11, 7, 2, 30)),\n    ]\n    # Gaps are 60, 30, 30 minutes\n    gaps = free_slots(busy, day_start, day_end, min_minutes=30)\n    assert gaps == [\n        (utc(2026, 11, 7, 0), utc(2026, 11, 7, 1)),\n        (utc(2026, 11, 7, 1, 30), utc(2026, 11, 7, 2)),\n        (utc(2026, 11, 7, 2, 30), utc(2026, 11, 7, 3)),\n    ]\n    gaps = free_slots(busy, day_start, day_end, min_minutes=45)\n    assert gaps == [(utc(2026, 11, 7, 0), utc(2026, 11, 7, 1))]\n    assert free_slots(busy, day_start, day_end, min_minutes=61) == []\n\n\ndef test_naive_day_start_raises():\n    with pytest.raises(ValueError):\n        free_slots([], datetime(2026, 11, 7, 0), utc(2026, 11, 7, 1))\n\n\ndef test_naive_day_end_raises():\n    with pytest.raises(ValueError):\n        free_slots([], utc(2026, 11, 7, 0), datetime(2026, 11, 7, 1))\n\n\ndef test_naive_busy_start_raises():\n    with pytest.raises(ValueError):\n        free_slots(\n            [(datetime(2026, 11, 7, 1), utc(2026, 11, 7, 2))],\n            utc(2026, 11, 7, 0),\n            utc(2026, 11, 7, 3),\n        )\n\n\ndef test_naive_busy_end_raises():\n    with pytest.raises(ValueError):\n        free_slots(\n            [(utc(2026, 11, 7, 1), datetime(2026, 11, 7, 2))],\n            utc(2026, 11, 7, 0),\n            utc(2026, 11, 7, 3),\n        )\n\n\ndef test_busy_end_before_start_raises():\n    with pytest.raises(ValueError):\n        free_slots(\n            [(utc(2026, 11, 7, 2), utc(2026, 11, 7, 1))],\n            utc(2026, 11, 7, 0),\n            utc(2026, 11, 7, 3),\n        )\n\n\ndef test_day_end_equal_to_day_start_raises():\n    day = utc(2026, 11, 7, 0)\n    with pytest.raises(ValueError):\n        free_slots([], day, day)\n\n\ndef test_day_end_before_day_start_raises():\n    with pytest.raises(ValueError):\n        free_slots([], utc(2026, 11, 7, 1), utc(2026, 11, 7, 0))\n\n\nclass OffsetlessTZ(datetime.tzinfo):\n    def utcoffset(self, dt):\n        return None\n\n    def dst(self, dt):\n        return None\n\n    def tzname(self, dt):\n        return \"?\"\n\n\ndef test_offsetless_tzinfo_treated_as_naive():\n    tz = OffsetlessTZ()\n    with pytest.raises(ValueError):\n        free_slots([], datetime(2026, 11, 7, 0, tzinfo=tz), datetime(2026, 11, 7, 1, tzinfo=tz))\n","filePath":"/home/user/latte-crew/var/worktrees/1107-b2704c/tests/test_slots.py"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/home/user/latte-crew/var/worktrees/1107-b2704c/tests/test_slots.py","exists":false,"truncated":false},"title":"tests/test_slots.py","time":{"start":1794046338413,"end":1794046338421}},"id":"prt_1b57de225001gZMiI6JCAS3K6T","sessionID":"ses_e4a838527ffe8oucTkjfNF4FOG","messageID":"msg_1b57dd98c001bngqt6Zl2Z3IJ3"}}
