{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01K39P7zje1JLoqk7wRr9WsB","type":"tool_result","content":"diff --git a/ledgerkit/slots.py b/ledgerkit/slots.py\nnew file mode 100644\nindex 0000000..3ee2bd2\n--- /dev/null\n+++ b/ledgerkit/slots.py\n@@ -0,0 +1,62 @@\n+\"\"\"Compute free time gaps in a day, given busy intervals.\"\"\"\n+\n+from datetime import timezone\n+\n+UTC = timezone.utc\n+\n+\n+def free_slots(busy, day_start, day_end, min_minutes=0):\n+    \"\"\"Return free gaps in [day_start, day_end] not covered by `busy`.\n+\n+    `busy` is a list of (start, end) pairs of timezone-aware datetimes.\n+    All interval math (clip, sort, merge, gaps, durations) is done in UTC\n+    so that DST transitions measure real elapsed time. Gaps shorter than\n+    `min_minutes` are dropped. The result is sorted, in day_start's\n+    timezone.\n+    \"\"\"\n+    if _is_naive(day_start) or _is_naive(day_end):\n+        raise ValueError(\"day_start and day_end must be timezone-aware\")\n+    if day_end <= day_start:\n+        raise ValueError(\"day_end must be strictly after day_start\")\n+\n+    min_seconds = min_minutes * 60\n+    start_utc = day_start.astimezone(UTC)\n+    end_utc = day_end.astimezone(UTC)\n+\n+    clipped = []\n+    for start, end in busy:\n+        if _is_naive(start) or _is_naive(end):\n+            raise ValueError(\"busy intervals must use timezone-aware datetimes\")\n+        if end < start:\n+            raise ValueError(\"busy interval end must not be before start\")\n+        s = max(start.astimezone(UTC), start_utc)\n+        e = min(end.astimezone(UTC), end_utc)\n+        if e > s:\n+            clipped.append((s, e))\n+\n+    clipped.sort()\n+    merged = []\n+    for s, e in clipped:\n+        if merged and s <= merged[-1][1]:\n+            merged[-1] = (merged[-1][0], max(merged[-1][1], e))\n+        else:\n+            merged.append((s, e))\n+\n+    gaps = []\n+    cursor = start_utc\n+    for s, e in merged:\n+        if s > cursor:\n+            gaps.append((cursor, s))\n+        cursor = e\n+    if end_utc > cursor:\n+        gaps.append((cursor, end_utc))\n+\n+    return [\n+        (s.astimezone(day_start.tzinfo), e.astimezone(day_start.tzinfo))\n+        for s, e in gaps\n+        if (e - s).total_seconds() >= min_seconds\n+    ]\n+\n+\n+def _is_naive(dt):\n+    return dt.tzinfo is None or dt.tzinfo.utcoffset(dt) is None\ndiff --git a/tests/test_slots.py b/tests/test_slots.py\nnew file mode 100644\nindex 0000000..c9cf516\n--- /dev/null\n+++ b/tests/test_slots.py\n@@ -0,0 +1,280 @@\n+from datetime import datetime, timedelta, timezone, tzinfo\n+from zoneinfo import ZoneInfo\n+\n+import pytest\n+\n+from ledgerkit.slots import free_slots\n+\n+UTC = timezone.utc\n+JST = timezone(timedelta(hours=9))\n+NY = timezone(timedelta(hours=-5))\n+\n+\n+def utc(*args):\n+    return datetime(*args, tzinfo=UTC)\n+\n+\n+def jst(*args):\n+    return datetime(*args, tzinfo=JST)\n+\n+\n+def ny(*args):\n+    return datetime(*args, tzinfo=NY)\n+\n+\n+def test_empty_busy_returns_whole_window():\n+    assert free_slots([], utc(2026, 11, 7, 0), utc(2026, 11, 8, 0)) == [\n+        (utc(2026, 11, 7, 0), utc(2026, 11, 8, 0))\n+    ]\n+\n+\n+def test_single_busy_interval_in_middle():\n+    gaps = free_slots(\n+        [(utc(2026, 11, 7, 10), utc(2026, 11, 7, 12))],\n+        utc(2026, 11, 7, 0),\n+        utc(2026, 11, 7, 20),\n+    )\n+    assert gaps == [\n+        (utc(2026, 11, 7, 0), utc(2026, 11, 7, 10)),\n+        (utc(2026, 11, 7, 12), utc(2026, 11, 7, 20)),\n+    ]\n+\n+\n+def test_fully_busy_window():\n+    day_start = utc(2026, 11, 7, 9)\n+    day_end = utc(2026, 11, 7, 17)\n+    assert free_slots([(day_start, day_end)], day_start, day_end) == []\n+\n+\n+def test_busy_exactly_at_edges_leaves_no_zero_gap():\n+    day_start = utc(2026, 11, 7, 9)\n+    day_end = utc(2026, 11, 7, 12)\n+    assert free_slots([(day_start, utc(2026, 11, 7, 10))], day_start, day_end) == [\n+        (utc(2026, 11, 7, 10), day_end)\n+    ]\n+    assert free_slots([(utc(2026, 11, 7, 10), day_end)], day_start, day_end) == [\n+        (day_start, utc(2026, 11, 7, 10))\n+    ]\n+\n+\n+def test_busy_entirely_outside_window_ignored():\n+    day_start = utc(2026, 11, 7, 9)\n+    day_end = utc(2026, 11, 7, 17)\n+    busy = [\n+        (utc(2026, 11, 6, 22), utc(2026, 11, 7, 8)),\n+        (utc(2026, 11, 7, 18), utc(2026, 11, 7, 20)),\n+    ]\n+    assert free_slots(busy, day_start, day_end) == [(day_start, day_end)]\n+\n+\n+def test_busy_clipped_to_window():\n+    day_start = utc(2026, 11, 7, 9)\n+    day_end = utc(2026, 11, 7, 17)\n+    busy = [\n+        (utc(2026, 11, 7, 8), utc(2026, 11, 7, 10)),\n+        (utc(2026, 11, 7, 16), utc(2026, 11, 7, 18)),\n+    ]\n+    assert free_slots(busy, day_start, day_end) == [\n+        (utc(2026, 11, 7, 10), utc(2026, 11, 7, 16))\n+    ]\n+\n+\n+def test_overlapping_and_unsorted_busy_merge():\n+    day_start = utc(2026, 11, 7, 0)\n+    day_end = utc(2026, 11, 7, 10)\n+    busy = [\n+        (utc(2026, 11, 7, 8), utc(2026, 11, 7, 9)),\n+        (utc(2026, 11, 7, 2), utc(2026, 11, 7, 4)),\n+        (utc(2026, 11, 7, 3), utc(2026, 11, 7, 5)),\n+    ]\n+    gaps = free_slots(busy, day_start, day_end)\n+    assert gaps == [\n+        (utc(2026, 11, 7, 0), utc(2026, 11, 7, 2)),\n+        (utc(2026, 11, 7, 5), utc(2026, 11, 7, 8)),\n+        (utc(2026, 11, 7, 9), utc(2026, 11, 7, 10)),\n+    ]\n+    assert gaps == sorted(gaps)\n+\n+\n+def test_contained_busy_interval_absorbed():\n+    day_start = utc(2026, 11, 7, 0)\n+    day_end = utc(2026, 11, 7, 10)\n+    busy = [\n+        (utc(2026, 11, 7, 2), utc(2026, 11, 7, 6)),\n+        (utc(2026, 11, 7, 3), utc(2026, 11, 7, 4)),\n+    ]\n+    assert free_slots(busy, day_start, day_end) == [\n+        (utc(2026, 11, 7, 0), utc(2026, 11, 7, 2)),\n+        (utc(2026, 11, 7, 6), utc(2026, 11, 7, 10)),\n+    ]\n+\n+\n+def test_touching_busy_intervals_merge_no_zero_gap():\n+    day_start = utc(2026, 11, 7, 0)\n+    day_end = utc(2026, 11, 7, 6)\n+    busy = [\n+        (utc(2026, 11, 7, 1), utc(2026, 11, 7, 3)),\n+        (utc(2026, 11, 7, 3), utc(2026, 11, 7, 4)),\n+    ]\n+    gaps = free_slots(busy, day_start, day_end)\n+    assert gaps == [\n+        (utc(2026, 11, 7, 0), utc(2026, 11, 7, 1)),\n+        (utc(2026, 11, 7, 4), utc(2026, 11, 7, 6)),\n+    ]\n+    for start, end in gaps:\n+        assert end > start\n+\n+\n+def test_zero_length_busy_ignored():\n+    day_start = utc(2026, 11, 7, 0)\n+    day_end = utc(2026, 11, 7, 1)\n+    busy = [(utc(2026, 11, 7, 0, 30), utc(2026, 11, 7, 0, 30))]\n+    assert free_slots(busy, day_start, day_end) == [(day_start, day_end)]\n+\n+\n+def test_mixed_timezones_converted_to_day_start_tz():\n+    day_start = jst(2026, 11, 7, 0)\n+    day_end = jst(2026, 11, 8, 0)\n+    # 09:00-10:00 UTC is 18:00-19:00 JST\n+    busy = [(utc(2026, 11, 7, 9), utc(2026, 11, 7, 10))]\n+    gaps = free_slots(busy, day_start, day_end)\n+    assert gaps == [\n+        (jst(2026, 11, 7, 0), jst(2026, 11, 7, 18)),\n+        (jst(2026, 11, 7, 19), jst(2026, 11, 8, 0)),\n+    ]\n+    for start, end in gaps:\n+        assert start.tzinfo is JST\n+        assert end.tzinfo is JST\n+\n+\n+def test_mixed_offsets_between_busy_intervals():\n+    day_start = utc(2026, 11, 7, 0)\n+    day_end = utc(2026, 11, 8, 0)\n+    busy = [\n+        (ny(2026, 11, 7, 4, 0), ny(2026, 11, 7, 8, 0)),  # 09:00-13:00 UTC\n+        (jst(2026, 11, 8, 2, 0), jst(2026, 11, 8, 5, 0)),  # 17:00-20:00 UTC\n+    ]\n+    gaps = free_slots(busy, day_start, day_end)\n+    assert gaps == [\n+        (utc(2026, 11, 7, 0), utc(2026, 11, 7, 9)),\n+        (utc(2026, 11, 7, 13), utc(2026, 11, 7, 17)),\n+        (utc(2026, 11, 7, 20), utc(2026, 11, 8, 0)),\n+    ]\n+\n+\n+def test_min_minutes_filters_short_gaps():\n+    day_start = utc(2026, 11, 7, 0)\n+    day_end = utc(2026, 11, 7, 3)\n+    busy = [\n+        (utc(2026, 11, 7, 1), utc(2026, 11, 7, 1, 30)),\n+        (utc(2026, 11, 7, 2), utc(2026, 11, 7, 2, 30)),\n+    ]\n+    # Gaps are 60, 30, 30 minutes\n+    gaps = free_slots(busy, day_start, day_end, min_minutes=30)\n+    assert gaps == [\n+        (utc(2026, 11, 7, 0), utc(2026, 11, 7, 1)),\n+        (utc(2026, 11, 7, 1, 30), utc(2026, 11, 7, 2)),\n+        (utc(2026, 11, 7, 2, 30), utc(2026, 11, 7, 3)),\n+    ]\n+    gaps = free_slots(busy, day_start, day_end, min_minutes=45)\n+    assert gaps == [(utc(2026, 11, 7, 0), utc(2026, 11, 7, 1))]\n+    assert free_slots(busy, day_start, day_end, min_minutes=61) == []\n+\n+\n+def test_naive_day_start_raises():\n+    with pytest.raises(ValueError):\n+        free_slots([], datetime(2026, 11, 7, 0), utc(2026, 11, 7, 1))\n+\n+\n+def test_naive_day_end_raises():\n+    with pytest.raises(ValueError):\n+        free_slots([], utc(2026, 11, 7, 0), datetime(2026, 11, 7, 1))\n+\n+\n+def test_naive_busy_start_raises():\n+    with pytest.raises(ValueError):\n+        free_slots(\n+            [(datetime(2026, 11, 7, 1), utc(2026, 11, 7, 2))],\n+            utc(2026, 11, 7, 0),\n+            utc(2026, 11, 7, 3),\n+        )\n+\n+\n+def test_naive_busy_end_raises():\n+    with pytest.raises(ValueError):\n+        free_slots(\n+            [(utc(2026, 11, 7, 1), datetime(2026, 11, 7, 2))],\n+            utc(2026, 11, 7, 0),\n+            utc(2026, 11, 7, 3),\n+        )\n+\n+\n+def test_busy_end_before_start_raises():\n+    with pytest.raises(ValueError):\n+        free_slots(\n+            [(utc(2026, 11, 7, 2), utc(2026, 11, 7, 1))],\n+            utc(2026, 11, 7, 0),\n+            utc(2026, 11, 7, 3),\n+        )\n+\n+\n+def test_day_end_equal_to_day_start_raises():\n+    day = utc(2026, 11, 7, 0)\n+    with pytest.raises(ValueError):\n+        free_slots([], day, day)\n+\n+\n+def test_day_end_before_day_start_raises():\n+    with pytest.raises(ValueError):\n+        free_slots([], utc(2026, 11, 7, 1), utc(2026, 11, 7, 0))\n+\n+\n+class OffsetlessTZ(tzinfo):\n+    def utcoffset(self, dt):\n+        return None\n+\n+    def dst(self, dt):\n+        return None\n+\n+    def tzname(self, dt):\n+        return \"?\"\n+\n+\n+def test_offsetless_tzinfo_treated_as_naive():\n+    tz = OffsetlessTZ()\n+    with pytest.raises(ValueError):\n+        free_slots([], datetime(2026, 11, 7, 0, tzinfo=tz), datetime(2026, 11, 7, 1, tzinfo=tz))\n+\n+\n+def test_fall_back_day_full_window_survives_min_minutes():\n+    ny_zone = ZoneInfo(\"America/New_York\")\n+    day_start = datetime(2025, 11, 2, 0, 0, tzinfo=ny_zone)\n+    day_end = datetime(2025, 11, 3, 0, 0, tzinfo=ny_zone)\n+    gaps = free_slots([], day_start, day_end, min_minutes=24 * 60 + 30)\n+    assert gaps == [(day_start, day_end)]\n+\n+\n+def test_busy_inside_repeated_fall_back_hour():\n+    ny_zone = ZoneInfo(\"America/New_York\")\n+    day_start = datetime(2025, 11, 2, 0, 0, tzinfo=ny_zone)\n+    day_end = datetime(2025, 11, 3, 0, 0, tzinfo=ny_zone)\n+    edt = timezone(timedelta(hours=-4))\n+    busy = [\n+        (\n+            datetime(2025, 11, 2, 1, 30, tzinfo=edt),\n+            datetime(2025, 11, 2, 1, 45, tzinfo=edt),\n+        )\n+    ]\n+    gaps = free_slots(busy, day_start, day_end)\n+    assert len(gaps) == 2\n+    first, second = gaps\n+    assert first[0].tzinfo is ny_zone\n+    assert first[0] == day_start\n+    assert first[1].astimezone(UTC) == datetime(2025, 11, 2, 5, 30, tzinfo=UTC)\n+    assert second[0].astimezone(UTC) == datetime(2025, 11, 2, 5, 45, tzinfo=UTC)\n+    assert second[1] == day_end\n+    total = sum(\n+        (end.astimezone(UTC) - start.astimezone(UTC) for start, end in gaps),\n+        timedelta(0),\n+    )\n+    assert total == timedelta(hours=24, minutes=45)\n........................                                                 [100%]\n24 passed in 0.02s","is_error":false}]},"parent_tool_use_id":null,"session_id":"78bee12a-dae3-463b-bd0a-a2c740998e85","uuid":"2f176910-ed86-41a2-b417-8d57caa89153","timestamp":"2026-11-07T10:31:18.072Z","tool_use_result":{"stdout":"diff --git a/ledgerkit/slots.py