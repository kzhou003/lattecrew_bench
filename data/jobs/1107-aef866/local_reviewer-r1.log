{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01E1jSHYqjy6eVRBhmNktLeh","type":"tool_result","content":"import threading\nimport time\nfrom collections import OrderedDict\n\n\nclass TTLCache:\n    \"\"\"LRU cache whose entries expire a fixed time after their last put.\"\"\"\n\n    def __init__(self, maxsize, ttl, clock=time.monotonic):\n        if maxsize < 1:\n            raise ValueError(\"maxsize must be >= 1\")\n        if ttl <= 0:\n            raise ValueError(\"ttl must be > 0\")\n        self._maxsize = maxsize\n        self._ttl = ttl\n        self._clock = clock\n        self._lock = threading.Lock()\n        self._entries = OrderedDict()\n        self._hits = 0\n        self._misses = 0\n        self._evictions = 0\n\n    def _is_live(self, stored_time, now):\n        return now - stored_time < self._ttl\n\n    def _drop_expired(self, now):\n        for key, (_, stored_time) in list(self._entries.items()):\n            if not self._is_live(stored_time, now):\n                del self._entries[key]\n\n    def put(self, key, value):\n        with self._lock:\n            now = self._clock()\n            if key in self._entries:\n                self._entries[key] = (value, now)\n                self._entries.move_to_end(key)\n                return\n            self._entries[key] = (value, now)\n            if len(self._entries) > self._maxsize:\n                self._drop_expired(now)\n                if len(self._entries) > self._maxsize:\n                    self._entries.popitem(last=False)\n                    self._evictions += 1\n\n    def get(self, key, default=None):\n        with self._lock:\n            now = self._clock()\n            entry = self._entries.get(key)\n            if entry is None or not self._is_live(entry[1], now):\n                if entry is not None:\n                    del self._entries[key]\n                self._misses += 1\n                return default\n            self._entries.move_to_end(ke