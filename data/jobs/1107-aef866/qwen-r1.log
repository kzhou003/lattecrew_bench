{"type":"tool_use","timestamp":1794046127139,"sessionID":"ses_e4a86c410ffehh4Wjsc5CjF45Q","part":{"type":"tool","tool":"write","callID":"chatcmpl-tool-adcb3c9e5fe0ea00","state":{"status":"completed","input":{"filePath":"/home/user/latte-crew/var/worktrees/1107-aef866/ledgerkit/cache.py","content":"import threading\nimport time\nfrom collections import OrderedDict\n\n\nclass TTLCache:\n    \"\"\"LRU cache whose entries expire a fixed time after their last put.\"\"\"\n\n    def __init__(self, maxsize, ttl, clock=time.monotonic):\n        if maxsize < 1:\n            raise ValueError(\"maxsize must be >= 1\")\n        if ttl <= 0:\n            raise ValueError(\"ttl must be > 0\")\n        self._maxsize = maxsize\n        self._ttl = ttl\n        self._clock = clock\n        self._lock = threading.Lock()\n        self._entries = OrderedDict()\n        self._hits = 0\n        self._misses = 0\n        self._evictions = 0\n\n    def _is_live(self, stored_time, now):\n        return now - stored_time < self._ttl\n\n    def _drop_expired(self, now):\n        for key, (_, stored_time) in list(self._entries.items()):\n            if not self._is_live(stored_time, now):\n                del self._entries[key]\n\n    def put(self, key, value):\n        with self._lock:\n            now = self._clock()\n            if key in self._entries:\n                self._entries[key] = (value, now)\n                self._entries.move_to_end(key)\n                return\n            self._entries[key] = (value, now)\n            if len(self._entries) > self._maxsize:\n                self._drop_expired(now)\n                if len(self._entries) > self._maxsize:\n                    self._entries.popitem(last=False)\n                    self._evictions += 1\n\n    def get(self, key, default=None):\n        with self._lock:\n            now = self._clock()\n            entry = self._entries.get(key)\n            if entry is None or not self._is_live(entry[1], now):\n                if entry is not None:\n                    del self._entries[key]\n                self._misses += 1\n                return default\n            self._entries.move_to_end(key)\n            self._hits += 1\n            return entry[0]\n\n    def __len__(self):\n        with self._lock:\n            now = self._clock()\n            return sum(\n                1\n                for _, stored_time in self._entries.values()\n                if self._is_live(stored_time, now)\n            )\n\n    def __contains__(self, key):\n        with self._lock:\n            entry = self._entries.get(key)\n            return entry is not None and self._is_live(entry[1], self._clock())\n\n    def stats(self):\n        with self._lock:\n            return {\n                \"hits\": self._hits,\n                \"misses\": self._misses,\n                \"evictions\": self._evictions,\n            }\n"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/home/user/latte-crew/var/worktrees/1107-aef866/ledgerkit/cache.py","exists":false,"truncated":false},"title":"ledgerkit/cache.py","time":{"start":1794046127130,"end":1794046127138}},"id":"prt_1b57b470f001N41UvoPKV1ayk5","sessionID":"ses_e4a86c410ffehh4Wjsc5CjF45Q","messageID":"msg_1b5795f6e001L02DroptzvV6UZ"}}
{"type":"text","timestamp":1794046127204,"sessionID":"ses_e4a86c410ffehh4Wjsc5CjF45Q","part":{"id":"prt_1b57b4479001qTr74bFCVkEW6H","messageID":"msg_1b5795f6e001L02DroptzvV6UZ","sessionID":"ses_e4a86c410ffehh4Wjsc5CjF45Q","type":"text","text":"\n\nThe repo is a small `ledgerkit` package with a `money.py` and one test. I'll create `ledgerkit/cache.py`, add `tests/test_cache.py`, then run pytest.\n\n","time":{"start":1794046116986,"end":1794046127201}}}
