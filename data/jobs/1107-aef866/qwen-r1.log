{"type":"tool_use","timestamp":1794046157900,"sessionID":"ses_e4a86c410ffehh4Wjsc5CjF45Q","part":{"type":"tool","tool":"write","callID":"chatcmpl-tool-a63593ffaa6073fb","state":{"status":"completed","input":{"content":"import threading\nimport time\n\nimport pytest\n\nfrom ledgerkit.cache import TTLCache\n\n\nclass FakeClock:\n    def __init__(self, now=0.0):\n        self.now = now\n\n    def __call__(self):\n        return self.now\n\n    def advance(self, delta):\n        self.now += delta\n\n\ndef make_cache(maxsize=2, ttl=10.0):\n    clock = FakeClock()\n    return TTLCache(maxsize, ttl, clock=clock), clock\n\n\ndef test_put_and_get():\n    cache, _ = make_cache()\n    cache.put(\"a\", 1)\n    assert cache.get(\"a\") == 1\n\n\ndef test_get_missing_returns_default_and_counts_miss():\n    cache, _ = make_cache()\n    assert cache.get(\"nope\") is None\n    assert cache.get(\"nope\", \"d\") == \"d\"\n    assert cache.stats() == {\"hits\": 0, \"misses\": 2, \"evictions\": 0}\n\n\ndef test_get_hit_counts_hit():\n    cache, _ = make_cache()\n    cache.put(\"a\", 1)\n    assert cache.get(\"a\") == 1\n    assert cache.stats() == {\"hits\": 1, \"misses\": 0, \"evictions\": 0}\n\n\ndef test_get_expired_counts_miss_and_drops_entry():\n    cache, clock = make_cache()\n    cache.put(\"a\", 1)\n    clock.now = 10.0\n    assert cache.get(\"a\") is None\n    assert cache.stats() == {\"hits\": 0, \"misses\": 1, \"evictions\": 0}\n    assert len(cache) == 0\n\n\ndef test_entry_expires_at_exactly_ttl():\n    cache, clock = make_cache()\n    cache.put(\"a\", 1)\n    clock.now = 9.999\n    assert cache.get(\"a\") == 1\n    clock.now = 10.0\n    assert cache.get(\"a\") is None\n    assert \"a\" not in cache\n    assert len(cache) == 0\n\n\ndef test_expired_entries_not_counted_in_len():\n    cache, clock = make_cache(maxsize=3, ttl=5.0)\n    cache.put(\"a\", 1)\n    cache.put(\"b\", 2)\n    clock.advance(5.0)\n    assert len(cache) == 0\n\n\ndef test_get_refreshes_lru_order_but_not_expiry():\n    cache, clock = make_cache(maxsize=2, ttl=10.0)\n    cache.put(\"a\", 1)\n    clock.advance(4.0)\n    cache.put(\"b\", 2)\n    cache.get(\"a\")\n    clock.advance(6.5)\n    assert cache.get(\"a\") is None\n    assert cache.get(\"b\") == 2\n\n\ndef test_lru_eviction_counts_eviction():\n    cache, _ = make_cache(maxsize=2, ttl=100.0)\n    cache.put(\"a\", 1)\n    cache.put(\"b\", 2)\n    cache.put(\"c\", 3)\n    assert \"a\" not in cache\n    assert \"b\" in cache\n    assert \"c\" in cache\n    assert len(cache) == 2\n    assert cache.stats()[\"evictions\"] == 1\n\n\ndef test_get_refreshes_lru_order():\n    cache, _ = make_cache(maxsize=2, ttl=100.0)\n    cache.put(\"a\", 1)\n    cache.put(\"b\", 2)\n    cache.get(\"a\")\n    cache.put(\"c\", 3)\n    assert \"b\" not in cache\n    assert \"a\" in cache\n    assert \"c\" in cache\n\n\ndef test_put_existing_replaces_restarts_ttl_and_refreshes_order():\n    cache, clock = make_cache(maxsize=2, ttl=10.0)\n    cache.put(\"a\", 1)\n    cache.put(\"b\", 2)\n    clock.advance(6.0)\n    cache.put(\"a\", 10)\n    clock.advance(5.0)\n    assert cache.get(\"b\") is None\n    assert cache.get(\"a\") == 10\n    assert cache.stats()[\"evictions\"] == 0\n\n\ndef test_put_existing_never_evicts():\n    cache, _ = make_cache(maxsize=1, ttl=100.0)\n    cache.put(\"a\", 1)\n    cache.put(\"a\", 2)\n    assert cache.stats()[\"evictions\"] == 0\n    assert cache.get(\"a\") == 2\n\n\ndef test_expired_dropped_before_eviction():\n    cache, clock = make_cache(maxsize=2, ttl=10.0)\n    cache.put(\"a\", 1)\n    clock.advance(2.0)\n    cache.put(\"b\", 2)\n    clock.advance(8.0)\n    cache.put(\"c\", 3)\n    assert \"a\" not in cache\n    assert \"b\" in cache\n    assert \"c\" in cache\n    assert len(cache) == 2\n    assert cache.stats()[\"evictions\"] == 0\n    cache.put(\"d\", 4)\n    assert \"b\" not in cache\n    assert \"d\" in cache\n    assert cache.stats()[\"evictions\"] == 1\n\n\ndef test_all_expired_no_eviction():\n    cache, clock = make_cache(maxsize=2, ttl=5.0)\n    cache.put(\"a\", 1)\n    cache.put(\"b\", 2)\n    clock.advance(10.0)\n    cache.put(\"c\", 3)\n    cache.put(\"d\", 4)\n    assert cache.stats()[\"evictions\"] == 0\n    assert len(cache) == 2\n    assert cache.get(\"c\") == 3\n    assert cache.get(\"d\") == 4\n\n\ndef test_contains_does_not_change_order_or_stats():\n    cache, _ = make_cache(maxsize=2, ttl=100.0)\n    cache.put(\"a\", 1)\n    cache.put(\"b\", 2)\n    assert \"a\" in cache\n    assert \"x\" not in cache\n    cache.put(\"c\", 3)\n    assert \"a\" not in cache\n    assert \"b\" in cache\n    assert cache.stats() == {\"hits\": 0, \"misses\": 0, \"evictions\": 1}\n\n\ndef test_stats_keys_and_types():\n    cache, _ = make_cache()\n    stats = cache.stats()\n    assert set(stats) == {\"hits\", \"misses\", \"evictions\"}\n    assert all(isinstance(v, int) for v in stats.values())\n    assert cache.stats() is not stats\n\n\ndef test_invalid_params():\n    with pytest.raises(ValueError):\n        TTLCache(0, 10.0)\n    with pytest.raises(ValueError):\n        TTLCache(-1, 10.0)\n    with pytest.raises(ValueError):\n        TTLCache(1, 0)\n    with pytest.raises(ValueError):\n        TTLCache(1, -5.0)\n\n\ndef test_default_clock():\n    cache = TTLCache(2, 0.05)\n    cache.put(\"a\", 1)\n    assert cache.get(\"a\") == 1\n    time.sleep(0.06)\n    assert cache.get(\"a\") is None\n\n\ndef test_concurrent_access():\n    cache, _ = make_cache(maxsize=50, ttl=60.0)\n    errors = []\n\n    def writer(n):\n        try:\n            for i in range(500):\n                cache.put(\"k-{}-{}\".format(n, i), i)\n        except Exception as e:\n            errors.append(e)\n\n    def reader(n):\n        try:\n            for i in range(500):\n                key = \"k-{}-{}\".format(n, i)\n                cache.get(key)\n                assert len(cache) <= 50\n                assert key in cache or True\n                cache.stats()\n        except Exception as e:\n            errors.append(e)\n\n    threads = [threading.Thread(target=writer, args=(n,)) for n in range(4)]\n    threads += [threading.Thread(target=reader, args=(n,)) for n in range(4)]\n    for t in threads:\n        t.start()\n    for t in threads:\n        t.join()\n\n    assert not errors\n    assert len(cache) <= 50\n    assert cache.stats()[\"hits\"] + cache.stats()[\"misses\"] == 4 * 500\n","filePath":"/home/user/latte-crew/var/worktrees/1107-aef866/tests/test_cache.py"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/home/user/latte-crew/var/worktrees/1107-aef866/tests/test_cache.py","exists":false,"truncated":false},"title":"tests/test_cache.py","time":{"start":1794046157887,"end":1794046157899}},"id":"prt_1b57b7915001avrv9pIV4m1mAk","sessionID":"ses_e4a86c410ffehh4Wjsc5CjF45Q","messageID":"msg_1b57b6c9c001grk5vHA3uSpPyU"}}
