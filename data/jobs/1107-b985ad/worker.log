{"type":"assistant","message":{"model":"claude-sonnet-5-5","id":"msg_011CgoF8JL9CjhvpPQGRB43D","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_0157fBq7kXjb23SzUkNQgqbB","name":"Bash","input":{"command":"cat > ledgerkit/limiter.py <<'EOF'\n\"\"\"Thread-safe token bucket rate limiter.\"\"\"\nimport threading\nimport time\nfrom fractions import Fraction\n\n# Slack (in tokens) absorbing float representation error of clock readings,\n# so a request that is exactly affordable after wait_time() is never denied.\n_EPS = Fraction(1, 10**6)\n\n\nclass TokenBucket:\n    \"\"\"Token bucket: `rate` tokens/second, holding at most `capacity`. Starts full.\n\n    Token balances are kept as exact Fractions, so no floating point error\n    accumulates across refills.\n    \"\"\"\n\n    def __init__(self, rate, capacity, clock=time.monotonic):\n        if not rate > 0:\n            raise ValueError(\"rate must be > 0\")\n        if not capacity > 0:\n            raise ValueError(\"capacity must be > 0\")\n        self._rate = Fraction(rate)\n        self._capacity = Fraction(capacity)\n        self._clock = clock\n        self._lock = threading.Lock()\n        self._tokens = self._capacity\n        self._last = Fraction(clock())\n\n    def _check(self, n):\n        if not n > 0:\n            raise ValueError(\"n must be > 0\")\n        if Fraction(n) > self._capacity:\n            raise ValueError(\"n must be <= capacity\")\n        return Fraction(n)\n\n    def _refill(self):\n        now = Fraction(self._clock())\n        if now > self._last:\n            self._tokens = min(self._capacity,\n                               self._tokens + (now - self._last) * self._rate)\n        # Backwards clock: add/remove nothing, continue from the new time.\n        self._last = now\n\n    def try_acquire(self, n=1):\n        with self._lock:\n            need = self._check(n)\n            self._refill()\n            if self._tokens + _EPS >= need:\n                self._tokens = max(Fraction(0), self._tokens - need)\n                return True\n            return False\n\n    def wait_time(self, n=1):\n        with self._lock:\n            need = self._check(n)\n            self._refill()\n            if self._tokens + _EPS >= need:\n                return 0\n            return float((need - self._tokens) / self._rate)\nEOF\ncat > tests/test_limiter.py <<'EOF'\nimport threading\n\nimport pytest\n\nfrom ledgerkit.limiter import TokenBucket\n\n\nclass Clock:\n    def __init__(self, t=0.0):\n        self.t = t\n\n    def __call__(self):\n        return self.t\n\n\ndef test_starts_full_and_depletes():\n    c = Clock()\n    b = TokenBucket(1, 3, c)\n    assert b.try_acquire(3)\n    assert not b.try_acquire()\n    assert b.wait_time() == 1\n\n\ndef test_failed_acquire_takes_nothing_and_wait_time_pure():\n    c = Clock()\n    b = TokenBucket(2, 4, c)\n    assert b.try_acquire(3)\n    assert not b.try_acquire(2)\n    assert b.wait_time(2) == pytest.approx(0.5)\n    assert b.wait_time(2) == pytest.approx(0.5)\n    assert b.try_acquire(1)\n\n\ndef test_wait_zero_when_available():\n    assert TokenBucket(1, 5, Clock()).wait_time(5) == 0\n\n\ndef test_refill_capped():\n    c = Clock()\n    b = TokenBucket(10, 5, c)\n    b.try_acquire(5)\n    c.t += 1000\n    assert b.try_acquire(5)\n    assert not b.try_acquire()\n\n\n@pytest.mark.parametrize(\"args\", [(0, 1), (-1, 1), (1, 0), (1, -2)])\ndef test_bad_ctor(args):\n    with pytest.raises(ValueError):\n        TokenBucket(*args)\n\n\n@pytest.mark.parametrize(\"n\", [0, -1, 6])\ndef test_bad_n(n):\n    b = TokenBucket(1, 5, Clock())\n    with pytest.raises(ValueError):\n        b.try_acquire(n)\n    with pytest.raises(ValueError):\n        b.wait_time(n)\n\n\ndef test_clock_backwards():\n    c = Clock(100.0)\n    b = TokenBucket(1, 10, c)\n    b.try_acquire(10)\n    c.t = 50.0\n    assert not b.try_acquire()  # nothing added\n    assert b.wait_time() == pytest.approx(1)\n    c.t = 51.0  # refill continues from new time\n    assert b.try_acquire()\n    assert not b.try_acquire()\n\n\n@pytest.mark.parametrize(\"rate\", [0.1, 3, 7])\n@pytest.mark.parametrize(\"start\", [0.0, 12345.678])\ndef test_exact_wait_always_succeeds(rate, start):\n    c = Clock(start)\n    cap = 5\n    b = TokenBucket(rate, cap, c)\n    for i in range(5000):\n        n = 1 + i % cap\n        # drain to empty\n        while b.try_acquire(1):\n            pass\n        w = b.wait_time(n)\n        c.t += w\n        assert b.try_acquire(n), (i, n, w)\n        # leftover from rounding must not exceed tolerance; drain again\n        while b.try_acquire(1):\n            pass\n\n\ndef test_threads_never_overacquire():\n    c = Clock()\n    b = TokenBucket(1, 1000, c)\n    got = []\n\n    def worker():\n        k = 0\n        for _ in range(500):\n            if b.try_acquire():\n                k += 1\n        got.append(k)\n\n    ts = [threading.Thread(target=worker) for _ in range(16)]\n    [t.start() for t in ts]\n    [t.join() for t in ts]\n    assert sum(got) == 1000\nEOF\npython3 -m pytest -q 2>&1 | tail -15"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1723,"cache_read_input_tokens":30808,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1723},"output_tokens":5,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"d124c459-3848-45d6-b7a7-f66ed523152d","uuid":"807fa4ee-12a5-4248-8706-ad0ba7901717","timestamp":"2026-11-07T08:22:45.551Z","request_id":"req_011CgoF8JBDKG7aeRGKZCmv9","wire_tool_inputs":{"toolu_0157fBq7kXjb23SzUkNQgqbB":{"command":"cat > ledgerkit/limiter.py <<'EOF'\n\"\"\"Thread-safe token bucket rate limiter.\"\"\"\nimport threading\nimport time\nfrom fractions import Fraction\n\n# Slack (in tokens) absorbing float representation error of clock readings,\n# so a request that is exactly affordable after wait_time() is never denied.\n_EPS = Fraction(1, 10**6)\n\n\nclass TokenBucket:\n    \"\"\"Token bucket: `rate` tokens/second, holding at most `capacity`. Starts full.\n\n    Token balances are kept as exact Fractions, so no floating point error\n    accumulates across refills.\n    \"\"\"\n\n    def __init__(self, rate, capacity, clock=time.monotonic):\n        if not rate > 0:\n            raise ValueError(\"rate must be > 0\")\n        if not capacity > 0:\n            raise ValueError(\"capacity must be > 0\")\n        self._rate = Fraction(rate)\n        self._capacity = Fraction(capacity)\n        self._clock = clock\n        self._lock = threading.Lock()\n        self._tokens = self._capacity\n        self._last = Fraction(clock())\n\n    def _check(self, n):\n        if not n > 0:\n            raise ValueError(\"n must be > 0\")\n        if Fraction(n) > self._capacity:\n            raise ValueError(\"n must be <= capacity\")\n        return Fraction(n)\n\n    def _refill(self):\n        now = Fraction(self._clock())\n        if now > self._last:\n            self._tokens = min(self._capacity,\n                               self._tokens + (now - self._last) * self._rate)\n        # Backwards clock: add/remove nothing, continue from the new time.\n        self._last = now\n\n    def try_acquire(self, n=1):\n        with self._lock:\n            need = self._check(n)\n            self._refill()\n            if self._tokens + _EPS >= need:\n                self._tokens = max(Fraction(0), self._tokens - need)\n                return True\n            return False\n\n    def wait_time(self, n=1):\n        with self._lock:\n            need = self._check(n)\n            self._refill()\n            if self._tokens + _EPS >= need:\n                return 0\n            return float((need - self._tokens) / self._rate)\nEOF\ncat > tests/test_limiter.py <<'EOF'\nimport threading\n\nimport pytest\n\nfrom ledgerkit.limiter import TokenBucket\n\n\nclass Clock:\n    def __init__(self, t=0.0):\n        self.t = t\n\n    def __call__(self):\n        return self.t\n\n\ndef test_starts_full_and_depletes():\n    c = Clock()\n    b = TokenBucket(1, 3, c)\n    assert b.try_acquire(3)\n    assert not b.try_acquire()\n    assert b.wait_time() == 1\n\n\ndef test_failed_acquire_takes_nothing_and_wait_time_pure():\n    c = Clock()\n    b = TokenBucket(2, 4, c)\n    assert b.try_acquire(3)\n    assert not b.try_acquire(2)\n    assert b.wait_time(2) == pytest.approx(0.5)\n    assert b.wait_time(2) == pytest.approx(0.5)\n    assert b.try_acquire(1)\n\n\ndef test_wait_zero_when_available():\n    assert TokenBucket(1, 5, Clock()).wait_time(5) == 0\n\n\ndef test_refill_capped():\n    c = Clock()\n    b = TokenBucket(10, 5, c)\n    b.try_acquire(5)\n    c.t += 1000\n    assert b.try_acquire(5)\n    assert not b.try_acquire()\n\n\n@pytest.mark.parametrize(\"args\", [(0, 1), (-1, 1), (1, 0), (1, -2)])\ndef test_bad_ctor(args):\n    with pytest.raises(ValueError):\n        TokenBucket(*args)\n\n\n@pytest.mark.parametrize(\"n\", [0, -1, 6])\ndef test_bad_n(n):\n    b = TokenBucket(1, 5, Clock())\n    with pytest.raises(ValueError):\n        b.try_acquire(n)\n    with pytest.raises(ValueError):\n        b.wait_time(n)\n\n\ndef test_clock_backwards():\n    c = Clock(100.0)\n    b = TokenBucket(1, 10, c)\n    b.try_acquire(10)\n    c.t = 50.0\n    assert not b.try_acquire()  # nothing added\n    assert b.wait_time() == pytest.approx(1)\n    c.t = 51.0  # refill continues from new time\n    assert b.try_acquire()\n    assert not b.try_acquire()\n\n\n@pytest.mark.parametrize(\"rate\", [0.1, 3, 7])\n@pytest.mark.parametrize(\"start\", [0.0, 12345.678])\ndef test_exact_wait_always_succeeds(rate, start):\n    c = Clock(start)\n    cap = 5\n    b = TokenBucket(rate, cap, c)\n    for i in range(5000):\n        n = 1 + i % cap\n        # drain to empty\n        while b.try_acquire(1):\n            pass\n        w = b.wait_time(n)\n        c.t += w\n        assert b.try_acquire(n), (i, n, w)\n        # leftover from rounding must not exceed tolerance; drain again\n        while b.try_acquire(1):\n            pass\n\n\ndef test_threads_never_overacquire():\n    c = Clock()\n    b = TokenBucket(1, 1000, c)\n    got = []\n\n    def worker():\n        k = 0\n        for _ in range(500):\n            if b.try_acquire():\n                k += 1\n        got.append(k)\n\n    ts = [threading.Thread(target=worker) for _ in range(16)]\n    [t.start() for t in ts]\n    [t.join() for t in ts]\n    assert sum(got) == 1000\nEOF\npython3 -m pytest -q 2>&1 | tail -15"}}}
