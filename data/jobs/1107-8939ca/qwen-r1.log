{"type":"tool_use","timestamp":1794041834932,"sessionID":"ses_e4ac7a3b6ffeiOpN1PUFAshOXN","part":{"type":"tool","tool":"write","callID":"chatcmpl-tool-a5208979bbc2dcf5","state":{"status":"completed","input":{"filePath":"/home/user/latte-crew/var/worktrees/1107-8939ca/ledgerkit/durations.py","content":"\"\"\"Parse and format human-friendly durations such as '1h30m'.\"\"\"\n\nimport math\nfrom decimal import Decimal\n\n_UNITS = {\"d\": 86400, \"h\": 3600, \"m\": 60, \"s\": 1}\n_RANK = {unit: i for i, unit in enumerate(\"dhms\")}\n_DIGITS = \"0123456789\"\n_WHITESPACE = \" \\t\"\n\n\ndef parse(text):\n    \"\"\"Parse a duration like '1h30m', '2d 3h' or '-1.5h' into seconds.\n\n    Units must be d, h, m, s written from largest to smallest, each at\n    most once. Returns an int for whole values, a float otherwise.\n    Raises ValueError for anything malformed.\n    \"\"\"\n    if not isinstance(text, str):\n        raise ValueError(\"duration must be a string\")\n    text = text.strip()\n    if not text:\n        raise ValueError(\"empty duration\")\n    sign = 1\n    if text[0] == \"-\":\n        sign = -1\n        text = text[1:]\n        if not text or text[0] in _WHITESPACE:\n            raise ValueError(\"expected a number after '-'\")\n    if not text:\n        raise ValueError(\"empty duration\")\n    if \"-\" in text:\n        raise ValueError(\"unexpected '-' in duration\")\n    total = Decimal(0)\n    seen = set()\n    last_rank = None\n    i = 0\n    size = len(text)\n    while i < size:\n        if text[i] in _WHITESPACE:\n            i += 1\n            continue\n        start = i\n        while i < size and text[i] in _DIGITS:\n            i += 1\n        if i == start:\n            raise ValueError(\"expected a number\")\n        if i < size and text[i] == \".\":\n            i += 1\n            if i >= size or text[i] not in _DIGITS:\n                raise ValueError(\"malformed decimal number\")\n            while i < size and text[i] in _DIGITS:\n                i += 1\n        if i >= size or text[i] not in _UNITS:\n            raise ValueError(\"expected a unit\")\n        number = text[start:i]\n        unit = text[i]\n        i += 1\n        if unit in seen:\n            raise ValueError(\"repeated unit %r\" % unit)\n        rank = _RANK[unit]\n        if last_rank is not None and rank < last_rank:\n            raise ValueError(\"units out of order\")\n        seen.add(unit)\n        last_rank = rank\n        total += Decimal(number) * _UNITS[unit]\n    total *= sign\n    if total == total.to_integral_value():\n        return int(total)\n    return float(total)\n\n\ndef format(seconds):\n    \"\"\"Format a whole number of seconds in canonical form, e.g. '1h30m'.\n\n    Zero is '0s'; negative values get a leading '-'. Raises ValueError\n    for fractional, non-finite or non-numeric input.\n    \"\"\"\n    if isinstance(seconds, int):\n        value = seconds\n    elif isinstance(seconds, float):\n        if not math.isfinite(seconds) or not seconds.is_integer():\n            raise ValueError(\"seconds must be a whole number\")\n        value = int(seconds)\n    else:\n        raise ValueError(\"seconds must be a whole number of seconds\")\n    if value == 0:\n        return \"0s\"\n    prefix = \"\"\n    if value < 0:\n        prefix = \"-\"\n        value = -value\n    parts = []\n    days, rem = divmod(value, _UNITS[\"d\"])\n    hours, rem = divmod(rem, _UNITS[\"h\"])\n    minutes, seconds_part = divmod(rem, _UNITS[\"m\"])\n    if days:\n        parts.append(\"%dd\" % days)\n    if hours:\n        parts.append(\"%dh\" % hours)\n    if minutes:\n        parts.append(\"%dm\" % minutes)\n    if seconds_part:\n        parts.append(\"%ds\" % seconds_part)\n    return prefix + \"\".join(parts)\n"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/home/user/latte-crew/var/worktrees/1107-8939ca/ledgerkit/durations.py","exists":false,"truncated":false},"title":"ledgerkit/durations.py","time":{"start":1794041834920,"end":1794041834930}},"id":"prt_1b539b827001m9pBxXsoyG5ghA","sessionID":"ses_e4ac7a3b6ffeiOpN1PUFAshOXN","messageID":"msg_1b539ad5a001kdesS5mJZVpyBZ"}}
