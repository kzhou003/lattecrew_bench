{"type":"tool_use","timestamp":1794041857097,"sessionID":"ses_e4ac7a3b6ffeiOpN1PUFAshOXN","part":{"type":"tool","tool":"write","callID":"chatcmpl-tool-b0d61e496c67d99d","state":{"status":"completed","input":{"content":"import pytest\n\nfrom ledgerkit.durations import format, parse\n\n\n@pytest.mark.parametrize(\n    \"text, expected\",\n    [\n        (\"1h30m\", 5400),\n        (\"2d 3h\", 2 * 86400 + 3 * 3600),\n        (\"90s\", 90),\n        (\"1.5h\", 5400),\n        (\"1d2h3m4s\", 86400 + 2 * 3600 + 3 * 60 + 4),\n        (\"1h 30m 15s\", 5415),\n        (\"  2d  3h  \", 2 * 86400 + 3 * 3600),\n        (\"-1h30m\", -5400),\n        (\"-1.5h\", -5400),\n        (\"0s\", 0),\n        (\"0h\", 0),\n        (\"100d\", 100 * 86400),\n        (\"1.25h\", 4500),\n    ],\n)\ndef test_parse_valid(text, expected):\n    assert parse(text) == expected\n\n\ndef test_parse_whole_decimal_returns_int():\n    assert isinstance(parse(\"1.5h\"), int)\n    assert parse(\"1.5h\") == 5400\n\n\ndef test_parse_fractional_returns_float():\n    assert isinstance(parse(\"1.5s\"), float)\n    assert parse(\"1.5s\") == 1.5\n    assert isinstance(parse(\"-0.5s\"), float)\n    assert parse(\"-0.5s\") == -0.5\n\n\n@pytest.mark.parametrize(\n    \"text\",\n    [\n        \"\",\n        \"   \",\n        \"5\",\n        \"h\",\n        \"1h2h\",\n        \"1m1h\",\n        \"1s1m\",\n        \"0h1d\",\n        \"1.\",\n        \".5h\",\n        \"1.2.3h\",\n        \"1x\",\n        \"1 h\",\n        \"1h 30x\",\n        \"1h-30m\",\n        \"--1h\",\n        \"-\",\n        \"- 1h\",\n        \"1h 30m 2h\",\n        \"1h30m extra\",\n    ],\n)\ndef test_parse_invalid(text):\n    with pytest.raises(ValueError):\n        parse(text)\n\n\n@pytest.mark.parametrize(\n    \"value, expected\",\n    [\n        (0, \"0s\"),\n        (1, \"1s\"),\n        (60, \"1m\"),\n        (3600, \"1h\"),\n        (86400, \"1d\"),\n        (5400, \"1h30m\"),\n        (86401, \"1d1s\"),\n        (2 * 86400 + 3 * 3600, \"2d3h\"),\n        (-5400, \"-1h30m\"),\n        (-1, \"-1s\"),\n        (-86401, \"-1d1s\"),\n    ],\n)\ndef test_format(value, expected):\n    assert format(value) == expected\n\n\ndef test_format_accepts_integral_float():\n    assert format(5400.0) == \"1h30m\"\n\n\n@pytest.mark.parametrize(\n    \"value\",\n    [0.5, -2.5, float(\"inf\"), float(\"-inf\"), float(\"nan\")],\n)\ndef test_format_rejects_fractional_or_non_finite(value):\n    with pytest.raises(ValueError):\n        format(value)\n\n\n@pytest.mark.parametrize(\"value\", [\"5\", None, [5], (1, 2)])\ndef test_format_rejects_non_numeric(value):\n    with pytest.raises(ValueError):\n        format(value)\n\n\n@pytest.mark.parametrize(\n    \"value\",\n    [\n        0,\n        1,\n        59,\n        60,\n        61,\n        5400,\n        86399,\n        86400,\n        86401,\n        2 * 86400 + 3 * 3600,\n        100000,\n        -1,\n        -5400,\n        -86401,\n    ],\n)\ndef test_round_trip(value):\n    assert parse(format(value)) == value\n","filePath":"/home/user/latte-crew/var/worktrees/1107-8939ca/tests/test_durations.py"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/home/user/latte-crew/var/worktrees/1107-8939ca/tests/test_durations.py","exists":false,"truncated":false},"title":"tests/test_durations.py","time":{"start":1794041857089,"end":1794041857095}},"id":"prt_1b53a08b8001lXdzmS5VShlHIB","sessionID":"ses_e4ac7a3b6ffeiOpN1PUFAshOXN","messageID":"msg_1b539ee15001vYYW593lVWfwrk"}}
