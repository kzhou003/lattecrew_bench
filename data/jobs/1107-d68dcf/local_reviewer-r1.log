{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01RDoSyqMhp1kMB4C31x4CrL","type":"tool_result","content":" ledgerkit/cache.py  |  73 +++++++++++++++++++++++\n tests/test_cache.py | 163 ++++++++++++++++++++++++++++++++++++++++++++++++++++\n 2 files changed, 236 insertions(+)\n\"\"\"A small thread-safe LRU cache with per-entry TTL expiry.\"\"\"\n\nimport threading\nimport time\nfrom collections import OrderedDict\n\n\nclass TTLCache:\n    \"\"\"An LRU cache where entries expire `ttl` seconds after their last put.\"\"\"\n\n    def __init__(self, maxsize, ttl, clock=time.monotonic):\n        if maxsize < 1:\n            raise ValueError(\"maxsize must be >= 1\")\n        if ttl <= 0:\n            raise ValueError(\"ttl must be > 0\")\n        self._maxsize = maxsize\n        self._ttl = ttl\n        self._clock = clock\n        self._store = OrderedDict()\n        self._hits = 0\n        self._misses = 0\n        self._evictions = 0\n        self._lock = threading.RLock()\n\n    def _purge_expired(self, now):\n        for key in list(self._store):\n            _value, stored_time = self._store[key]\n            if now - stored_time >= self._ttl:\n                del self._store[key]\n\n    def put(self, key, value):\n        with self._lock:\n            now = self._clock()\n            self._purge_expired(now)\n            if key in self._store:\n                self._store[key] = (value, now)\n                self._store.move_to_end(key)\n            else:\n                if len(self._store) >= self._maxsize:\n                    self._store.popitem(last=False)\n                    self._evictions += 1\n                self._store[key] = (value, now)\n\n    def get(self, key, default=None):\n        with self._lock:\n            now = self._clock()\n            self._purge_expired(now)\n            if key not in self._store:\n                self._misses += 1\n                return default\n            value, _stored_time = self._store[key]\