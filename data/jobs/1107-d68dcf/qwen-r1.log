{"type":"tool_use","timestamp":1794050272062,"sessionID":"ses_e4a46c53cffe1kaT9Iu3sKjfH8","part":{"type":"tool","tool":"write","callID":"chatcmpl-tool-b5b090c4c93c76fc","state":{"status":"completed","input":{"content":"import threading\n\nimport pytest\n\nfrom ledgerkit.cache import TTLCache\n\n\nclass FakeClock:\n    def __init__(self, now=0.0):\n        self.now = now\n\n    def __call__(self):\n        return self.now\n\n    def advance(self, dt):\n        self.now += dt\n\n\ndef test_constructor_rejects_bad_maxsize():\n    with pytest.raises(ValueError):\n        TTLCache(0, 10.0)\n    with pytest.raises(ValueError):\n        TTLCache(-1, 10.0)\n\n\ndef test_constructor_rejects_bad_ttl():\n    with pytest.raises(ValueError):\n        TTLCache(1, 0)\n    with pytest.raises(ValueError):\n        TTLCache(1, -0.5)\n\n\ndef test_basic_put_get_and_stats():\n    cache = TTLCache(2, 10.0)\n    cache.put(\"a\", 1)\n    assert cache.get(\"a\") == 1\n    assert cache.get(\"missing\") is None\n    assert cache.get(\"missing\", \"d\") == \"d\"\n    assert cache.stats() == {\"hits\": 1, \"misses\": 2, \"evictions\": 0}\n\n\ndef test_expiry_boundary_inclusive():\n    clock = FakeClock(0.0)\n    cache = TTLCache(2, 10.0, clock=clock)\n    cache.put(\"a\", 1)\n    clock.advance(9.999)\n    assert cache.get(\"a\") == 1\n    clock.advance(0.001)\n    assert cache.get(\"a\") is None\n\n\ndef test_expired_entries():\n    clock = FakeClock(0.0)\n    cache = TTLCache(2, 10.0, clock=clock)\n    cache.put(\"a\", 1)\n    cache.put(\"b\", 2)\n    clock.advance(10.0)\n    assert cache.get(\"a\") is None\n    assert cache.get(\"b\") is None\n    assert len(cache) == 0\n    assert \"a\" not in cache\n    assert \"b\" not in cache\n    assert cache.stats()[\"evictions\"] == 0\n\n\ndef test_lru_eviction():\n    clock = FakeClock(0.0)\n    cache = TTLCache(2, 100.0, clock=clock)\n    cache.put(\"a\", 1)\n    cache.put(\"b\", 2)\n    cache.get(\"a\")\n    cache.put(\"c\", 3)\n    assert \"b\" not in cache\n    assert \"a\" in cache\n    assert \"c\" in cache\n    assert cache.stats()[\"evictions\"] == 1\n\n\ndef test_expired_dropped_before_eviction():\n    clock = FakeClock(0.0)\n    cache = TTLCache(2, 10.0, clock=clock)\n    cache.put(\"a\", 1)\n    clock.advance(5.0)\n    cache.put(\"b\", 2)\n    clock.advance(6.0)\n    cache.put(\"c\", 3)\n    assert \"a\" not in cache\n    assert \"b\" in cache\n    assert \"c\" in cache\n    assert len(cache) == 2\n    assert cache.stats()[\"evictions\"] == 0\n\n\ndef test_put_existing_key():\n    clock = FakeClock(0.0)\n    cache = TTLCache(2, 100.0, clock=clock)\n    cache.put(\"a\", 1)\n    cache.put(\"b\", 2)\n    cache.put(\"a\", 10)\n    assert cache.get(\"a\") == 10\n    assert len(cache) == 2\n    cache.put(\"c\", 3)\n    assert \"b\" not in cache\n    assert \"a\" in cache\n    assert \"c\" in cache\n    assert cache.stats()[\"evictions\"] == 1\n\n\ndef test_put_existing_key_restarts_ttl_and_no_eviction():\n    clock = FakeClock(0.0)\n    cache = TTLCache(1, 10.0, clock=clock)\n    cache.put(\"a\", 1)\n    clock.advance(9.0)\n    cache.put(\"a\", 2)\n    clock.advance(5.0)\n    assert cache.get(\"a\") == 2\n    assert cache.stats()[\"evictions\"] == 0\n    assert len(cache) == 1\n\n\ndef test_contains_does_not_refresh_order_or_stats():\n    clock = FakeClock(0.0)\n    cache = TTLCache(2, 100.0, clock=clock)\n    cache.put(\"a\", 1)\n    cache.put(\"b\", 2)\n    assert \"a\" in cache\n    assert \"z\" not in cache\n    cache.put(\"c\", 3)\n    assert \"a\" not in cache\n    assert cache.stats() == {\"hits\": 0, \"misses\": 0, \"evictions\": 1}\n\n\ndef test_stats_initial():\n    cache = TTLCache(2, 10.0)\n    stats = cache.stats()\n    assert stats == {\"hits\": 0, \"misses\": 0, \"evictions\": 0}\n    assert set(stats) == {\"hits\", \"misses\", \"evictions\"}\n\n\ndef test_concurrent_smoke():\n    clock = FakeClock(0.0)\n    cache = TTLCache(8, 1000.0, clock=clock)\n    errors = []\n\n    def worker(i):\n        try:\n            for j in range(200):\n                key = \"k%d\" % ((i * 7 + j) % 16)\n                cache.put(key, j)\n                cache.get(key, None)\n                len(cache)\n                key in cache\n                cache.stats()\n        except Exception as exc:\n            errors.append(exc)\n\n    threads = [threading.Thread(target=worker, args=(i,)) for i in range(8)]\n    for t in threads:\n        t.start()\n    for t in threads:\n        t.join()\n    assert not errors\n    assert len(cache) <= 8\n","filePath":"/home/user/latte-crew/var/worktrees/1107-d68dcf/tests/test_cache.py"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/home/user/latte-crew/var/worktrees/1107-d68dcf/tests/test_cache.py","exists":false,"truncated":false},"title":"tests/test_cache.py","time":{"start":1794050272057,"end":1794050272061}},"id":"prt_1b5ba5f06001xYjenagSuoZq2N","sessionID":"ses_e4a46c53cffe1kaT9Iu3sKjfH8","messageID":"msg_1b5ba5842001XWqrzexOXlWBqT"}}
