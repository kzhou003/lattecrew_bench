{"type":"tool_use","timestamp":1794050250725,"sessionID":"ses_e4a46c53cffe1kaT9Iu3sKjfH8","part":{"type":"tool","tool":"write","callID":"chatcmpl-tool-beaa4ab915c70307","state":{"status":"completed","input":{"filePath":"/home/user/latte-crew/var/worktrees/1107-d68dcf/ledgerkit/cache.py","content":"\"\"\"A small thread-safe LRU cache with per-entry TTL expiry.\"\"\"\n\nimport threading\nimport time\nfrom collections import OrderedDict\n\n\nclass TTLCache:\n    \"\"\"An LRU cache where entries expire `ttl` seconds after their last put.\"\"\"\n\n    def __init__(self, maxsize, ttl, clock=time.monotonic):\n        if maxsize < 1:\n            raise ValueError(\"maxsize must be >= 1\")\n        if ttl <= 0:\n            raise ValueError(\"ttl must be > 0\")\n        self._maxsize = maxsize\n        self._ttl = ttl\n        self._clock = clock\n        self._store = OrderedDict()\n        self._hits = 0\n        self._misses = 0\n        self._evictions = 0\n        self._lock = threading.RLock()\n\n    def _purge_expired(self, now):\n        for key in list(self._store):\n            _value, stored_time = self._store[key]\n            if now - stored_time >= self._ttl:\n                del self._store[key]\n\n    def put(self, key, value):\n        with self._lock:\n            now = self._clock()\n            self._purge_expired(now)\n            if key in self._store:\n                self._store[key] = (value, now)\n                self._store.move_to_end(key)\n            else:\n                if len(self._store) >= self._maxsize:\n                    self._store.popitem(last=False)\n                    self._evictions += 1\n                self._store[key] = (value, now)\n\n    def get(self, key, default=None):\n        with self._lock:\n            now = self._clock()\n            self._purge_expired(now)\n            if key not in self._store:\n                self._misses += 1\n                return default\n            value, _stored_time = self._store[key]\n            self._hits += 1\n            self._store.move_to_end(key)\n            return value\n\n    def __len__(self):\n        with self._lock:\n            self._purge_expired(self._clock())\n            return len(self._store)\n\n    def __contains__(self, key):\n        with self._lock:\n            self._purge_expired(self._clock())\n            return key in self._store\n\n    def stats(self):\n        with self._lock:\n            self._purge_expired(self._clock())\n            return {\n                \"hits\": self._hits,\n                \"misses\": self._misses,\n                \"evictions\": self._evictions,\n            }\n"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/home/user/latte-crew/var/worktrees/1107-d68dcf/ledgerkit/cache.py","exists":false,"truncated":false},"title":"ledgerkit/cache.py","time":{"start":1794050250717,"end":1794050250724}},"id":"prt_1b5ba3625001QLRtgqbr6MuB3M","sessionID":"ses_e4a46c53cffe1kaT9Iu3sKjfH8","messageID":"msg_1b5b9608a001BgZYp5Q966M20O"}}
