    if rank <= last_rank:\n            raise ValueError(\"units out of order in %r\" % text)\n        seen.add(unit)\n        last_rank = rank\n        total += Decimal(text[i:j]) * _UNITS[unit]\n        i = j + 1\n\n    value = sign * total\n    if value == value.to_integral_value():\n        return int(value)\n    return float(value)\n\n\ndef format(seconds):\n    \"\"\"Format whole seconds as the canonical '1h30m' style string.\"\"\"\n    if isinstance(seconds, bool) or not isinstance(seconds, (int, float)):\n        raise ValueError(\"seconds must be a whole number, got %s\" % type(seconds).__name__)\n    if isinstance(seconds, float):\n        if not math.isfinite(seconds):\n            raise ValueError(\"seconds must be finite\")\n        if not seconds.is_integer():\n            raise ValueError(\"seconds must be whole, got %r\" % seconds)\n        seconds = int(seconds)\n\n    sign = \"-\" if seconds < 0 else \"\"\n    days, rem = divmod(abs(seconds), 86400)\n    hours, rem = divmod(rem, 3600)\n    minutes, secs = divmod(rem, 60)\n    parts = [\n        \"%d%s\" % (value, unit)\n        for value, unit in ((days, \"d\"), (hours, \"h\"), (minutes, \"m\"), (secs, \"s\"))\n        if value\n    ]\n    return sign + (\"\".join(parts) if parts else \"0s\")\n........................................................................ [ 82%]\n...............                                                          [100%]\n87 passed in 0.05s","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_011HgUfK49QFhfwWAHEdK6po","permission_decision":{"decision":"accept","source":"config","reason_type":"classifier"}}]}
