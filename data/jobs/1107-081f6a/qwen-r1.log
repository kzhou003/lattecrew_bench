{"type":"tool_use","timestamp":1794050141628,"sessionID":"ses_e4a49ad09ffe7WgyOxVNd9B2wY","part":{"type":"tool","tool":"write","callID":"chatcmpl-tool-8f365c89ec9094ab","state":{"status":"completed","input":{"content":"import pytest\n\nfrom ledgerkit.durations import format, parse\n\n\n@pytest.mark.parametrize(\n    (\"text\", \"expected\"),\n    [\n        (\"1h30m\", 5400),\n        (\"2d 3h\", 183600),\n        (\"90s\", 90),\n        (\"1.5h\", 5400),\n        (\"1d2h3m4s\", 93784),\n        (\"1d 2h 3m 4s\", 93784),\n        (\"1h 30m 45s\", 5445),\n        (\"0s\", 0),\n        (\"0h0m1s\", 1),\n        (\"-1h30m\", -5400),\n        (\"-90s\", -90),\n        (\"-1.5h\", -5400),\n        (\" 1h30m \", 5400),\n        (\"1.25m\", 75),\n        (\"0.5s\", 0.5),\n        (\"0.001s\", 0.001),\n    ],\n)\ndef test_parse_valid(text, expected):\n    assert parse(text) == expected\n\n\ndef test_parse_whole_values_are_int():\n    assert parse(\"1.5h\") == 5400\n    assert isinstance(parse(\"1.5h\"), int)\n    assert not isinstance(parse(\"1.5h\"), float)\n    assert isinstance(parse(\"90s\"), int)\n    assert isinstance(parse(\"-1h30m\"), int)\n\n\ndef test_parse_fractional_values_are_float():\n    assert parse(\"0.5s\") == 0.5\n    assert isinstance(parse(\"0.5s\"), float)\n    assert isinstance(parse(\"0.001s\"), float)\n    assert isinstance(parse(\"-0.5s\"), float)\n\n\n@pytest.mark.parametrize(\n    \"text\",\n    [\n        \"\",\n        \"   \",\n        \"5\",\n        \"1.5\",\n        \"h\",\n        \"1h2h\",\n        \"1d2d\",\n        \"1m1h\",\n        \"1s1m\",\n        \"0h1d\",\n        \"1.h\",\n        \".5h\",\n        \"1.5.2h\",\n        \"1x\",\n        \"1h5x\",\n        \"1h 5\",\n        \"1h 5s6\",\n        \"-\",\n        \"--1h\",\n        \"- 1h\",\n        \"1h-2m\",\n        \"+1h\",\n        \"1 h\",\n    ],\n)\ndef test_parse_invalid(text):\n    with pytest.raises(ValueError):\n        parse(text)\n\n\n@pytest.mark.parametrize(\"text\", [5, None, 1.5, [\"1h\"]])\ndef test_parse_requires_string(text):\n    with pytest.raises(ValueError):\n        parse(text)\n\n\n@pytest.mark.parametrize(\n    (\"seconds\", \"expected\"),\n    [\n        (0, \"0s\"),\n        (1, \"1s\"),\n        (60, \"1m\"),\n        (3600, \"1h\"),\n        (86400, \"1d\"),\n        (5400, \"1h30m\"),\n        (86401, \"1d1s\"),\n        (183600, \"2d3h\"),\n        (3661, \"1h1m1s\"),\n        (90061, \"1d1h1m1s\"),\n        (-1, \"-1s\"),\n        (-5400, \"-1h30m\"),\n        (-86401, \"-1d1s\"),\n        (5400.0, \"1h30m\"),\n    ],\n)\ndef test_format(seconds, expected):\n    assert format(seconds) == expected\n\n\n@pytest.mark.parametrize(\n    \"seconds\",\n    [0.5, 5.5, \"5\", None, float(\"inf\"), float(\"nan\"), True],\n)\ndef test_format_rejects_bad_input(seconds):\n    with pytest.raises(ValueError):\n        format(seconds)\n\n\n@pytest.mark.parametrize(\n    \"value\",\n    [\n        0,\n        1,\n        59,\n        60,\n        61,\n        3599,\n        3600,\n        5400,\n        86399,\n        86400,\n        86401,\n        172800,\n        183600,\n        90061,\n        93784,\n        1000000,\n        -1,\n        -5400,\n        -86401,\n        -172800,\n    ],\n)\ndef test_round_trip(value):\n    assert parse(format(value)) == value\n","filePath":"/home/user/latte-crew/var/worktrees/1107-081f6a/tests/test_durations.py"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/home/user/latte-crew/var/worktrees/1107-081f6a/tests/test_durations.py","exists":false,"truncated":false},"title":"tests/test_durations.py","time":{"start":1794050141622,"end":1794050141627}},"id":"prt_1b5b86bc80016GuVE3HFUqo2Fy","sessionID":"ses_e4a49ad09ffe7WgyOxVNd9B2wY","messageID":"msg_1b5b85f95001FJ7HX3kUNYgv9c"}}
