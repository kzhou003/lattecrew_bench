{"type":"tool_use","timestamp":1794050121498,"sessionID":"ses_e4a49ad09ffe7WgyOxVNd9B2wY","part":{"type":"tool","tool":"write","callID":"chatcmpl-tool-8444a6a6c82923eb","state":{"status":"completed","input":{"filePath":"/home/user/latte-crew/var/worktrees/1107-081f6a/ledgerkit/durations.py","content":"\"\"\"Parse and format durations made of d, h, m, and s parts.\"\"\"\n\nimport math\nfrom decimal import Decimal\n\n_UNITS = {\n    \"d\": 86400,\n    \"h\": 3600,\n    \"m\": 60,\n    \"s\": 1,\n}\n_RANK = {\"d\": 0, \"h\": 1, \"m\": 2, \"s\": 3}\n_DIGITS = \"0123456789\"\n_SPACE = \" \\t\"\n\n\ndef parse(text):\n    \"\"\"Parse a duration like '1h30m', '2d 3h', or '-1.5h' into seconds.\"\"\"\n    if not isinstance(text, str):\n        raise ValueError(\"duration must be a string, got %s\" % type(text).__name__)\n    text = text.strip()\n    if not text:\n        raise ValueError(\"duration must not be empty\")\n\n    sign = 1\n    if text[0] == \"-\":\n        sign = -1\n        text = text[1:]\n        if not text:\n            raise ValueError(\"duration must not be empty\")\n\n    total = Decimal(0)\n    seen = set()\n    last_rank = -1\n    i = 0\n    n = len(text)\n    while i < n:\n        if text[i] in _SPACE:\n            if last_rank == -1:\n                raise ValueError(\"unexpected whitespace in %r\" % text)\n            i += 1\n            continue\n        j = i\n        while j < n and text[j] in _DIGITS:\n            j += 1\n        if j == i:\n            raise ValueError(\"expected a number at %r\" % text[i])\n        if j < n and text[j] == \".\":\n            k = j + 1\n            while k < n and text[k] in _DIGITS:\n                k += 1\n            if k == j + 1:\n                raise ValueError(\"malformed number %r\" % text[i:k])\n            j = k\n        if j >= n:\n            raise ValueError(\"number %r has no unit\" % text[i:j])\n        unit = text[j]\n        if unit not in _UNITS:\n            raise ValueError(\"unknown unit %r\" % unit)\n        if unit in seen:\n            raise ValueError(\"repeated unit %r\" % unit)\n        rank = _RANK[unit]\n        if rank <= last_rank:\n            raise ValueError(\"units out of order in %r\" % text)\n        seen.add(unit)\n        last_rank = rank\n        total += Decimal(text[i:j]) * _UNITS[unit]\n        i = j + 1\n\n    value = sign * total\n    if value == value.to_integral_value():\n        return int(value)\n    return float(value)\n\n\ndef format(seconds):\n    \"\"\"Format whole seconds as the canonical '1h30m' style string.\"\"\"\n    if isinstance(seconds, bool) or not isinstance(seconds, (int, float)):\n        raise ValueError(\"seconds must be a whole number, got %s\" % type(seconds).__name__)\n    if isinstance(seconds, float):\n        if not math.isfinite(seconds):\n            raise ValueError(\"seconds must be finite\")\n        if not seconds.is_integer():\n            raise ValueError(\"seconds must be whole, got %r\" % seconds)\n        seconds = int(seconds)\n\n    sign = \"-\" if seconds < 0 else \"\"\n    days, rem = divmod(abs(seconds), 86400)\n    hours, rem = divmod(rem, 3600)\n    minutes, secs = divmod(rem, 60)\n    parts = [\n        \"%d%s\" % (value, unit)\n        for value, unit in ((days, \"d\"), (hours, \"h\"), (minutes, \"m\"), (secs, \"s\"))\n        if value\n    ]\n    return sign + (\"\".join(parts) if parts else \"0s\")\n"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/home/user/latte-crew/var/worktrees/1107-081f6a/ledgerkit/durations.py","exists":false,"truncated":false},"title":"ledgerkit/durations.py","time":{"start":1794050121485,"end":1794050121496}},"id":"prt_1b5b82b41001dI551DMqyzUYXL","sessionID":"ses_e4a49ad09ffe7WgyOxVNd9B2wY","messageID":"msg_1b5b66f960011rOsKjkRwDeOTg"}}
