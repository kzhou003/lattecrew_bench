{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Jpb55GS9NfPBqrgqovma93","type":"tool_result","content":"diff --git a/ledgerkit/money.py b/ledgerkit/money.py\nindex 583519c..4bf7dc4 100644\n--- a/ledgerkit/money.py\n+++ b/ledgerkit/money.py\n@@ -1,4 +1,32 @@\n def split(total_cents, weights):\n-    \"\"\"Split an amount between parties in proportion to their weights.\"\"\"\n-    s = sum(weights)\n-    return [round(total_cents * w / s) for w in weights]\n+    \"\"\"Split an amount between parties in proportion to their weights.\n+\n+    Uses the largest remainder method with exact integer arithmetic: each\n+    party receives the floor of its exact share, and the leftover cents are\n+    handed out one at a time to the parties with the largest fractional\n+    remainder, breaking ties by the lower index. The results always sum\n+    exactly to total_cents.\n+    \"\"\"\n+    weights = list(weights)\n+    if not weights:\n+        raise ValueError(\"weights must not be empty\")\n+    if any(w < 0 for w in weights):\n+        raise ValueError(\"weights must be non-negative\")\n+    total_weight = sum(weights)\n+    if total_weight == 0:\n+        raise ValueError(\"at least one weight must be positive\")\n+\n+    negative = total_cents < 0\n+    amount = abs(total_cents)\n+\n+    shares = [amount * w // total_weight for w in weights]\n+    remainders = [amount * w % total_weight for w in weights]\n+    leftover = amount - sum(shares)\n+\n+    order = sorted(range(len(weights)), key=lambda i: (-remainders[i], i))\n+    for i in order[:leftover]:\n+        shares[i] += 1\n+\n+    if negative:\n+        shares = [-x for x in shares]\n+    return shares\ndiff --git a/tests/test_money.py b/tests/test_money.py\nindex a14c927..e052d6c 100644\n--- a/tests/test_money.py\n+++ b/tests/test_money.py\n@@ -1,5 +1,112 @@\n+import random\n+\n+import pytest\n+\n from ledgerkit.money import split\n \n \n def test_even_split():\n     assert split(100, [1, 1]) == [50, 50]\n+\n+\n+def test_uneven_split():\n+    assert split(100, [1, 1, 1]) == [34, 33, 33]\n+\n+\n+def test_largest_remainder_method():\n+    # Exact shares: 10/6, 20/6, 30/6 -> floors 1, 3, 5, leftover 1 goes to\n+    # the largest fractional remainder (party 0: 4/6).\n+    assert split(10, [1, 2, 3]) == [2, 3, 5]\n+\n+\n+def test_tie_broken_by_lower_index():\n+    assert split(5, [1, 1]) == [3, 2]\n+    assert split(3, [1, 1, 1]) == [1, 1, 1]\n+    assert split(1, [2, 2, 2]) == [1, 0, 0]\n+\n+\n+def test_sum_equals_total():\n+    for total, weights in [\n+        (100, [1, 1]),\n+        (101, [1, 2, 3]),\n+        (10, [1, 2, 3]),\n+        (3, [1000000, 1]),\n+        (0, [1, 2, 3]),\n+        (-100, [1, 1, 1]),\n+        (-10, [1, 2, 3]),\n+    ]:\n+        assert sum(split(total, weights)) == total\n+\n+\n+def test_all_results_are_ints():\n+    result = split(1000003, [7, 13, 29, 41])\n+    assert all(type(x) is int for x in result)\n+    assert sum(result) == 1000003\n+\n+\n+def test_negative_total_splits_like_absolute():\n+    assert split(-100, [1, 1, 1]) == [-34, -33, -33]\n+    assert split(-10, [1, 2, 3]) == [-2, -3, -5]\n+    assert sum(split(-100, [1, 1, 1])) == -100\n+\n+\n+def test_zero_total():\n+    assert split(0, [1, 2, 3]) == [0, 0, 0]\n+\n+\n+def test_zero_weight_inside_list():\n+    assert split(10, [0, 5]) == [0, 10]\n+    assert split(10, [0, 0, 1]) == [0, 0, 10]\n+\n+\n+def test_float_precision_case():\n+    # Exact integer arithmetic: 3*1000000/1000001 floors to 2 with a huge\n+    # remainder, so party 0 gets the last cent: [3, 0], not [2, 1].\n+    result = split(3, [1000000, 1])\n+    assert result == [3, 0]\n+    assert sum(result) == 3\n+\n+\n+def test_averaging_down():\n+    # 1 cent across two parties: floor 0,0, leftover 1, tie -> lower index.\n+    assert split(1, [1, 1]) == [1, 0]\n+\n+\n+def test_weights_as_tuple():\n+    assert split(10, (1, 2, 3)) == [2, 3, 5]\n+\n+\n+def test_empty_weights_raises():\n+    with pytest.raises(ValueError):\n+        split(100, [])\n+\n+\n+def test_negative_weight_raises():\n+    with pytest.raises(ValueError):\n+        split(100, [1, -1])\n+    with pytest.raises(ValueError):\n+        split(100, [-5, 5, 5])\n+\n+\n+def test_all_zero_weights_raises():\n+    with pytest.raises(ValueError):\n+        split(100, [0, 0, 0])\n+\n+\n+def test_property_sum_and_proportionality():\n+    rng = random.Random(12345)\n+    for _ in range(200):\n+        total = rng.randint(-10**6, 10**6)\n+        weights = [rng.randint(0, 100) for _ in range(rng.randint(1, 8))]\n+        if all(w == 0 for w in weights):\n+            continue\n+        result = split(total, weights)\n+        assert len(result) == len(weights)\n+        assert sum(result) == total\n+        for x in result:\n+            assert type(x) is int\n+        # Each share is within 1 of its exact proportional share.\n+        s = sum(weights)\n+        for w, x in zip(weights, result):\n+            lo = abs(total) * w // s\n+            assert x in (lo, lo + 1) or x in (-lo, -(lo + 1))\n................                                                         [100%]\n16 passed in 0.01s","is_error":false}]},"parent_tool_use_id":null,"session_id":"4fcf4b14-c316-4561-b286-8453347f4d13","uuid":"33cff6a0-e6b5-4fd4-8cf8-78d572c1e06f","timestamp":"2026-11-07T10:03:20.898Z","tool_use_result":{"stdout":"diff --git a/ledgerkit/money.py b/ledgerkit/money.py\nindex 583519c..4bf7dc4 100644\n--- a/ledgerkit/money.py\n+++ b/ledgerkit/money.py\n@@ -1,4 +1,32 @@\n def split(total_cents, weights):\n-    \"\"\"Split an amount between parties in proportion to their weights.\"\"\"\n-    s = sum(weights)\n-    return [round(total_cents * w / s) for w in weights]\n+    \"\"\"Split an amount between parties in proportion to their weights.\n+\n+    Uses the largest remainder method with exact integer arithmetic: each\n+    party receives the floor of its exact share, and the leftover cents are\n+    handed out one at a time to 