{"type":"tool_use","timestamp":1794045775731,"sessionID":"ses_e4a8ace5affeUo6D0QO0R2S7Z2","part":{"type":"tool","tool":"write","callID":"chatcmpl-tool-9dabbb2141541bad","state":{"status":"completed","input":{"content":"import random\n\nimport pytest\n\nfrom ledgerkit.money import split\n\n\ndef test_even_split():\n    assert split(100, [1, 1]) == [50, 50]\n\n\ndef test_uneven_split():\n    assert split(100, [1, 1, 1]) == [34, 33, 33]\n\n\ndef test_largest_remainder_method():\n    # Exact shares: 10/6, 20/6, 30/6 -> floors 1, 3, 5, leftover 1 goes to\n    # the largest fractional remainder (party 0: 4/6).\n    assert split(10, [1, 2, 3]) == [2, 3, 5]\n\n\ndef test_tie_broken_by_lower_index():\n    assert split(5, [1, 1]) == [3, 2]\n    assert split(3, [1, 1, 1]) == [1, 1, 1]\n    assert split(1, [2, 2, 2]) == [1, 0, 0]\n\n\ndef test_sum_equals_total():\n    for total, weights in [\n        (100, [1, 1]),\n        (101, [1, 2, 3]),\n        (10, [1, 2, 3]),\n        (3, [1000000, 1]),\n        (0, [1, 2, 3]),\n        (-100, [1, 1, 1]),\n        (-10, [1, 2, 3]),\n    ]:\n        assert sum(split(total, weights)) == total\n\n\ndef test_all_results_are_ints():\n    result = split(1000003, [7, 13, 29, 41])\n    assert all(type(x) is int for x in result)\n    assert sum(result) == 1000003\n\n\ndef test_negative_total_splits_like_absolute():\n    assert split(-100, [1, 1, 1]) == [-34, -33, -33]\n    assert split(-10, [1, 2, 3]) == [-2, -3, -5]\n    assert sum(split(-100, [1, 1, 1])) == -100\n\n\ndef test_zero_total():\n    assert split(0, [1, 2, 3]) == [0, 0, 0]\n\n\ndef test_zero_weight_inside_list():\n    assert split(10, [0, 5]) == [0, 10]\n    assert split(10, [0, 0, 1]) == [0, 0, 10]\n\n\ndef test_float_precision_case():\n    # Exact integer arithmetic: 3*1000000/1000001 floors to 2 with a huge\n    # remainder, so party 0 gets the last cent: [3, 0], not [2, 1].\n    result = split(3, [1000000, 1])\n    assert result == [3, 0]\n    assert sum(result) == 3\n\n\ndef test_averaging_down():\n    # 1 cent across two parties: floor 0,0, leftover 1, tie -> lower index.\n    assert split(1, [1, 1]) == [1, 0]\n\n\ndef test_weights_as_tuple():\n    assert split(10, (1, 2, 3)) == [2, 3, 5]\n\n\ndef test_empty_weights_raises():\n    with pytest.raises(ValueError):\n        split(100, [])\n\n\ndef test_negative_weight_raises():\n    with pytest.raises(ValueError):\n        split(100, [1, -1])\n    with pytest.raises(ValueError):\n        split(100, [-5, 5, 5])\n\n\ndef test_all_zero_weights_raises():\n    with pytest.raises(ValueError):\n        split(100, [0, 0, 0])\n\n\ndef test_property_sum_and_proportionality():\n    rng = random.Random(12345)\n    for _ in range(200):\n        total = rng.randint(-10**6, 10**6)\n        weights = [rng.randint(0, 100) for _ in range(rng.randint(1, 8))]\n        if all(w == 0 for w in weights):\n            continue\n        result = split(total, weights)\n        assert len(result) == len(weights)\n        assert sum(result) == total\n        for x in result:\n            assert type(x) is int\n        # Each share is within 1 of its exact proportional share.\n        s = sum(weights)\n        for w, x in zip(weights, result):\n            lo = abs(total) * w // s\n            assert x in (-lo, -lo - 1, lo, lo + 1) if total < 0 else x in (lo, lo + 1)\n","filePath":"/home/user/latte-crew/var/worktrees/1107-77fdd1/tests/test_money.py"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/home/user/latte-crew/var/worktrees/1107-77fdd1/tests/test_money.py","exists":true,"truncated":false},"title":"tests/test_money.py","time":{"start":1794045775710,"end":1794045775729}},"id":"prt_1b575cec7001tfYUOiwj4p2s9c","sessionID":"ses_e4a8ace5affeUo6D0QO0R2S7Z2","messageID":"msg_1b575c7c400149cyOcABZkQWE1"}}
